---
/**
 * BaseLayout.astro
 * ─────────────────────────────────────────────────────────────
 * The HTML shell for every page on the site.
 * Handles:
 *   - <head> meta, Open Graph, canonical URL
 *   - Google Fonts preconnect (no FOUC)
 *   - Global CSS import
 *   - Favicon
 *   - Slot for page content (nav and footer go here later)
 * ─────────────────────────────────────────────────────────────
 */
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  /** Page <title> — should be unique per page, 50–60 chars */
  title: string;
  /** Meta description — 140–160 chars, used for SEO + OG */
  description?: string;
  /** Canonical URL — defaults to current page URL */
  canonicalURL?: string;
  /** Open Graph image — defaults to site-wide OG image */
  ogImage?: string;
  /** Open Graph type — defaults to "website" */
  ogType?: 'website' | 'article';
  /** Structured data JSON-LD string — injected into <script type="application/ld+json"> */
  schema?: string;
}

const {
  title,
  description = "L'okawa Tours & Travel offers affordable gorilla trekking, wildlife safaris and multi-country tour packages across Uganda, Kenya, Tanzania and Rwanda.",
  canonicalURL = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href,
  ogImage = '/images/og-default.jpg',
  ogType = 'website',
  schema,
} = Astro.props;

const siteName = "L'okawa Tours & Travel";
const fullTitle = title.includes(siteName) ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- ── Primary SEO ──────────────────────────────────────── -->
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- ── Open Graph ───────────────────────────────────────── -->
    <meta property="og:type"        content={ogType} />
    <meta property="og:site_name"   content={siteName} />
    <meta property="og:title"       content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url"         content={canonicalURL} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:image:width"  content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale"      content="en_US" />

    <!-- ── Twitter / X Card ─────────────────────────────────── -->
    <meta name="twitter:card"        content="summary_large_image" />
    <meta name="twitter:title"       content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image"       content={ogImage} />

    <!-- ── Favicon ──────────────────────────────────────────── -->
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <!-- ── Google Fonts — preconnect first, then stylesheet ─── -->
    <!--
      Preconnect eliminates the round-trip delay before the font
      request. rel="preconnect" + crossorigin is the correct pair
      for fonts.googleapis.com / fonts.gstatic.com.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=Source+Sans+3:wght@400;600;700;800&display=swap"
    />

    <!-- ── Structured Data (JSON-LD) ────────────────────────── -->
    {schema && (
      <script type="application/ld+json" set:html={schema} />
    )}

    <!-- ── Organisation schema — included on every page ──────── -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "TravelAgency",
        "name": "L'okawa Tours & Travel (U) Ltd",
        "url": "https://lokawatours.com",
        "logo": "https://lokawatours.com/images/logo.png",
        "description": "Uganda-based tour operator offering gorilla trekking, wildlife safaris, hotel bookings and airport transfers across East Africa. Est. 2021.",
        "foundingDate": "2021",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Kiwatule",
          "addressLocality": "Kampala",
          "addressCountry": "UG"
        },
        "contactPoint": [
          {
            "@type": "ContactPoint",
            "telephone": "+256761512966",
            "contactType": "customer service",
            "availableLanguage": "English",
            "hoursAvailable": "Mo-Sa 08:00-18:00"
          }
        ],
        "email": "lokawatoursandtravelultd@gmail.com",
        "telephone": "+256761512966",
        "sameAs": [
          "https://wa.me/256761512966",
          "https://www.facebook.com/profile.php?id=100092965934215",
          "https://www.instagram.com/lokawa_tours_and_travel_u_ltd"
        ],
        "areaServed": ["Uganda", "Kenya", "Tanzania", "Rwanda"],
        "slogan": "Where Nature Meets Attraction"
      }
    </script>
  </head>

  <body>

    <Header />

    <!-- ── Page content ──────────────────────────────────────── -->
    <main>
      <slot />
    </main>

    <Footer />

  </body>
</html>

<!-- ── Global styles ─────────────────────────────────────────── -->
<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,700;1,500&family=Source+Sans+3:wght@400;600;700;800&display=swap');
</style>
