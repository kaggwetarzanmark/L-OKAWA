---
/**
 * GuidePage.astro
 * ─────────────────────────────────────────────────────────────
 * Reusable template for every plan / travel-guide page.
 * Pass all content as props — zero repeated markup or CSS.
 *
 * USAGE:
 *   import GuidePage from '../../../components/GuidePage.astro';
 *   <GuidePage {guide} {sections} {faqs} {relatedGuides} />
 * ─────────────────────────────────────────────────────────────
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand    from '../components/CtaBand.astro';

// ── Type definitions ──────────────────────────────────────────
interface GuideSection {
  heading:  string;
  body:     string[];        // array of paragraphs
  bullets?: string[];        // optional bullet list after paragraphs
  table?:   { col1: string; col2: string; col3?: string }[];  // optional table rows
  tableHead?: { col1: string; col2: string; col3?: string };  // table header
  tip?:     string;          // optional highlighted tip/callout
}
interface Faq {
  q: string;
  a: string;
}
interface RelatedGuide {
  title: string;
  slug:  string;
  img:   string;
  imgAlt: string;
  tag:   string;
}
interface Guide {
  title:       string;
  slug:        string;
  kicker:      string;
  heroImg:     string;
  heroImgAlt:  string;
  description: string;       // meta description
  intro:       string[];     // lead paragraphs shown before sections
  readTime?:   string;       // e.g. "8 min read"
  breadcrumb:  string;       // last breadcrumb label
  ctaHeading?: string;
  ctaBtn1?:    string;
  ctaBtn1Href?: string;
  ctaBtn2?:    string;
  ctaBtn2Href?: string;
}

interface Props {
  guide:        Guide;
  sections:     GuideSection[];
  faqs?:        Faq[];
  relatedGuides?: RelatedGuide[];
}

const { guide, sections, faqs = [], relatedGuides = [] } = Astro.props;

// ── JSON-LD schema ─────────────────────────────────────────────
const schemaGraph: object[] = [
  {
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home",         "item": "https://lokawatoursandtravel.com/" },
      { "@type": "ListItem", "position": 2, "name": "Plan",         "item": "https://lokawatoursandtravel.com/plan/" },
      { "@type": "ListItem", "position": 3, "name": guide.breadcrumb }
    ]
  },
  ...(faqs.length ? [{
    "@type": "FAQPage",
    "mainEntity": faqs.map(f => ({
      "@type": "Question",
      "name": f.q,
      "acceptedAnswer": { "@type": "Answer", "text": f.a }
    }))
  }] : [])
];

const schema = JSON.stringify({ "@context": "https://schema.org", "@graph": schemaGraph });
---

<BaseLayout
  title={`${guide.title} | L'okawa Tours Uganda`}
  description={guide.description}
  ogImage={guide.heroImg}
  schema={schema}
>

<!-- ════════════════════════════════════════════════════
     PAGE BANNER
════════════════════════════════════════════════════ -->
<div class="guide-banner">
  <div class="guide-banner__photo" aria-hidden="true"
    style={`background-image:url('${guide.heroImg}')`}></div>
  <svg viewBox="0 0 1440 340" preserveAspectRatio="xMidYMax slice"
    class="guide-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="230" r="110" fill="#ffd45a" opacity=".18"/>
    <circle cx="1130" cy="230" r="72"  fill="#ffd45a"/>
    <path d="M0 270 C220 240 400 266 580 244 C780 220 940 262 1140 242 C1280 228 1370 250 1440 244 L1440 340 L0 340Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 304 C240 282 440 304 660 292 C880 280 1100 306 1440 286 L1440 340 L0 340Z" fill="#0d1a0a"/>
    <g fill="#0d1a0a">
      <rect x="1246" y="206" width="9" height="90"/>
      <ellipse cx="1250" cy="200" rx="86" ry="22"/>
      <ellipse cx="1196" cy="214" rx="50" ry="14"/>
      <ellipse cx="1306" cy="212" rx="50" ry="14"/>
    </g>
  </svg>
  <div class="guide-banner__overlay" aria-hidden="true"></div>
  <div class="guide-banner__content">
    <div class="guide-banner__breadcrumb">
      <a href="/" class="guide-banner__bc-link">Home</a>
      <span>&nbsp;/&nbsp;</span>
      <a href="/plan/" class="guide-banner__bc-link">Plan</a>
      <span>&nbsp;/&nbsp;</span>
      <span class="guide-banner__bc-cur">{guide.breadcrumb}</span>
    </div>
    <p class="guide-banner__kicker">{guide.kicker}</p>
    <h1 class="guide-banner__h1">{guide.title}</h1>
    {guide.readTime && (
      <p class="guide-banner__meta">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 1 0 0 20A10 10 0 0 0 12 2zm0 18a8 8 0 1 1 0-16 8 8 0 0 1 0 16zm.5-13H11v6l5.25 3.15.75-1.23-4.5-2.67V7z"/></svg>
        {guide.readTime}
      </p>
    )}
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     GUIDE BODY — sidebar + main content
════════════════════════════════════════════════════ -->
<div class="guide-body">
  <div class="container guide-layout">

    <!-- Sticky sidebar TOC -->
    <aside class="guide-sidebar">
      <p class="guide-sidebar__label">In this guide</p>
      <nav aria-label="Guide table of contents">
        {sections.map((s, i) => (
          <a href={`#section-${i}`} class="guide-sidebar__link">
            <span class="guide-sidebar__num">{String(i + 1).padStart(2, '0')}</span>
            {s.heading}
          </a>
        ))}
        {faqs.length > 0 && (
          <a href="#guide-faqs" class="guide-sidebar__link">
            <span class="guide-sidebar__num">{String(sections.length + 1).padStart(2, '0')}</span>
            FAQs
          </a>
        )}
      </nav>
      <div class="guide-sidebar__cta">
        <p class="guide-sidebar__cta-text">Ready to book?</p>
        <a href="/contact/" class="btn btn--primary" style="width:100%;text-align:center;display:block;">Get a Free Quote</a>
        <a href="https://wa.me/256761512966" target="_blank" rel="noopener noreferrer" class="guide-sidebar__wa">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          WhatsApp us
        </a>
      </div>
    </aside>

    <!-- Main article -->
    <article class="guide-main">

      <!-- Intro -->
      {guide.intro.length > 0 && (
        <div class="guide-intro">
          {guide.intro.map(p => <p>{p}</p>)}
        </div>
      )}

      <!-- Sections -->
      {sections.map((s, i) => (
        <section id={`section-${i}`} class="guide-section">
          <h2 class="guide-section__h2">{s.heading}</h2>

          {s.body.map(p => <p class="guide-section__p">{p}</p>)}

          {s.bullets && s.bullets.length > 0 && (
            <ul class="guide-list">
              {s.bullets.map(b => (
                <li class="guide-list__item">
                  <svg class="guide-list__check" width="16" height="16" viewBox="0 0 24 24" fill="var(--color-green-mid)" aria-hidden="true"><path d="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41L9 16.17z"/></svg>
                  <span>{b}</span>
                </li>
              ))}
            </ul>
          )}

          {s.tableHead && s.table && s.table.length > 0 && (
            <div class="guide-table-wrap">
              <table class="guide-table">
                <thead>
                  <tr>
                    <th>{s.tableHead.col1}</th>
                    <th>{s.tableHead.col2}</th>
                    {s.tableHead.col3 && <th>{s.tableHead.col3}</th>}
                  </tr>
                </thead>
                <tbody>
                  {s.table.map(row => (
                    <tr>
                      <td>{row.col1}</td>
                      <td>{row.col2}</td>
                      {row.col3 && <td>{row.col3}</td>}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {s.tip && (
            <div class="guide-tip">
              <svg class="guide-tip__icon" width="18" height="18" viewBox="0 0 24 24" fill="var(--color-amber)" aria-hidden="true"><path d="M12 2a7 7 0 0 1 7 7c0 2.9-1.76 5.4-4.31 6.54L14 17H10l-.69-1.46C6.76 14.4 5 11.9 5 9a7 7 0 0 1 7-7zm0 18a1 1 0 0 0 1-1h-2a1 1 0 0 0 1 1zm-2-3h4v-1h-4v1z"/></svg>
              <p>{s.tip}</p>
            </div>
          )}
        </section>
      ))}

      <!-- FAQs -->
      {faqs.length > 0 && (
        <section id="guide-faqs" class="guide-section">
          <h2 class="guide-section__h2">Frequently Asked Questions</h2>
          <div class="guide-faq-list">
            {faqs.map(item => (
              <details class="guide-faq-item">
                <summary class="guide-faq-item__q">
                  <span>{item.q}</span>
                  <svg class="guide-faq-item__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <polyline points="6 9 12 15 18 9"/>
                  </svg>
                </summary>
                <div class="guide-faq-item__a"><p>{item.a}</p></div>
              </details>
            ))}
          </div>
        </section>
      )}

    </article>
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     RELATED GUIDES
════════════════════════════════════════════════════ -->
{relatedGuides.length > 0 && (
  <section class="guide-related">
    <div class="container">
      <h2 class="guide-related__heading">More Planning Guides</h2>
      <div class="guide-related__grid">
        {relatedGuides.map(g => (
          <a href={`/plan/${g.slug}/`} class="guide-card">
            <div class="guide-card__img-wrap">
              <img src={g.img} alt={g.imgAlt} class="guide-card__img" loading="lazy" width="400" height="240"/>
              <span class="guide-card__tag">{g.tag}</span>
            </div>
            <div class="guide-card__body">
              <h3 class="guide-card__title">{g.title}</h3>
              <span class="guide-card__arrow">Read guide &rarr;</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
)}

<!-- ════════════════════════════════════════════════════
     CTA BAND
════════════════════════════════════════════════════ -->
<CtaBand
  heading={guide.ctaHeading ?? 'Ready to plan your East Africa safari?'}
  btn1={guide.ctaBtn1 ?? 'Get a Free Quote'}
  btn1Href={guide.ctaBtn1Href ?? '/contact/'}
  btn2={guide.ctaBtn2 ?? 'Browse Tour Packages'}
  btn2Href={guide.ctaBtn2Href ?? '/tours/'}
/>

</BaseLayout>

<style>
/* ════════════════════════════════════
   BANNER
════════════════════════════════════ */
.guide-banner {
  position: relative;
  overflow: hidden;
  min-height: 360px;
  background: linear-gradient(180deg, #16290f 0%, #2f4d20 40%, #b8561a 82%, #f4b41a 100%);
}
.guide-banner__photo {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center 40%;
  opacity: 0.22;
  z-index: 0;
}
.guide-banner__svg {
  position: absolute; left: 0; bottom: 0;
  width: 100%; height: 100%;
  pointer-events: none; z-index: 1;
}
.guide-banner__overlay {
  position: absolute; inset: 0;
  background: linear-gradient(90deg,
    rgba(10,20,8,.85) 0%, rgba(10,20,8,.5) 55%, rgba(10,20,8,0) 88%);
  z-index: 1;
}
.guide-banner__content {
  position: relative; z-index: 2;
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 72px var(--section-pad-x) 110px;
  box-sizing: border-box;
}
.guide-banner__breadcrumb {
  font-size: 13px; font-weight: var(--weight-semibold);
  letter-spacing: .06em; color: var(--color-cream); margin-bottom: 14px;
}
.guide-banner__bc-link { color: var(--color-cream); transition: color var(--transition-fast); }
.guide-banner__bc-link:hover { color: var(--color-gold); }
.guide-banner__bc-cur { color: var(--color-gold); }
.guide-banner__kicker {
  font-family: var(--font-display); font-style: italic;
  font-weight: 500; font-size: 21px;
  color: var(--color-gold); margin-bottom: 8px; display: block;
}
.guide-banner__h1 {
  font-family: var(--font-display); font-weight: var(--weight-bold);
  font-size: clamp(36px, 5.5vw, 60px); line-height: var(--leading-tight);
  color: var(--color-white); margin: 0 0 14px;
}
.guide-banner__meta {
  display: flex; align-items: center; gap: 6px;
  font-size: 13px; font-weight: var(--weight-semibold);
  color: var(--color-cream); opacity: .8; letter-spacing: .04em;
}

/* ════════════════════════════════════
   LAYOUT
════════════════════════════════════ */
.guide-body { background: #fff; padding: 60px 0 80px; }
.guide-layout {
  display: grid;
  grid-template-columns: 260px 1fr;
  gap: 56px;
  align-items: start;
}

/* ════════════════════════════════════
   SIDEBAR
════════════════════════════════════ */
.guide-sidebar {
  position: sticky; top: 90px;
  background: #f8faf6;
  border: 1px solid #e0e8d8;
  border-radius: 12px;
  padding: 28px 22px;
}
.guide-sidebar__label {
  font-size: 11px; font-weight: var(--weight-bold);
  letter-spacing: .1em; text-transform: uppercase;
  color: var(--color-green-dark); margin-bottom: 14px;
}
.guide-sidebar__link {
  display: flex; align-items: flex-start; gap: 10px;
  font-size: 13.5px; font-weight: var(--weight-semibold);
  color: var(--color-text); padding: 7px 0;
  border-bottom: 1px solid #e8ede4;
  transition: color var(--transition-fast);
  text-decoration: none;
}
.guide-sidebar__link:last-of-type { border-bottom: none; }
.guide-sidebar__link:hover { color: var(--color-green-mid); }
.guide-sidebar__num {
  flex-shrink: 0;
  font-size: 11px; font-weight: var(--weight-bold);
  color: var(--color-amber); letter-spacing: .05em; padding-top: 2px;
}
.guide-sidebar__cta {
  margin-top: 24px; padding-top: 20px;
  border-top: 1px solid #e0e8d8;
}
.guide-sidebar__cta-text {
  font-size: 13px; font-weight: var(--weight-semibold);
  color: var(--color-green-dark); margin-bottom: 10px;
}
.guide-sidebar__wa {
  display: flex; align-items: center; justify-content: center; gap: 7px;
  margin-top: 10px;
  font-size: 13px; font-weight: var(--weight-semibold);
  color: #25d366; text-decoration: none;
  transition: opacity var(--transition-fast);
}
.guide-sidebar__wa:hover { opacity: .75; }

/* ════════════════════════════════════
   MAIN CONTENT
════════════════════════════════════ */
.guide-intro {
  margin-bottom: 44px;
  padding-bottom: 28px;
  border-bottom: 2px solid #e8ede4;
}
.guide-intro p {
  font-size: var(--text-lg); line-height: var(--leading-relaxed);
  color: var(--color-text); margin-bottom: 16px;
}
.guide-intro p:last-child { margin-bottom: 0; }

.guide-section { margin-bottom: 52px; }
.guide-section__h2 {
  font-family: var(--font-display); font-weight: var(--weight-bold);
  font-size: clamp(22px, 2.8vw, 30px); color: var(--color-green-dark);
  margin: 0 0 18px; padding-bottom: 12px;
  border-bottom: 2px solid var(--color-amber);
  display: inline-block;
}
.guide-section__p {
  font-size: var(--text-base); line-height: var(--leading-relaxed);
  color: var(--color-text); margin-bottom: 14px;
}
.guide-section__p:last-child { margin-bottom: 0; }

/* Bullet list */
.guide-list { margin: 16px 0 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
.guide-list__item { display: flex; align-items: flex-start; gap: 10px; font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--color-text); }
.guide-list__check { flex-shrink: 0; margin-top: 3px; }

/* Table */
.guide-table-wrap { overflow-x: auto; margin-top: 20px; border-radius: 10px; border: 1px solid #e0e8d8; }
.guide-table { width: 100%; border-collapse: collapse; font-size: 14px; }
.guide-table th {
  background: var(--color-green-dark); color: #fff;
  font-weight: var(--weight-semibold); text-align: left;
  padding: 11px 16px; letter-spacing: .03em;
}
.guide-table td { padding: 10px 16px; border-bottom: 1px solid #e8ede4; color: var(--color-text); vertical-align: top; }
.guide-table tr:last-child td { border-bottom: none; }
.guide-table tr:nth-child(even) td { background: #f8faf6; }

/* Tip callout */
.guide-tip {
  display: flex; align-items: flex-start; gap: 12px;
  background: #fffbea; border-left: 4px solid var(--color-amber);
  border-radius: 0 8px 8px 0; padding: 14px 18px; margin-top: 20px;
}
.guide-tip__icon { flex-shrink: 0; margin-top: 2px; }
.guide-tip p { font-size: 14px; line-height: var(--leading-relaxed); color: #5a4200; margin: 0; }

/* FAQ accordion */
.guide-faq-list { display: flex; flex-direction: column; gap: 0; margin-top: 8px; }
.guide-faq-item {
  border-bottom: 1px solid #e0e8d8;
}
.guide-faq-item__q {
  display: flex; align-items: center; justify-content: space-between; gap: 12px;
  padding: 16px 4px; cursor: pointer; list-style: none;
  font-size: var(--text-base); font-weight: var(--weight-semibold);
  color: var(--color-green-dark);
}
.guide-faq-item__q::-webkit-details-marker { display: none; }
.guide-faq-item__chevron { flex-shrink: 0; color: var(--color-amber); transition: transform .25s ease; }
.guide-faq-item[open] .guide-faq-item__chevron { transform: rotate(180deg); }
.guide-faq-item__a { padding: 0 4px 16px; }
.guide-faq-item__a p { font-size: var(--text-base); line-height: var(--leading-relaxed); color: var(--color-text); margin: 0; }

/* ════════════════════════════════════
   RELATED GUIDES
════════════════════════════════════ */
.guide-related { background: #f4f8f0; padding: 64px 0; }
.guide-related__heading {
  font-family: var(--font-display); font-weight: var(--weight-bold);
  font-size: clamp(24px, 3vw, 34px); color: var(--color-green-dark);
  text-align: center; margin-bottom: 36px;
}
.guide-related__grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
.guide-card { display: flex; flex-direction: column; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 2px 12px rgba(0,0,0,.06); text-decoration: none; transition: transform .25s ease, box-shadow .25s ease; }
.guide-card:hover { transform: translateY(-4px); box-shadow: 0 8px 28px rgba(0,0,0,.12); }
.guide-card__img-wrap { position: relative; height: 180px; overflow: hidden; }
.guide-card__img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
.guide-card__tag {
  position: absolute; top: 12px; left: 12px;
  background: var(--color-amber); color: #fff;
  font-size: 11px; font-weight: var(--weight-bold); letter-spacing: .07em;
  text-transform: uppercase; padding: 3px 9px; border-radius: 20px;
}
.guide-card__body { padding: 18px 20px; flex: 1; display: flex; flex-direction: column; gap: 10px; }
.guide-card__title { font-family: var(--font-display); font-weight: var(--weight-bold); font-size: 16px; color: var(--color-green-dark); margin: 0; line-height: 1.35; }
.guide-card__arrow { font-size: 13px; font-weight: var(--weight-semibold); color: var(--color-amber); margin-top: auto; }

/* ════════════════════════════════════
   RESPONSIVE
════════════════════════════════════ */
@media (max-width: 900px) {
  .guide-layout { grid-template-columns: 1fr; }
  .guide-sidebar { position: static; }
  .guide-related__grid { grid-template-columns: repeat(2, 1fr); }
}
@media (max-width: 560px) {
  .guide-banner__h1 { font-size: 32px; }
  .guide-related__grid { grid-template-columns: 1fr; }
}
</style>
