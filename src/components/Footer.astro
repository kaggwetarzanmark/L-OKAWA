---
/**
 * Footer.astro
 * Four-column footer matching the design:
 *   Col 1 — Logo + about blurb
 *   Col 2 — Destinations links
 *   Col 3 — Important links
 *   Col 4 — Contact details
 * Bottom bar — copyright + WhatsApp CTA
 */
---

<footer class="footer">
  <div class="footer__inner">

    <!-- Col 1: Brand -->
