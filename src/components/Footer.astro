          <a href="mailto:lokawatoursandtravelultd@gmail.com" class="footer__link">lokawatoursandtravelultd@gmail.com</a>
        </li>
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Mon – Sat, 8:00am – 6:00pm
        </li>
      </ul>

      <a href="/contact/" class="btn btn--primary footer__quote-btn">
        Get a Free Quote
      </a>
    </div>

  </div>

  <!-- Bottom bar -->
  <div class="footer__bottom">
    <div class="footer__bottom-inner">
      <span>© {new Date().getFullYear()} L'okawa Tours &amp; Travel (U) Ltd. Est. 2021. All rights reserved.</span>
      <div class="footer__bottom-links">
        <a href="/contact/" class="footer__link">Privacy Policy</a>
        <span aria-hidden="true">·</span>
        <a href="/contact/" class="footer__link">Terms &amp; Conditions</a>
      </div>
    </div>
  </div>
</footer>

<!-- ── Floating WhatsApp button — fixed bottom-right on every page ── -->
<a
  href="https://wa.me/256761512966"
  target="_blank"
  rel="noopener noreferrer"
  class="wa-float"
  aria-label="Chat with L'okawa Tours on WhatsApp"
>
  <svg class="wa-float__icon" width="28" height="28" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/>
  </svg>
</a>

<style>
.footer {
  background-color: var(--footer-bg);
  color: var(--footer-color);
}

/* ── Main grid ───────────────────────────────────── */
.footer__inner {
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 72px var(--section-pad-x) 0;
  display: flex;
  flex-wrap: wrap;
  gap: 40px;
}

.footer__col { flex: 1 1 200px; }
.footer__col--brand { flex: 1 1 260px; }

/* ── Logo ────────────────────────────────────────── */
.footer__logo-wrap {
  width: 96px;
  height: 96px;
  border-radius: var(--radius-full);
  background-color: var(--color-white);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
}
.footer__logo-wrap img { width: 84px; height: 84px; object-fit: contain; }

/* ── Heading ─────────────────────────────────────── */
.footer__heading {
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
  font-size: var(--text-lg);
  color: var(--footer-heading-color);
  margin-bottom: 14px;
}

/* ── Text ────────────────────────────────────────── */
.footer__text {
  font-size: var(--text-base);
  line-height: var(--leading-loose);
  margin-bottom: 18px;
}

/* ── Socials ─────────────────────────────────────── */
.footer__socials { display: flex; gap: 12px; }
.footer__social-link {
  color: var(--footer-color);
  transition: color var(--transition-fast);
}
.footer__social-link:hover { color: var(--color-gold); }

/* ── List ────────────────────────────────────────── */
.footer__list {
  display: flex;
  flex-direction: column;
  gap: 10px;
  font-size: var(--text-base);
}
.footer__list--contact { gap: 12px; }
.footer__list--contact li {
  display: flex;
  align-items: flex-start;
  gap: 8px;
}
.footer__list--contact svg { flex-shrink: 0; margin-top: 2px; }

/* ── Link ────────────────────────────────────────── */
.footer__link {
  color: var(--footer-color);
  transition: color var(--transition-fast);
}
.footer__link:hover { color: var(--color-gold); }

/* ── Quote button ────────────────────────────────── */
.footer__quote-btn {
  display: inline-block;
  margin-top: 20px;
}

/* ── Bottom bar ──────────────────────────────────── */
.footer__bottom {
  border-top: var(--footer-border);
  margin-top: 52px;
}
.footer__bottom-inner {
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 22px var(--section-pad-x);
  display: flex;
  flex-wrap: wrap;
  gap: 12px 24px;
  justify-content: space-between;
  align-items: center;
  font-size: var(--text-sm);
}
.footer__bottom-links { display: flex; gap: 12px; align-items: center; }

/* WhatsApp pill — removed, replaced by floating button below */

/* ── Floating WhatsApp button ────────────────────── */
.wa-float {
  position: fixed;
  bottom: 24px;
  right: 24px;
  z-index: 999;

  display: flex;
  align-items: center;
  justify-content: center;

  width: 56px;
  height: 56px;
  border-radius: 50%;

  background: #25D366;
  color: #0b2b14;
  text-decoration: none;

  /* Base shadow */
  box-shadow:
    0 4px 16px rgba(37, 211, 102, .45),
    0 0 0 0 rgba(37, 211, 102, .55);

  /* Glow pulse animation */
  animation: wa-glow 2.4s ease-out infinite;

  transition: transform 180ms ease, box-shadow 180ms ease;
}

.wa-float:hover {
  transform: scale(1.1);
  box-shadow:
    0 6px 24px rgba(37, 211, 102, .6),
    0 0 0 0 rgba(37, 211, 102, 0);
  animation-play-state: paused;
}

.wa-float__icon {
  flex-shrink: 0;
  display: block;
}

/* Pulsing glow keyframe — border ring expands and fades */
@keyframes wa-glow {
  0%   { box-shadow: 0 4px 16px rgba(37,211,102,.45), 0 0 0 0   rgba(37,211,102,.55); }
  60%  { box-shadow: 0 4px 16px rgba(37,211,102,.35), 0 0 0 14px rgba(37,211,102,0); }
  100% { box-shadow: 0 4px 16px rgba(37,211,102,.45), 0 0 0 0   rgba(37,211,102,.55); }
}

/* Reduce motion */
@media (prefers-reduced-motion: reduce) {
  .wa-float { animation: none; transition: none; }
  .wa-float:hover { transform: none; }
}

@media (max-width: 600px) {
  .wa-float { bottom: 16px; right: 16px; width: 52px; height: 52px; }
}

/* ── Responsive ──────────────────────────────────── */
@media (max-width: 600px) {
  .footer__inner { padding-top: 48px; gap: 32px; }
  .footer__bottom-inner { flex-direction: column; align-items: flex-start; }
}
</style>
