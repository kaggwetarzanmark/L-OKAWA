---
/**
 * ParkPage.astro
 * ─────────────────────────────────────────────────────────────
 * Reusable template for every national park / destination page.
 * Pass all content as props — zero repeated markup or CSS.
 *
 * USAGE (from destinations/[country]/[park]/index.astro):
 *   import ParkPage from '../../../../components/ParkPage.astro';
 *   <ParkPage {park} {facts} {sections} {activities} {tours} {faqs} />
 * ─────────────────────────────────────────────────────────────
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand    from '../components/CtaBand.astro';

interface Fact       { label: string; value: string; }
interface Section    { heading: string; body: string[]; }
interface Activity   { icon: string; title: string; text: string; }
interface Tour       { title: string; slug: string; days: number; price: string; img: string; imgAlt: string; }
interface Faq        { q: string; a: string; }
interface SidebarLink { label: string; href: string; }

interface Park {
  name:         string;
  country:      string;
  countrySlug:  string;
  slug:         string;
  tagline:      string;
  heroImg:      string;
  heroImgAlt:   string;
  description:  string;
  intro:        string[];
  bannerSub:    string;
  priceLabel:   string;
  priceNote:    string;
  sidebarLinks: SidebarLink[];
}

interface Props {
  park:       Park;
  facts:      Fact[];
  sections?:  Section[];   // optional named content sections (e.g. sectors, seasons)
  activities: Activity[];
  tours:      Tour[];
  faqs:       Faq[];
}

const { park, facts, sections = [], activities, tours, faqs } = Astro.props;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",         "item": "https://lokawatours.com/" },
        { "@type": "ListItem", "position": 2, "name": "Destinations", "item": "https://lokawatours.com/destinations/" },
        { "@type": "ListItem", "position": 3, "name": park.country,   "item": `https://lokawatours.com/destinations/${park.countrySlug}/` },
        { "@type": "ListItem", "position": 4, "name": park.name }
      ]
    },
    {
      "@type": "TouristAttraction",
      "name": park.name,
      "description": park.description,
      "image": `https://lokawatours.com${park.heroImg}`,
      "address": { "@type": "PostalAddress", "addressCountry": park.countrySlug === 'uganda' ? 'UG' : park.countrySlug === 'kenya' ? 'KE' : park.countrySlug === 'tanzania' ? 'TZ' : 'RW' }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
});
---

<BaseLayout
  title={`${park.name} — Safari Guide & Packages | L'okawa Tours`}
  description={park.description}
  ogImage={park.heroImg}
  schema={schema}
>

<!-- ════════════════════════════════════
     BANNER
════════════════════════════════════ -->
<div class="pp-banner">
  <div class="pp-banner__photo" aria-hidden="true"
    style={`background-image:url('${park.heroImg}')`}></div>
  <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice"
    class="pp-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="200" r="100" fill="#ffd45a" opacity=".2"/>
    <circle cx="1130" cy="200" r="65"  fill="#ffd45a"/>
    <path d="M0 240 C220 210 400 236 580 214 C780 190 940 232 1140 212 C1280 198 1370 220 1440 214 L1440 300 L0 300Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 272 C240 252 440 272 660 262 C880 250 1100 274 1440 256 L1440 300 L0 300Z" fill="#0d1a0a"/>
  </svg>
  <div class="pp-banner__overlay" aria-hidden="true"></div>
  <div class="pp-banner__content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a href="/destinations/" class="breadcrumb__link">Destinations</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a href={`/destinations/${park.countrySlug}/`} class="breadcrumb__link">{park.country}</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__cur">{park.name}</span>
    </nav>
    <p class="pp-banner__kicker">{park.tagline}</p>
    <h1 class="pp-banner__h1">{park.name}</h1>
    <p class="pp-banner__sub">{park.bannerSub}</p>
  </div>
</div>

<!-- ════════════════════════════════════
     QUICK FACTS STRIP
════════════════════════════════════ -->
<div class="pp-facts" aria-label={`${park.name} quick facts`}>
  <div class="container pp-facts__inner">
    {facts.map(f => (
      <div class="pp-fact">
        <span class="pp-fact__label">{f.label}</span>
        <span class="pp-fact__value">{f.value}</span>
      </div>
    ))}
  </div>
</div>

<!-- ════════════════════════════════════
     INTRO + SIDEBAR
════════════════════════════════════ -->
<section class="pp-intro section">
  <div class="container pp-intro__grid">
    <div class="pp-intro__text">
      <span class="kicker">About the park</span>
      <h2 class="pp-intro__heading">{park.name}</h2>
      {park.intro.map(p => <p class="body-lg pp-intro__p">{p}</p>)}
    </div>
    <aside class="pp-intro__sidebar">
      <div class="pp-sidebar-card">
        <div class="pp-sidebar-card__head">Plan Your Visit</div>
        <p class="pp-sidebar-card__price">{park.priceLabel}</p>
        <p class="pp-sidebar-card__note">{park.priceNote}</p>
        <a href="/contact/" class="btn btn--primary" style="width:100%;text-align:center;margin-bottom:8px;display:block;">Get a Free Quote</a>
        <a href="https://wa.me/256761512966" target="_blank" rel="noopener noreferrer" class="pp-sidebar-wa">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          WhatsApp us instantly
        </a>
      </div>
      {park.sidebarLinks.length > 0 && (
        <div class="pp-related-links">
          <h3 class="pp-related-links__heading">Useful Guides</h3>
          <ul>
            {park.sidebarLinks.map(l => (
              <li><a href={l.href} class="pp-related-link">{l.label}</a></li>
            ))}
          </ul>
        </div>
      )}
    </aside>
  </div>
</section>

<!-- ════════════════════════════════════
     NAMED SECTIONS (sectors, seasons, etc.)
════════════════════════════════════ -->
{sections.map((s, i) => (
  <section class={i % 2 === 0 ? 'pp-section section--parchment' : 'pp-section section'}>
    <div class="container">
      <h2 class="pp-section__h2">{s.heading}</h2>
      {s.body.map(p => <p class="pp-section__p">{p}</p>)}
    </div>
  </section>
))}

<!-- ════════════════════════════════════
     ACTIVITIES
════════════════════════════════════ -->
<section class="pp-activities section--parchment" aria-labelledby="activities-heading">
  <div class="container">
    <span class="kicker">What to do</span>
    <h2 id="activities-heading" class="section-title">Activities in {park.name}</h2>
    <div class="activities-grid">
      {activities.map(a => (
        <div class="activity-card">
          <div class="activity-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="var(--color-forest)" aria-hidden="true">
              <path d={a.icon}/>
            </svg>
          </div>
          <h3 class="activity-card__title">{a.title}</h3>
          <p class="activity-card__text">{a.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════
     TOURS
════════════════════════════════════ -->
<section class="pp-tours section" aria-labelledby="tours-heading">
  <div class="container">
    <span class="kicker">Safari packages</span>
    <h2 id="tours-heading" class="section-title">Tours Visiting {park.name}</h2>
    <div class="pp-tours-grid">
      {tours.map(t => (
        <div class="tour-card">
          <a href={`/tours/${t.slug}/`} class="tour-card__img-link" aria-label={t.title}>
            <img src={t.img} alt={t.imgAlt} class="tour-card__img" loading="lazy" width="400" height="240"/>
            <span class="tour-card__badge badge badge--amber">{t.days} Days</span>
          </a>
          <div class="tour-card__body">
            <h3 class="tour-card__title">
              <a href={`/tours/${t.slug}/`} class="tour-card__title-link">{t.title}</a>
            </h3>
            <div class="tour-card__footer">
              <span class="tour-card__meta">{t.price}</span>
              <a href={`/tours/${t.slug}/`} class="btn btn--ghost btn--sm">View Tour</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════
     FAQ
════════════════════════════════════ -->
<section class="pp-faq section--parchment" aria-labelledby="faq-heading">
  <div class="container pp-faq__inner">
    <div class="pp-faq__intro">
      <span class="kicker">Common questions</span>
      <h2 id="faq-heading" class="pp-faq__intro h2">{park.name} FAQ</h2>
      <p class="pp-faq__sub">Everything you need to know before you go.</p>
      <a href="/contact/" class="btn btn--primary">Ask a Question</a>
    </div>
    <div class="faq-list">
      {faqs.map(item => (
        <details class="faq-item">
          <summary class="faq-item__q">
            <span>{item.q}</span>
            <svg class="faq-item__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="faq-item__a">{item.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════
     CTA BAND
════════════════════════════════════ -->
<CtaBand
  heading={`Ready to visit ${park.name}?`}
  btn1="Get a Free Quote"
  btn1Href="/contact/"
  btn2="Browse All Tours"
  btn2Href="/tours/"
/>

</BaseLayout>

<style>
/* ── Banner ── */
.pp-banner { position:relative; overflow:hidden; min-height:320px; background:linear-gradient(180deg,#16290f 0%,#2f4d20 40%,#b8561a 82%,#f4b41a 100%); }
.pp-banner__photo { position:absolute; inset:0; background-size:cover; background-position:center 30%; opacity:.25; z-index:0; }
.pp-banner__svg   { position:absolute; left:0; bottom:0; width:100%; height:100%; pointer-events:none; z-index:1; }
.pp-banner__overlay { position:absolute; inset:0; background:linear-gradient(90deg,rgba(10,20,8,.82) 0%,rgba(10,20,8,.4) 55%,rgba(10,20,8,0) 85%); z-index:1; }
.pp-banner__content { position:relative; z-index:2; max-width:var(--max-width); margin-inline:auto; padding:56px var(--section-pad-x) 72px; box-sizing:border-box; }
.pp-banner__kicker { font-family:var(--font-display); font-style:italic; font-weight:500; font-size:20px; color:var(--color-gold); margin-bottom:4px; display:block; }
.pp-banner__h1 { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:clamp(30px,4vw,52px); line-height:1.1; color:var(--color-white); margin:0 0 12px; }
.pp-banner__sub { font-size:var(--text-lg); color:var(--color-cream); opacity:.9; max-width:480px; line-height:var(--leading-relaxed); }
/* ── Breadcrumb ── */
.breadcrumb { display:flex; flex-wrap:wrap; align-items:center; gap:6px 8px; font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-cream); margin-bottom:14px; }
.breadcrumb__link { color:var(--color-cream); transition:color var(--transition-fast); }
.breadcrumb__link:hover { color:var(--color-gold); }
.breadcrumb__sep { opacity:.4; }
.breadcrumb__cur { color:var(--color-gold); }
/* ── Facts strip ── */
.pp-facts { background:var(--color-forest); }
.pp-facts__inner { display:flex; flex-wrap:wrap; max-width:var(--max-width); margin-inline:auto; }
.pp-fact { flex:1 1 130px; display:flex; flex-direction:column; gap:3px; padding:16px 14px; border-right:1px solid rgba(243,236,216,.15); }
.pp-fact:last-child { border-right:none; }
.pp-fact__label { font-size:var(--text-xs); font-weight:var(--weight-extrabold); letter-spacing:var(--tracking-widest); text-transform:uppercase; color:var(--color-gold); }
.pp-fact__value { font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-cream); line-height:1.4; }
/* ── Intro grid ── */
.pp-intro__grid { display:grid; grid-template-columns:1fr 300px; gap:48px; align-items:start; }
.pp-intro__heading { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-5xl); line-height:var(--leading-snug); text-transform:uppercase; color:var(--color-text-primary); margin:8px 0 20px; }
.pp-intro__p { margin-bottom:16px; }
/* ── Sidebar ── */
.pp-sidebar-card { background:var(--color-white); border-radius:var(--radius-xl); padding:24px; box-shadow:var(--shadow-card); border-top:4px solid var(--color-amber); display:flex; flex-direction:column; gap:12px; position:sticky; top:96px; }
.pp-sidebar-card__head { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-xl); color:var(--color-forest); }
.pp-sidebar-card__price { font-size:var(--text-lg); color:var(--color-text-body); }
.pp-sidebar-card__note { font-size:var(--text-sm); color:var(--color-text-muted); line-height:1.55; }
.pp-sidebar-wa { display:flex; align-items:center; justify-content:center; gap:8px; background:#25D366; color:#0b2b14; border-radius:var(--radius-lg); padding:10px; font-size:var(--text-sm); font-weight:var(--weight-extrabold); transition:opacity var(--transition-fast); text-decoration:none; }
.pp-sidebar-wa:hover { opacity:.88; }
.pp-related-links { background:var(--color-parchment); border-radius:var(--radius-xl); padding:20px; margin-top:16px; }
.pp-related-links__heading { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-base); color:var(--color-forest); margin-bottom:12px; }
.pp-related-links ul { display:flex; flex-direction:column; gap:8px; }
.pp-related-link { font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-forest); transition:color var(--transition-fast); text-decoration:none; }
.pp-related-link:hover { color:var(--color-amber); }
/* ── Named sections ── */
.pp-section { padding-block:var(--section-pad-y); }
.pp-section__h2 { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-4xl); color:var(--color-text-primary); margin:0 0 16px; padding-bottom:10px; border-bottom:2px solid var(--color-amber); display:inline-block; }
.pp-section__p { font-size:var(--text-base); line-height:var(--leading-relaxed); color:var(--color-text-body); margin-bottom:14px; }
/* ── Activities ── */
.pp-activities { padding-block:var(--section-pad-y); }
.activities-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(240px,1fr)); gap:20px; margin-top:28px; }
.activity-card { background:var(--color-white); border-radius:var(--radius-xl); padding:24px; box-shadow:var(--shadow-card); display:flex; flex-direction:column; gap:10px; border-top:4px solid var(--color-amber); }
.activity-card__icon { width:44px; height:44px; border-radius:var(--radius-lg); background:var(--color-parchment); display:flex; align-items:center; justify-content:center; }
.activity-card__title { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-xl); color:var(--color-forest); }
.activity-card__text { font-size:var(--text-base); color:var(--color-text-body); line-height:var(--leading-relaxed); flex:1; }
/* ── Tours ── */
.pp-tours { padding-block:var(--section-pad-y); }
.pp-tours-grid { display:flex; flex-wrap:wrap; gap:24px; margin-top:28px; }
.tour-card { flex:1 1 240px; background:var(--color-white); border-radius:var(--radius-lg); box-shadow:var(--shadow-card-md); overflow:hidden; display:flex; flex-direction:column; }
.tour-card__img-link { display:block; position:relative; height:180px; overflow:hidden; flex-shrink:0; }
.tour-card__img { width:100%; height:100%; object-fit:cover; transition:transform .4s ease; }
.tour-card:hover .tour-card__img { transform:scale(1.04); }
.tour-card__badge { position:absolute; left:10px; top:10px; }
.tour-card__body { padding:16px; display:flex; flex-direction:column; gap:8px; flex:1; }
.tour-card__title { font-weight:var(--weight-extrabold); font-size:var(--text-base); line-height:var(--leading-normal); color:var(--color-forest); }
.tour-card__title-link { color:inherit; transition:color var(--transition-fast); text-decoration:none; }
.tour-card__title-link:hover { color:var(--color-amber); }
.tour-card__footer { display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--color-card-border); padding-top:10px; margin-top:auto; }
.tour-card__meta { font-size:13px; font-weight:var(--weight-bold); color:var(--color-text-body); }
/* ── FAQ ── */
.pp-faq { padding-block:var(--section-pad-y); }
.pp-faq__inner { display:grid; grid-template-columns:260px 1fr; gap:48px; align-items:start; }
.pp-faq__intro { position:sticky; top:96px; }
.pp-faq__intro h2 { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-4xl); line-height:var(--leading-snug); color:var(--color-text-primary); margin:6px 0 0; }
.pp-faq__sub { margin:16px 0 24px; font-size:var(--text-base); color:var(--color-text-body); line-height:var(--leading-relaxed); }
.faq-list { display:flex; flex-direction:column; gap:3px; }
.faq-item { border:1px solid var(--color-card-border); border-radius:var(--radius-lg); overflow:hidden; background:var(--color-white); transition:border-color var(--transition-fast); }
.faq-item[open] { border-color:var(--color-amber); }
.faq-item__q { display:flex; justify-content:space-between; align-items:center; gap:14px; padding:16px 20px; font-weight:var(--weight-bold); font-size:var(--text-base); color:var(--color-forest); cursor:pointer; list-style:none; transition:background var(--transition-fast); line-height:var(--leading-normal); }
.faq-item__q::-webkit-details-marker { display:none; }
.faq-item__q:hover { background:var(--color-parchment); }
.faq-item[open] .faq-item__q { background:var(--color-parchment); color:var(--color-amber); border-bottom:1px solid var(--color-card-border); }
.faq-item__chevron { flex-shrink:0; color:var(--color-amber); transition:transform var(--transition-base); }
.faq-item[open] .faq-item__chevron { transform:rotate(180deg); }
.faq-item__a { padding:14px 20px 18px; font-size:var(--text-base); line-height:1.75; color:var(--color-text-body); }
/* ── Responsive ── */
@media (max-width:1024px) { .pp-intro__grid { grid-template-columns:1fr; } .pp-intro__sidebar { position:static; } .pp-faq__inner { grid-template-columns:1fr; } .pp-faq__intro { position:static; } }
@media (max-width:768px)  { .pp-banner__h1 { font-size:clamp(26px,6vw,44px); } }
@media (max-width:600px)  { .pp-banner__content { padding:44px 24px 60px; } .pp-fact { border-right:none; border-bottom:1px solid rgba(243,236,216,.15); } }
</style>
