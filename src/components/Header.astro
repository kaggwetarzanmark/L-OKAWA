---
/**
 * Header.astro
 * Two-tier header matching the design system:
 *   1. Top info bar  — dark green, phone + hours / email + socials
 *   2. Main nav bar  — white, logo + nav links + CTA button
 *
 * Active link detection uses Astro.url.pathname.
 * Mobile menu toggle uses a minimal inline script (zero deps).
 */
const pathname = Astro.url.pathname;

const isActive = (href: string) => {
  if (href === '/') return pathname === '/';
  return pathname.startsWith(href);
};

const navLinks = [
  { label: 'Home',         href: '/' },
  { label: 'Destinations', href: '/destinations/', hasDropdown: true },
  { label: 'Tours',        href: '/tours/',        hasDropdown: true },
  { label: 'Gallery',      href: '/gallery/' },
  { label: 'About Us',     href: '/about/' },
  { label: 'FAQs',         href: '/plan/faq/' },
];

const destinationLinks = [
  { label: 'All Destinations', href: '/destinations/' },
  { label: '— Uganda',         href: '/destinations/uganda/' },
  { label: '— Kenya',          href: '/destinations/kenya/' },
  { label: '— Tanzania',       href: '/destinations/tanzania/' },
  { label: '— Rwanda',         href: '/destinations/rwanda/' },
];

const tourLinks = [
  { label: 'All Tours',          href: '/tours/' },
  { label: 'Gorilla Trekking',   href: '/tours/3-days-uganda-gorilla-safari/' },
  { label: 'Wildlife Safaris',   href: '/tours/7-days-uganda-wildlife-safari/' },
  { label: 'Primate Safaris',    href: '/tours/5-days-uganda-primates-safari/' },
  { label: 'Family Safaris',     href: '/tours/6-days-uganda-family-gorilla-safari/' },
  { label: 'Honeymoon Safaris',  href: '/tours/4-days-gorilla-trekking-lake-bunyonyi/' },
  { label: 'Budget Safaris',     href: '/tours/3-days-murchison-falls-safari/' },
  { label: 'Multi-Country Tours',href: '/tours/7-days-uganda-gorilla-chimp-wildlife-safari/' },
];

const planLinks = [
  { label: 'Planning Hub',            href: '/plan/' },
  { label: 'Safari FAQ',              href: '/plan/faq/' },
  { label: 'Gorilla Permit Guide',    href: '/plan/gorilla-permit-guide/' },
  { label: 'Best Time: Uganda',       href: '/plan/best-time-to-visit-uganda/' },
  { label: 'Best Time: Kenya',        href: '/plan/best-time-to-visit-kenya/' },
  { label: 'Safari Packing List',     href: '/plan/safari-packing-list/' },
  { label: 'Safari Cost Guide',       href: '/plan/safari-cost-guide/' },
  { label: 'Is Uganda Safe?',         href: '/plan/is-uganda-safe/' },
];
---

<!-- ═══════════════════════ TOP BAR ═══════════════════════════ -->
<div class="topbar">
  <div class="topbar__inner">
    <div class="topbar__left">
      <a href="tel:+256761512966" class="topbar__link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        +256 761 512 966
      </a>
      <span class="topbar__divider">|</span>
      <span>Mon – Sat, 8:00am – 6:00pm</span>
    </div>
    <div class="topbar__right">
      <a href="mailto:lokawatoursandtravelultd@gmail.com" class="topbar__link">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
        lokawatoursandtravelultd@gmail.com
      </a>
      <span class="topbar__divider">|</span>
      <div class="topbar__socials">
        <a href="https://www.facebook.com/profile.php?id=100092965934215" target="_blank" rel="noopener noreferrer" aria-label="Facebook" class="topbar__link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
        </a>
        <a href="https://www.instagram.com/lokawa_tours_and_travel_u_ltd" target="_blank" rel="noopener noreferrer" aria-label="Instagram" class="topbar__link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
        </a>
        <a href="https://wa.me/256761512966" target="_blank" rel="noopener noreferrer" aria-label="WhatsApp" class="topbar__link">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
        </a>
      </div>
    </div>
  </div>
</div>

<!-- ═══════════════════════ MAIN NAV ══════════════════════════ -->
<header class="nav" id="main-header">
  <div class="nav__inner">

    <!-- Logo -->
    <a href="/" class="nav__logo" aria-label="L'okawa Tours – Home">
      <img src="/images/logo.png" alt="L'okawa Tours and Travel (U) Ltd — Where Nature Meets Attraction" width="88" height="88" />
    </a>

    <!-- Desktop nav -->
    <nav class="nav__links" aria-label="Main navigation">
      {navLinks.map((link) => (
        link.hasDropdown ? (
          <div class="nav__item nav__item--dropdown">
            <a
              href={link.href}
              class={`nav__link ${isActive(link.href) ? 'nav__link--active' : ''}`}
            >
              {link.label}
              <svg class="nav__chevron" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
            </a>
            <div class="nav__dropdown">
              {link.label === 'Destinations' && destinationLinks.map((d) => (
                <a href={d.href} class="nav__dropdown-link">{d.label}</a>
              ))}
              {link.label === 'Tours' && tourLinks.map((t) => (
                <a href={t.href} class="nav__dropdown-link">{t.label}</a>
              ))}
              {link.label === 'Plan' && planLinks.map((p) => (
                <a href={p.href} class="nav__dropdown-link">{p.label}</a>
              ))}
            </div>
          </div>
        ) : (
          <a
            href={link.href}
            class={`nav__link ${isActive(link.href) ? 'nav__link--active' : ''}`}
          >
            {link.label}
          </a>
        )
      ))}
    </nav>

    <!-- CTA -->
    <a href="/contact/" class="btn btn--primary nav__cta">Request Quotation</a>

    <!-- Mobile hamburger -->
    <button class="nav__hamburger" id="nav-toggle" aria-label="Toggle navigation" aria-expanded="false" aria-controls="mobile-menu">
      <span></span>
      <span></span>
      <span></span>
    </button>
  </div>

  <!-- Mobile menu -->
  <div class="nav__mobile" id="mobile-menu" aria-hidden="true">
    <nav aria-label="Mobile navigation">
      <a href="/" class={`nav__mobile-link ${isActive('/') ? 'nav__mobile-link--active' : ''}`}>Home</a>

      <div class="nav__mobile-section">Destinations</div>
      {destinationLinks.map((d) => (
        <a href={d.href} class="nav__mobile-link nav__mobile-link--indent">{d.label}</a>
      ))}

      <div class="nav__mobile-section">Tours</div>
      {tourLinks.map((t) => (
        <a href={t.href} class="nav__mobile-link nav__mobile-link--indent">{t.label}</a>
      ))}

      <a href="/about/" class={`nav__mobile-link ${isActive('/about/') ? 'nav__mobile-link--active' : ''}`}>About Us</a>
      <a href="/gallery/" class={`nav__mobile-link ${isActive('/gallery/') ? 'nav__mobile-link--active' : ''}`}>Gallery</a>
      <a href="/plan/faq/" class={`nav__mobile-link ${isActive('/plan/faq/') ? 'nav__mobile-link--active' : ''}`}>FAQs</a>
      <a href="/contact/" class="btn btn--primary nav__mobile-cta">Request Quotation</a>
    </nav>
  </div>
</header>

<!-- ═══════════════════════ STYLES ════════════════════════════ -->
<style>
/* ── Top bar ─────────────────────────────────────── */
.topbar {
  background-color: var(--color-forest);
  color: var(--color-cream);
  font-size: var(--text-sm);
}
.topbar__inner {
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 9px var(--section-pad-x);
  display: flex;
  flex-wrap: wrap;
  gap: 6px 28px;
  justify-content: space-between;
  align-items: center;
}
.topbar__left,
.topbar__right {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 6px 16px;
}
.topbar__link {
  display: flex;
  align-items: center;
  gap: 6px;
  color: var(--color-cream);
  transition: color var(--transition-fast);
}
.topbar__link:hover { color: var(--color-gold); }
.topbar__divider { opacity: .35; }
.topbar__socials { display: flex; gap: 10px; }

/* ── Main nav ────────────────────────────────────── */
.nav {
  background-color: var(--nav-bg);
  box-shadow: var(--shadow-nav);
  position: sticky;
  top: 0;
  z-index: 100;
}
.nav__inner {
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 10px var(--section-pad-x);
  display: flex;
  align-items: center;
  gap: 12px 32px;
  justify-content: space-between;
}
.nav__logo img {
  height: 70px;
  width: auto;
  display: block;
}
.nav__links {
  display: flex;
  align-items: center;
  gap: 4px 6px;
  flex-wrap: wrap;
}

/* Nav link */
.nav__link {
  display: flex;
  align-items: center;
  gap: 4px;
  font-family: var(--font-body);
  font-weight: var(--weight-extrabold);
  font-size: var(--text-sm);
  letter-spacing: var(--tracking-wider);
  text-transform: uppercase;
  color: var(--color-forest);
  padding: 8px 10px;
  border-radius: var(--radius-sm);
  border-bottom: 3px solid transparent;
  transition: color var(--transition-fast), border-color var(--transition-fast);
  white-space: nowrap;
}
.nav__link:hover,
.nav__link--active {
  color: var(--color-amber);
  border-bottom-color: var(--color-amber);
}
.nav__chevron {
  transition: transform var(--transition-fast);
  flex-shrink: 0;
}

/* CTA button */
.nav__cta {
  margin-left: 8px;
  white-space: nowrap;
  flex-shrink: 0;
}

/* ── Dropdown ────────────────────────────────────── */
.nav__item { position: relative; }
.nav__dropdown {
  display: none;
  position: absolute;
  top: calc(100% + 6px);
  left: 0;
  min-width: 210px;
  background: var(--color-white);
  border-radius: var(--radius-lg);
  box-shadow: var(--shadow-card-md);
  border-top: 3px solid var(--color-amber);
  padding: 8px 0;
  z-index: 200;
}
.nav__item:hover .nav__dropdown,
.nav__item:focus-within .nav__dropdown {
  display: block;
}
.nav__item:hover .nav__chevron {
  transform: rotate(180deg);
}
.nav__dropdown-link {
  display: block;
  padding: 9px 18px;
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  color: var(--color-text-body);
  transition: background var(--transition-fast), color var(--transition-fast);
}
.nav__dropdown-link:hover {
  background: var(--color-parchment);
  color: var(--color-forest);
}

/* ── Hamburger ───────────────────────────────────── */
.nav__hamburger {
  display: none;
  flex-direction: column;
  gap: 5px;
  padding: 8px;
  background: none;
  border: none;
  cursor: pointer;
  flex-shrink: 0;
}
.nav__hamburger span {
  display: block;
  width: 24px;
  height: 2px;
  background: var(--color-forest);
  border-radius: 2px;
  transition: transform var(--transition-base), opacity var(--transition-base);
}
.nav__hamburger[aria-expanded="true"] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
.nav__hamburger[aria-expanded="true"] span:nth-child(2) { opacity: 0; }
.nav__hamburger[aria-expanded="true"] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

/* ── Mobile menu ─────────────────────────────────── */
.nav__mobile {
  display: none;
  background: var(--color-white);
  border-top: 1px solid var(--color-card-border);
  padding: 16px var(--section-pad-x) 24px;
}
.nav__mobile.is-open { display: block; }
.nav__mobile-link {
  display: block;
  padding: 10px 4px;
  font-weight: var(--weight-bold);
  font-size: var(--text-base);
  color: var(--color-forest);
  border-bottom: 1px solid var(--color-card-border);
  transition: color var(--transition-fast);
}
.nav__mobile-link:hover,
.nav__mobile-link--active { color: var(--color-amber); }
.nav__mobile-link--indent {
  padding-left: 20px;
  font-weight: var(--weight-regular);
  font-size: var(--text-sm);
  color: var(--color-text-body);
}
.nav__mobile-section {
  padding: 12px 4px 4px;
  font-size: var(--text-xs);
  font-weight: var(--weight-extrabold);
  letter-spacing: var(--tracking-widest);
  text-transform: uppercase;
  color: var(--color-amber);
}
.nav__mobile-cta {
  display: block;
  text-align: center;
  margin-top: 20px;
  width: 100%;
}

/* ── Responsive ──────────────────────────────────── */
@media (max-width: 900px) {
  .nav__links,
  .nav__cta { display: none; }
  .nav__hamburger { display: flex; }
}
@media (max-width: 600px) {
  .topbar__right,
  .topbar__divider { display: none; }
  .nav__logo img { height: 56px; }
}
</style>

<!-- ═══════════════════════ SCRIPT ════════════════════════════ -->
<script>
  const toggle = document.getElementById('nav-toggle');
  const menu   = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
    });
  }
</script>
