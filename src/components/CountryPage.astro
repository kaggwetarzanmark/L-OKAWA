---
/**
 * CountryPage.astro
 * ─────────────────────────────────────────────────────────────
 * Reusable template for every country destination page
 * (Uganda, Kenya, Tanzania, Rwanda).
 *
 * USAGE (from destinations/[country]/index.astro):
 *   import CountryPage from '../../../components/CountryPage.astro';
 *   <CountryPage {country} {facts} {parks} {tours} {months} {essentials} {faqs} />
 * ─────────────────────────────────────────────────────────────
 */

import BaseLayout from '../layouts/BaseLayout.astro';
import CtaBand    from '../components/CtaBand.astro';

interface Fact      { label: string; value: string; }
interface Park      { name: string; slug: string; img: string; imgAlt: string; tag: string; teaser: string; permit: string; }
interface Tour      { title: string; slug: string; days: number; price: string; img: string; imgAlt: string; }
interface Month     { name: string; rating: number; note: string; } // rating 1-5
interface Essential { icon: string; title: string; text: string; link: string; }
interface Faq       { q: string; a: string; }

interface Country {
  name:        string;
  slug:        string;
  tagline:     string;
  description: string;
  heroImg:     string;
  heroImgAlt:  string;
  intro:       string[];
  metaTitle:   string;
}

interface Props {
  country:    Country;
  facts:      Fact[];
  parks:      Park[];
  tours:      Tour[];
  months:     Month[];
  essentials: Essential[];
  faqs:       Faq[];
}

const { country, facts, parks, tours, months, essentials, faqs } = Astro.props;

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",         "item": "https://lokawatoursandtravel.com/" },
        { "@type": "ListItem", "position": 2, "name": "Destinations", "item": "https://lokawatoursandtravel.com/destinations/" },
        { "@type": "ListItem", "position": 3, "name": country.name }
      ]
    },
    {
      "@type": "TouristDestination",
      "name": country.name,
      "description": country.description,
      "includesAttraction": parks.map(p => ({
        "@type": "TouristAttraction",
        "name": p.name,
        "url": `https://lokawatoursandtravel.com/destinations/${country.slug}/${p.slug}/`
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
});
---

<BaseLayout
  title={country.metaTitle}
  description={country.description}
  ogImage={country.heroImg}
  schema={schema}
>

<!-- ════════════════════════════════════
     BANNER
════════════════════════════════════ -->
<div class="cp-banner">
  <div class="cp-banner__photo" aria-hidden="true"
    style={`background-image:url('${country.heroImg}')`}></div>
  <svg viewBox="0 0 1440 340" preserveAspectRatio="xMidYMax slice"
    class="cp-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="230" r="110" fill="#ffd45a" opacity=".18"/>
    <circle cx="1130" cy="230" r="72"  fill="#ffd45a"/>
    <path d="M0 270 C220 240 400 266 580 244 C780 220 940 262 1140 242 C1280 228 1370 250 1440 244 L1440 340 L0 340Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 304 C240 282 440 304 660 292 C880 280 1100 306 1440 286 L1440 340 L0 340Z" fill="#0d1a0a"/>
    <g fill="#0d1a0a">
      <rect x="1246" y="206" width="9" height="90"/>
      <ellipse cx="1250" cy="200" rx="86" ry="22"/>
      <ellipse cx="1196" cy="214" rx="50" ry="14"/>
      <ellipse cx="1306" cy="212" rx="50" ry="14"/>
    </g>
  </svg>
  <div class="cp-banner__overlay" aria-hidden="true"></div>
  <div class="cp-banner__content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a href="/destinations/" class="breadcrumb__link">Destinations</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__cur">{country.name}</span>
    </nav>
    <p class="cp-banner__kicker">{country.tagline}</p>
    <h1 class="cp-banner__h1">{country.name} Safari</h1>
    <p class="cp-banner__sub">{country.description}</p>
  </div>
</div>

<!-- ════════════════════════════════════
     QUICK FACTS STRIP
════════════════════════════════════ -->
<div class="cp-facts" aria-label={`${country.name} quick facts`}>
  <div class="container cp-facts__inner">
    {facts.map(f => (
      <div class="cp-fact">
        <span class="cp-fact__label">{f.label}</span>
        <span class="cp-fact__value">{f.value}</span>
      </div>
    ))}
  </div>
</div>

<!-- ════════════════════════════════════
     INTRO
════════════════════════════════════ -->
<section class="cp-intro section">
  <div class="container cp-intro__grid">
    <div class="cp-intro__text">
      <span class="kicker">Why visit {country.name}</span>
      <h2 class="cp-intro__h2">Safari in {country.name}</h2>
      {country.intro.map(p => <p class="body-lg cp-intro__p">{p}</p>)}
    </div>
    <aside class="cp-intro__sidebar">
      <div class="cp-sidebar-card">
        <div class="cp-sidebar-card__head">Plan Your {country.name} Safari</div>
        <p class="cp-sidebar-card__note">Tell us your dates, group size and interests. We will build a tailored itinerary within 24 hours.</p>
        <a href="/contact/" class="btn btn--primary" style="width:100%;text-align:center;display:block;margin-bottom:8px;">Get a Free Quote</a>
        <a href="https://wa.me/256761512966" target="_blank" rel="noopener noreferrer" class="cp-sidebar-wa">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          WhatsApp us instantly
        </a>
      </div>
    </aside>
  </div>
</section>

<!-- ════════════════════════════════════
     PARKS / DESTINATIONS GRID
════════════════════════════════════ -->
<section class="cp-parks section--parchment" aria-labelledby="parks-heading">
  <div class="container">
    <span class="kicker">Where to go</span>
    <h2 id="parks-heading" class="section-title">National Parks &amp; Destinations</h2>
    <div class="cp-parks-grid">
      {parks.map(p => (
        <a href={`/destinations/${country.slug}/${p.slug}/`} class="park-card">
          <div class="park-card__img-wrap">
            <img src={p.img} alt={p.imgAlt} class="park-card__img" loading="lazy" width="480" height="300"/>
            <span class="park-card__tag">{p.tag}</span>
          </div>
          <div class="park-card__body">
            <h3 class="park-card__name">{p.name}</h3>
            <p class="park-card__teaser">{p.teaser}</p>
            <div class="park-card__foot">
              <span class="park-card__permit">Entry: {p.permit}</span>
              <span class="park-card__arrow">Explore &rarr;</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════
     TOURS
════════════════════════════════════ -->
<section class="cp-tours section" aria-labelledby="tours-heading">
  <div class="container">
    <span class="kicker">Safari packages</span>
    <h2 id="tours-heading" class="section-title">{country.name} Safari Packages</h2>
    <div class="cp-tours-grid">
      {tours.map(t => (
        <div class="tour-card">
          <a href={`/tours/${t.slug}/`} class="tour-card__img-link" aria-label={t.title}>
            <img src={t.img} alt={t.imgAlt} class="tour-card__img" loading="lazy" width="400" height="240"/>
            <span class="tour-card__badge badge badge--amber">{t.days} Days</span>
          </a>
          <div class="tour-card__body">
            <h3 class="tour-card__title">
              <a href={`/tours/${t.slug}/`} class="tour-card__title-link">{t.title}</a>
            </h3>
            <div class="tour-card__footer">
              <span class="tour-card__meta">{t.price}</span>
              <a href={`/tours/${t.slug}/`} class="btn btn--ghost btn--sm">View Tour</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════
     BEST TIME TO VISIT
════════════════════════════════════ -->
<section class="cp-months section--parchment" aria-labelledby="months-heading">
  <div class="container">
    <span class="kicker">When to go</span>
    <h2 id="months-heading" class="section-title">Best Time to Visit {country.name}</h2>
    <div class="months-grid">
      {months.map(m => (
        <div class={`month-cell month-cell--${m.rating}`}>
          <span class="month-cell__name">{m.name}</span>
          <div class="month-cell__dots" aria-label={`Rating: ${m.rating} out of 5`}>
            {[1,2,3,4,5].map(i => (
              <span class={`month-dot ${i <= m.rating ? 'month-dot--on' : ''}`}></span>
            ))}
          </div>
          <span class="month-cell__note">{m.note}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════
     TRAVEL ESSENTIALS
════════════════════════════════════ -->
<section class="cp-essentials section" aria-labelledby="essentials-heading">
  <div class="container">
    <span class="kicker">Before you go</span>
    <h2 id="essentials-heading" class="section-title">Travel Essentials</h2>
    <div class="essentials-grid">
      {essentials.map(e => (
        <a href={e.link} class="essential-card">
          <div class="essential-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="var(--color-amber)" aria-hidden="true">
              <path d={e.icon}/>
            </svg>
          </div>
          <h3 class="essential-card__title">{e.title}</h3>
          <p class="essential-card__text">{e.text}</p>
          <span class="essential-card__link">Read guide &rarr;</span>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════
     FAQ
════════════════════════════════════ -->
<section class="cp-faq section--parchment" aria-labelledby="cp-faq-heading">
  <div class="container cp-faq__inner">
    <div class="cp-faq__intro">
      <span class="kicker">Common questions</span>
      <h2 id="cp-faq-heading" class="cp-faq__h2">{country.name} Safari FAQ</h2>
      <p class="cp-faq__sub">Quick answers to the most common questions about visiting {country.name}.</p>
      <a href="/contact/" class="btn btn--primary">Ask Us Anything</a>
    </div>
    <div class="faq-list">
      {faqs.map(item => (
        <details class="faq-item">
          <summary class="faq-item__q">
            <span>{item.q}</span>
            <svg class="faq-item__chevron" width="20" height="20" viewBox="0 0 24 24" fill="none"
              stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <polyline points="6 9 12 15 18 9"/>
            </svg>
          </summary>
          <div class="faq-item__a">{item.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════
     CTA BAND
════════════════════════════════════ -->
<CtaBand
  heading={`Ready to plan your ${country.name} safari?`}
  btn1="Get a Free Quote"
  btn1Href="/contact/"
  btn2="Browse All Tours"
  btn2Href="/tours/"
/>

</BaseLayout>

<style>
/* ── Banner ── */
.cp-banner { position:relative; overflow:hidden; min-height:360px; background:linear-gradient(180deg,#16290f 0%,#2f4d20 40%,#b8561a 82%,#f4b41a 100%); }
.cp-banner__photo { position:absolute; inset:0; background-size:cover; background-position:center 35%; opacity:.22; z-index:0; }
.cp-banner__svg { position:absolute; left:0; bottom:0; width:100%; height:100%; pointer-events:none; z-index:1; }
.cp-banner__overlay { position:absolute; inset:0; background:linear-gradient(90deg,rgba(10,20,8,.85) 0%,rgba(10,20,8,.5) 55%,rgba(10,20,8,0) 88%); z-index:1; }
.cp-banner__content { position:relative; z-index:2; max-width:var(--max-width); margin-inline:auto; padding:72px var(--section-pad-x) 110px; box-sizing:border-box; }
.cp-banner__kicker { font-family:var(--font-display); font-style:italic; font-weight:500; font-size:21px; color:var(--color-gold); margin-bottom:8px; display:block; }
.cp-banner__h1 { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:clamp(36px,5.5vw,64px); line-height:1.05; color:var(--color-white); margin:0 0 14px; }
.cp-banner__sub { font-size:var(--text-lg); color:var(--color-cream); opacity:.9; max-width:520px; line-height:var(--leading-relaxed); }
/* ── Breadcrumb (shared) ── */
.breadcrumb { display:flex; flex-wrap:wrap; align-items:center; gap:6px 8px; font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-cream); margin-bottom:14px; }
.breadcrumb__link { color:var(--color-cream); transition:color var(--transition-fast); text-decoration:none; }
.breadcrumb__link:hover { color:var(--color-gold); }
.breadcrumb__sep { opacity:.4; }
.breadcrumb__cur { color:var(--color-gold); }
/* ── Facts strip ── */
.cp-facts { background:var(--color-forest); }
.cp-facts__inner { display:flex; flex-wrap:wrap; max-width:var(--max-width); margin-inline:auto; }
.cp-fact { flex:1 1 130px; display:flex; flex-direction:column; gap:3px; padding:16px 14px; border-right:1px solid rgba(243,236,216,.15); }
.cp-fact:last-child { border-right:none; }
.cp-fact__label { font-size:var(--text-xs); font-weight:var(--weight-extrabold); letter-spacing:var(--tracking-widest); text-transform:uppercase; color:var(--color-gold); }
.cp-fact__value { font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-cream); line-height:1.4; }
/* ── Intro ── */
.cp-intro { padding-block:var(--section-pad-y); }
.cp-intro__grid { display:grid; grid-template-columns:1fr 300px; gap:48px; align-items:start; }
.cp-intro__h2 { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-5xl); line-height:var(--leading-snug); text-transform:uppercase; color:var(--color-text-primary); margin:8px 0 20px; }
.cp-intro__p { margin-bottom:16px; font-size:var(--text-base); line-height:var(--leading-relaxed); color:var(--color-text-body); }
/* ── Sidebar ── */
.cp-sidebar-card { background:var(--color-white); border-radius:var(--radius-xl); padding:24px; box-shadow:var(--shadow-card); border-top:4px solid var(--color-amber); display:flex; flex-direction:column; gap:12px; position:sticky; top:96px; }
.cp-sidebar-card__head { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-xl); color:var(--color-forest); }
.cp-sidebar-card__note { font-size:var(--text-sm); color:var(--color-text-muted); line-height:1.55; }
.cp-sidebar-wa { display:flex; align-items:center; justify-content:center; gap:8px; background:#25D366; color:#0b2b14; border-radius:var(--radius-lg); padding:10px; font-size:var(--text-sm); font-weight:var(--weight-extrabold); transition:opacity var(--transition-fast); text-decoration:none; }
.cp-sidebar-wa:hover { opacity:.88; }
/* ── Parks grid ── */
.cp-parks { padding-block:var(--section-pad-y); }
.cp-parks-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:28px; }
.park-card { display:flex; flex-direction:column; background:var(--color-white); border-radius:14px; overflow:hidden; box-shadow:var(--shadow-card); text-decoration:none; transition:transform .25s ease, box-shadow .25s ease; }
.park-card:hover { transform:translateY(-5px); box-shadow:0 10px 32px rgba(0,0,0,.12); }
.park-card__img-wrap { position:relative; height:210px; overflow:hidden; }
.park-card__img { position:absolute; inset:0; width:100%; height:100%; object-fit:cover; transition:transform .4s ease; }
.park-card:hover .park-card__img { transform:scale(1.04); }
.park-card__tag { position:absolute; top:12px; left:12px; background:var(--color-amber); color:#fff; font-size:11px; font-weight:var(--weight-bold); letter-spacing:.07em; text-transform:uppercase; padding:3px 10px; border-radius:20px; }
.park-card__body { padding:20px 22px; flex:1; display:flex; flex-direction:column; gap:8px; }
.park-card__name { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:17px; color:var(--color-forest); margin:0; line-height:1.3; }
.park-card__teaser { font-size:14px; line-height:var(--leading-relaxed); color:var(--color-text-body); margin:0; flex:1; }
.park-card__foot { display:flex; align-items:center; justify-content:space-between; padding-top:10px; border-top:1px solid var(--color-card-border); margin-top:auto; }
.park-card__permit { font-size:12px; font-weight:var(--weight-bold); color:#888; }
.park-card__arrow { font-size:13px; font-weight:var(--weight-semibold); color:var(--color-amber); }
/* ── Tours ── */
.cp-tours { padding-block:var(--section-pad-y); }
.cp-tours-grid { display:flex; flex-wrap:wrap; gap:24px; margin-top:28px; }
.tour-card { flex:1 1 240px; background:var(--color-white); border-radius:var(--radius-lg); box-shadow:var(--shadow-card-md); overflow:hidden; display:flex; flex-direction:column; }
.tour-card__img-link { display:block; position:relative; height:180px; overflow:hidden; flex-shrink:0; }
.tour-card__img { width:100%; height:100%; object-fit:cover; transition:transform .4s ease; }
.tour-card:hover .tour-card__img { transform:scale(1.04); }
.tour-card__badge { position:absolute; left:10px; top:10px; }
.tour-card__body { padding:16px; display:flex; flex-direction:column; gap:8px; flex:1; }
.tour-card__title { font-weight:var(--weight-extrabold); font-size:var(--text-base); line-height:var(--leading-normal); color:var(--color-forest); }
.tour-card__title-link { color:inherit; transition:color var(--transition-fast); text-decoration:none; }
.tour-card__title-link:hover { color:var(--color-amber); }
.tour-card__footer { display:flex; justify-content:space-between; align-items:center; border-top:1px solid var(--color-card-border); padding-top:10px; margin-top:auto; }
.tour-card__meta { font-size:13px; font-weight:var(--weight-bold); color:var(--color-text-body); }
/* ── Best time months ── */
.cp-months { padding-block:var(--section-pad-y); }
.months-grid { display:grid; grid-template-columns:repeat(6,1fr); gap:12px; margin-top:28px; }
.month-cell { background:var(--color-white); border-radius:10px; padding:14px 10px; display:flex; flex-direction:column; align-items:center; gap:6px; box-shadow:var(--shadow-card); text-align:center; border-top:3px solid var(--color-card-border); }
.month-cell--5 { border-top-color:#2d6a1f; }
.month-cell--4 { border-top-color:#5a9e2f; }
.month-cell--3 { border-top-color:var(--color-amber); }
.month-cell--2 { border-top-color:#e88020; }
.month-cell--1 { border-top-color:#c0392b; }
.month-cell__name { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:15px; color:var(--color-forest); }
.month-cell__dots { display:flex; gap:3px; }
.month-dot { width:7px; height:7px; border-radius:50%; background:#ddd; }
.month-dot--on { background:var(--color-amber); }
.month-cell__note { font-size:11px; color:var(--color-text-muted); line-height:1.4; }
/* ── Essentials ── */
.cp-essentials { padding-block:var(--section-pad-y); }
.essentials-grid { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; margin-top:28px; }
.essential-card { background:var(--color-white); border-radius:var(--radius-xl); padding:24px; box-shadow:var(--shadow-card); display:flex; flex-direction:column; gap:10px; text-decoration:none; border-bottom:3px solid transparent; transition:border-color .2s ease, transform .2s ease; }
.essential-card:hover { border-bottom-color:var(--color-amber); transform:translateY(-3px); }
.essential-card__icon { width:44px; height:44px; border-radius:var(--radius-lg); background:var(--color-parchment); display:flex; align-items:center; justify-content:center; }
.essential-card__title { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-xl); color:var(--color-forest); }
.essential-card__text { font-size:var(--text-sm); color:var(--color-text-body); line-height:var(--leading-relaxed); flex:1; }
.essential-card__link { font-size:13px; font-weight:var(--weight-semibold); color:var(--color-amber); margin-top:auto; }
/* ── FAQ ── */
.cp-faq { padding-block:var(--section-pad-y); }
