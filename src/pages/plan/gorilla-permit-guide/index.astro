---
import GuidePage from '../../../components/GuidePage.astro';

const guide = {
  title: 'Uganda Gorilla Trekking Permit Guide',
  slug: 'gorilla-permit-guide',
  kicker: 'Everything about the USD 800 permit',
  heroImg: '/images/gorillas/gorilla-amber-eyes-closeup.jpg',
  heroImgAlt: 'Mountain gorilla close-up showing amber eyes in Bwindi Uganda',
  description: 'Complete guide to Uganda gorilla trekking permits: cost, how to book, what is included, low season discounts, gorilla habituation experience and cancellation rules.',
  readTime: '7 min read',
  breadcrumb: 'Gorilla Permit Guide',
  intro: [
    'A Uganda gorilla trekking permit is the single most important booking in your safari. It sets your trek date, determines your gorilla family, and costs USD 800 per person — more than many travellers\' entire monthly budget. This guide explains exactly what you get for that money, how to secure a permit, and how to avoid the most common booking mistakes.',
  ],
};

const sections = [
  {
    heading: 'How Much Does a Gorilla Trekking Permit Cost?',
