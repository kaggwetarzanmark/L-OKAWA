const faqs = [
  { q: 'Is internet access available in Uganda national parks?', a: 'Most lodges at or near national parks have WiFi, though speeds can be slow and reliability varies. Inside the parks during game drives there is typically no connectivity. Many guests deliberately use the safari as an opportunity to disconnect. Download offline maps (Google Maps or Maps.me) before leaving Kampala.' },
  { q: 'What language is spoken in Uganda?', a: 'English is the official language and is widely spoken in tourism, business, education and government. Luganda is the most widely spoken local language in and around Kampala. Dozens of local languages are spoken across the country. You will have no difficulty communicating in English throughout your safari.' },
  { q: 'Can I use my home driving licence in Uganda?', a: 'Yes. An international driving permit (IDP) alongside your home country driving licence is technically required for self-driving, but in practice most car hire companies accept a foreign driving licence. All L\'okawa clients are transported by professional driver-guides, so self-driving is not typically relevant for safari visitors.' },
];

const relatedGuides = [
  { slug: 'is-uganda-safe', title: 'Is Uganda Safe for Tourists?', img: '/images/wildlife/elephant-pair-greeting.jpg', imgAlt: 'Elephants Uganda safari', tag: 'Uganda' },
  { slug: 'uganda-visa', title: 'Uganda Visa Guide', img: '/images/parks/murchison-falls-national-park-gate.jpg', imgAlt: 'Uganda national park', tag: 'Uganda' },
