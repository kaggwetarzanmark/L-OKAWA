/* ── Form card ───────────────────────────────────── */
.ct-form-wrap { background: var(--color-white); border-radius: var(--radius-xl); box-shadow: var(--shadow-card-md); overflow: hidden; }

/* Form header */
.ct-form-head { background: var(--color-parchment); padding: 28px 32px 24px; border-bottom: 1px solid var(--color-card-border); }
