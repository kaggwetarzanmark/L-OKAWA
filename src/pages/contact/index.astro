.ct-banner__h1 { font-family: var(--font-display); font-weight: var(--weight-bold); font-size: clamp(38px, 5vw, 60px); line-height: 1.05; color: var(--color-white); margin: 0 0 12px; }
.ct-banner__sub { font-size: var(--text-lg); color: var(--color-cream); opacity: .9; max-width: 480px; line-height: var(--leading-relaxed); }

/* ── Details strip ───────────────────────────────── */
.ct-strip { background: var(--color-forest); }
.ct-strip__inner { display: flex; flex-wrap: wrap; max-width: var(--max-width); margin-inline: auto; }
