---
import BaseLayout from '../../layouts/BaseLayout.astro';

const contactDetails = [
  { icon: 'M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z', label: 'Phone / WhatsApp', value: '+256 761 512 966', href: 'tel:+256761512966' },
  { icon: 'M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z M22 6l-10 7L2 6', label: 'Email', value: 'lokawatoursandtravelultd@gmail.com', href: 'mailto:lokawatoursandtravelultd@gmail.com' },
  { icon: 'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4', label: 'Address', value: 'Kiwatule, Kampala, Uganda', href: 'https://maps.google.com/?q=Kiwatule+Kampala+Uganda' },
  { icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm.5 5H11v6l5.25 3.15.75-1.23-4.5-2.67V7z', label: 'Office Hours', value: 'Mon to Sat, 8:00 am to 6:00 pm EAT', href: null },
];
---

<BaseLayout
  title="Get a Free Quote | L'okawa Tours & Travel"
  description="Get a free personalised East Africa safari quote from L'okawa Tours. Only your name and contact are required. WhatsApp, call or email us. We respond within 4 hours."
>

<!-- ════════════════════════════════════════════════════
     PAGE BANNER
════════════════════════════════════════════════════ -->
<div class="ct-banner">
  <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" class="ct-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="200" r="100" fill="#ffd45a" opacity=".2"/>
    <circle cx="1130" cy="200" r="65"  fill="#ffd45a"/>
    <path d="M0 240 C220 210 400 236 580 214 C780 190 940 232 1140 212 C1280 198 1370 220 1440 214 L1440 300 L0 300Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 272 C240 252 440 272 660 262 C880 250 1100 274 1440 256 L1440 300 L0 300Z" fill="#0d1a0a"/>
    <g fill="#0d1a0a"><rect x="1246" y="186" width="8" height="80"/><ellipse cx="1250" cy="180" rx="76" ry="20"/><ellipse cx="1200" cy="192" rx="44" ry="12"/><ellipse cx="1300" cy="190" rx="44" ry="12"/></g>
  </svg>
  <div class="ct-banner__overlay" aria-hidden="true"></div>
  <div class="ct-banner__content">
    <div class="ct-banner__breadcrumb">
      <a href="/" class="ct-banner__bc-link">Home</a>
      <span>&nbsp;/&nbsp;</span>
      <span class="ct-banner__bc-cur">Get a Free Quote</span>
    </div>
    <p class="ct-banner__kicker">No obligation. Free in 24 hours.</p>
    <h1 class="ct-banner__h1">Get a Free Safari Quote</h1>
    <p class="ct-banner__sub">Only your name and contact are required. The rest helps us tailor your trip.</p>
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     CONTACT DETAILS STRIP
════════════════════════════════════════════════════ -->
<div class="ct-strip">
  <div class="container ct-strip__inner">
    {contactDetails.map(d => (
      <div class="ct-strip__item">
        <div class="ct-strip__icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={d.icon}/></svg>
        </div>
        <div>
          <div class="ct-strip__label">{d.label}</div>
          {d.href
            ? <a href={d.href} class="ct-strip__value ct-strip__link" target={d.href.startsWith('http') ? '_blank' : undefined} rel={d.href.startsWith('http') ? 'noopener noreferrer' : undefined}>{d.value}</a>
            : <span class="ct-strip__value">{d.value}</span>}
        </div>
      </div>
    ))}
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     MAIN LAYOUT
════════════════════════════════════════════════════ -->
<div class="ct-body">
  <div class="container ct-grid">

    <!-- ══════════════════════════════════════
         FORM CARD
    ════════════════════════════════════════ -->
    <div class="ct-form-wrap">

      <!-- Form header -->
      <div class="ct-form-head">
        <div class="ct-form-head__top">
          <h2 class="ct-form-head__title">Get a Free Safari Quote</h2>
          <!-- WhatsApp quick-link beside heading -->
          <a href="https://wa.me/256761512966" target="_blank" rel="noopener noreferrer" class="ct-head-wa" aria-label="Chat on WhatsApp">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
            Chat on WhatsApp
          </a>
        </div>
        <!-- Progress indicator -->
        <div class="ct-progress" role="progressbar" aria-valuenow="1" aria-valuemin="1" aria-valuemax="2" aria-label="Step 1 of 2">
          <div class="ct-progress__steps">
            <div class="ct-progress__step ct-progress__step--active" id="prog-step-1">
              <span class="ct-progress__dot"></span>
              <span class="ct-progress__lbl">Your details</span>
            </div>
            <div class="ct-progress__line"></div>
            <div class="ct-progress__step" id="prog-step-2">
              <span class="ct-progress__dot"></span>
              <span class="ct-progress__lbl">Trip details</span>
            </div>
          </div>
          <span class="ct-progress__text" id="prog-text">Step 1 of 2</span>
        </div>
      </div>

      <!-- ─────────────────────────────
           THE FORM
      ───────────────────────────── -->
      <form
        id="quote-form"
        class="ct-form"
        action="https://api.web3forms.com/submit"
        method="POST"
        novalidate
      >
        <!-- Web3Forms access key — replace YOUR_WEB3FORMS_KEY with your key from web3forms.com -->
        <input type="hidden" name="access_key" value="YOUR_WEB3FORMS_KEY" />
        <input type="hidden" name="subject"    value="New Safari Quote Request from L'okawa Website" />
        <input type="hidden" name="from_name"  value="L'okawa Website" />
        <input type="hidden" name="redirect"   value="false" />

        <!-- Honeypot spam field -->
        <input type="text" name="bot_field" style="display:none" tabindex="-1" autocomplete="off" />

        <!-- Hidden: time-to-submit guard -->
        <input type="hidden" name="_loaded_at" id="loaded_at" />

        <!-- Hidden: collected chip values passed as single fields -->
        <input type="hidden" name="contact_method"  id="hid-contact-method"  value="email" />
        <input type="hidden" name="travelers"        id="hid-travelers"        value="" />
        <input type="hidden" name="interests"        id="hid-interests"        value="" />
        <input type="hidden" name="trip_duration"    id="hid-duration"         value="" />
        <input type="hidden" name="budget"           id="hid-budget"           value="Let us suggest" />
        <input type="hidden" name="month_of_travel"  id="hid-month"            value="" />
        <input type="hidden" name="country"          id="hid-country"          value="" />

        <!-- ══════════════════
             STEP 1
        ═════════════════════ -->
        <fieldset class="ct-step" id="step-1" aria-label="Step 1: Your details">

          <!-- Name -->
          <div class="form-group">
            <label for="full-name" class="form-label">
              Your name
              <span class="form-req" aria-hidden="true">*</span>
            </label>
            <input
              type="text"
              id="full-name"
              name="name"
              class="form-input"
              autocomplete="name"
              required
              placeholder="e.g. Sarah Johnson"
              aria-describedby="name-err"
            />
            <span id="name-err" class="form-err" role="alert" aria-live="polite"></span>
          </div>

          <!-- Contact method chips -->
          <div class="form-group">
            <label class="form-label">
              How should we reply?
              <span class="form-req" aria-hidden="true">*</span>
            </label>
            <div class="chip-row" role="radiogroup" aria-label="Preferred contact method" id="contact-method-group">
              <label class="chip chip--radio">
                <input type="radio" name="_contact_method_ui" value="email" class="chip__radio" checked />
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
                Email
              </label>
              <label class="chip chip--radio">
                <input type="radio" name="_contact_method_ui" value="whatsapp" class="chip__radio" />
                <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
                WhatsApp
              </label>
              <label class="chip chip--radio">
                <input type="radio" name="_contact_method_ui" value="phone" class="chip__radio" />
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 13a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 2h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
                Phone call
              </label>
            </div>

            <!-- Email input (shown by default) -->
            <div id="input-email" class="contact-input-wrap">
              <input
                type="email"
                id="contact-email"
                name="email"
                class="form-input"
                autocomplete="email"
                placeholder="you@email.com"
                aria-label="Email address"
                aria-describedby="contact-err"
              />
            </div>

            <!-- Tel input (shown for WhatsApp / Phone) -->
            <div id="input-tel" class="contact-input-wrap contact-input-wrap--hidden">
              <div class="tel-wrap">
                <select id="country-code" name="country_code" class="form-input tel-code" aria-label="Country code">
                  <option value="+256">🇺🇬 +256</option>
                  <option value="+254">🇰🇪 +254</option>
                  <option value="+255">🇹🇿 +255</option>
                  <option value="+250">🇷🇼 +250</option>
                  <option value="+1">🇺🇸 +1</option>
                  <option value="+44">🇬🇧 +44</option>
                  <option value="+61">🇦🇺 +61</option>
                  <option value="+49">🇩🇪 +49</option>
                  <option value="+33">🇫🇷 +33</option>
                  <option value="+31">🇳🇱 +31</option>
                  <option value="+27">🇿🇦 +27</option>
                  <option value="+91">🇮🇳 +91</option>
                  <option value="+971">🇦🇪 +971</option>
                  <option value="+55">🇧🇷 +55</option>
                  <option value="+other">Other</option>
                </select>
                <input
                  type="tel"
                  id="contact-tel"
                  name="phone"
                  class="form-input tel-number"
                  inputmode="tel"
                  autocomplete="tel"
                  placeholder="712 345 678"
                  aria-label="Phone number"
                  aria-describedby="contact-err"
                />
              </div>
            </div>
            <span id="contact-err" class="form-err" role="alert" aria-live="polite"></span>
          </div>

          <!-- Travelers -->
          <div class="form-group">
            <label class="form-label">Number of travelers</label>
            <div class="chip-row" role="group" aria-label="Number of travelers">
              {['Solo', '2', '3-4', '5-8', '9+'].map(v => (
                <label class="chip chip--toggle">
                  <input type="checkbox" name="_travelers_ui" value={v} class="chip__check chip--single" data-group="travelers" />
                  {v}
                </label>
              ))}
            </div>
          </div>

          <!-- Interests -->
          <div class="form-group">
            <label class="form-label">Interested in <span class="form-hint">(pick all that apply)</span></label>
            <div class="chip-row chip-row--wrap" role="group" aria-label="Safari interests">
              {[
                ['🦍','Gorilla trekking'],
                ['🐘','Safari'],
                ['🏨','Hotels'],
                ['✈️','Airport transfer'],
                ['👥','Group travel'],
              ].map(([emoji, label]) => (
                <label class="chip chip--toggle">
                  <input type="checkbox" name="_interests_ui" value={label} class="chip__check" data-group="interests" />
                  <span aria-hidden="true">{emoji}</span> {label}
                </label>
              ))}
            </div>
          </div>

          <button type="button" id="btn-continue" class="btn ct-form__cta">
            Continue
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
          </button>

        </fieldset>

        <!-- ══════════════════
             STEP 2
        ═════════════════════ -->
        <fieldset class="ct-step ct-step--hidden" id="step-2" aria-label="Step 2: Trip details (all optional)">

          <p class="step2-optional-note">All fields on this step are optional.</p>

          <!-- Month of travel -->
          <div class="form-group">
            <label for="travel-month" class="form-label">Month of travel</label>
            <input
              type="month"
              id="travel-month"
              name="_month_ui"
              class="form-input"
              min=""
              aria-label="Month of travel"
            />
          </div>

          <!-- Trip duration chips -->
          <div class="form-group">
            <label class="form-label">Trip duration</label>
            <div class="chip-row chip-row--wrap" role="group" aria-label="Trip duration">
              {['1-3 days','4-7 days','8-14 days','15+ days','Not sure yet'].map(v => (
                <label class="chip chip--toggle">
                  <input type="checkbox" name="_duration_ui" value={v} class="chip__check chip--single" data-group="duration" />
                  {v}
                </label>
              ))}
            </div>
          </div>

          <!-- Budget chips -->
          <div class="form-group">
            <label class="form-label">Budget per person (USD)</label>
            <div class="chip-row chip-row--wrap" role="group" aria-label="Budget per person">
              {['Under $1,000','$1,000-2,000','$2,000-3,500','$3,500-5,000','$5,000+','Let us suggest'].map(v => (
                <label class="chip chip--toggle">
                  <input type="checkbox" name="_budget_ui" value={v} class={`chip__check chip--single${v === 'Let us suggest' ? ' chip--preselected' : ''}`} data-group="budget" data-default={v === 'Let us suggest' ? 'true' : undefined} />
                  {v}
                </label>
              ))}
            </div>
          </div>

          <!-- Country searchable dropdown -->
          <div class="form-group">
            <label for="visitor-country" class="form-label">Your country <span class="form-hint">(auto-detected, change if needed)</span></label>
            <select id="visitor-country" name="_country_ui" class="form-input form-select" aria-label="Country of residence">
              <option value="">Loading...</option>
            </select>
          </div>

          <!-- Notes (hidden behind link) -->
          <div class="form-group">
            <button type="button" id="btn-show-notes" class="notes-toggle">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
              Add a note (optional)
            </button>
            <div id="notes-wrap" class="notes-wrap notes-wrap--hidden">
              <!-- Quick-tap chips that append text -->
              <div class="chip-row chip-row--wrap chip-row--sm" role="group" aria-label="Note quick-chips">
                {['Honeymoon','Family with kids','Photography','Birdwatching','Wheelchair accessible','First time in Africa','Need visa help'].map(v => (
                  <button type="button" class="chip chip--append" data-append={v}>{v}</button>
                ))}
              </div>
              <div class="notes-field-wrap">
                <textarea
                  id="notes"
                  name="notes"
                  class="form-input form-textarea"
                  rows="2"
                  maxlength="300"
                  placeholder="e.g. Celebrating our 10th anniversary, love wildlife photography"
                  aria-describedby="notes-counter notes-hint"
                ></textarea>
                <div class="notes-meta">
                  <span id="notes-hint" class="form-hint">Short is fine. We will ask follow-up questions.</span>
                  <span id="notes-counter" class="notes-counter" aria-live="polite">300</span>
                </div>
              </div>
            </div>
          </div>

          <!-- Step 2 buttons -->
          <div class="step2-btns">
            <button type="button" id="btn-back" class="btn btn--ghost">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 18l-6-6 6-6"/></svg>
              Back
            </button>
            <div class="step2-primary-btns">
              <button type="submit" id="btn-skip" class="btn btn--ghost-sm">
                Skip and send
              </button>
              <button type="submit" id="btn-submit" class="btn ct-form__cta">
                Get my free safari quote
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </button>
            </div>
          </div>
          <p class="submit-note">Reply in under 4 hours (Mon-Sat). No obligation.</p>

        </fieldset>

        <!-- ══════════════════
             THANK-YOU STATE
        ═════════════════════ -->
        <div class="ct-thankyou ct-step--hidden" id="thankyou" aria-live="polite">
          <div class="thankyou__icon" aria-hidden="true">
            <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
          </div>
          <h3 class="thankyou__heading">Quote request sent!</h3>
          <p class="thankyou__msg" id="thankyou-msg">We will get back to you within 4 hours (Mon-Sat, 8am-6pm EAT).</p>

          <!-- Source question (after submit) -->
          <div class="thankyou__source">
            <p class="thankyou__source-q">One quick question: how did you hear about us?</p>
            <div class="chip-row chip-row--wrap chip-row--center" id="source-chips">
              {['Google search','Instagram','Facebook','Friend or family','Travel blog','TripAdvisor','Other'].map(v => (
                <button type="button" class="chip chip--source" data-source={v}>{v}</button>
              ))}
            </div>
            <p class="thankyou__source-thanks ct-step--hidden" id="source-thanks">Thanks! Enjoy your safari planning.</p>
          </div>
        </div>

      </form>

      <!-- Alternative contact routes -->
      <div class="ct-alt-routes">
        <p class="ct-alt-routes__label">Or reach us directly</p>
        <div class="ct-alt-routes__btns">
          <a href="https://wa.me/256761512966?text=Hi+L%27okawa%2C+I+am+interested+in+a+safari+quote." target="_blank" rel="noopener noreferrer" id="wa-prefill" class="ct-alt-btn ct-alt-btn--wa">
