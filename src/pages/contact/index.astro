  .ct-banner__content { padding: 48px 24px 68px; }
  .ct-strip__item { border-right: none; border-bottom: 1px solid rgba(243,236,216,.15); }
  .ct-cta-band__inner { padding: 40px 24px; }
  .step2-btns { flex-direction: column; align-items: stretch; }
  .step2-primary-btns { flex-direction: column; }
  .ct-form__cta { justify-content: center; }
}
</style>

<!-- ════════════════════════════════════════════════════
     JAVASCRIPT
════════════════════════════════════════════════════ -->
<script>
(function () {
  // ── record load time for spam guard ──────────────────
  const loadedAt = document.getElementById('loaded_at');
  if (loadedAt) loadedAt.value = Date.now().toString();

  // ── elements ─────────────────────────────────────────
  const step1       = document.getElementById('step-1');
  const step2       = document.getElementById('step-2');
  const thankyou    = document.getElementById('thankyou');
  const btnContinue = document.getElementById('btn-continue');
  const btnBack     = document.getElementById('btn-back');
  const form        = document.getElementById('quote-form');

  // progress
  const progText  = document.getElementById('prog-text');
  const progStep1 = document.getElementById('prog-step-1');
  const progStep2 = document.getElementById('prog-step-2');

  // hidden value fields
  const hidMethod   = document.getElementById('hid-contact-method');
  const hidTravelers= document.getElementById('hid-travelers');
  const hidInterests= document.getElementById('hid-interests');
  const hidDuration = document.getElementById('hid-duration');
  const hidBudget   = document.getElementById('hid-budget');
  const hidMonth    = document.getElementById('hid-month');
  const hidCountry  = document.getElementById('hid-country');

  // contact method
  const radioGroup  = document.getElementById('contact-method-group');
  const inputEmail  = document.getElementById('input-email');
  const inputTel    = document.getElementById('input-tel');
  const emailInput  = document.getElementById('contact-email');
  const telInput    = document.getElementById('contact-tel');

  // ── Geo-detect country & smart contact default ────────
  const whatsappCountries = ['UG','KE','TZ','RW','NG','GH','ZA','ET','CM','CI',
    'AE','SA','QA','KW','IN','PK','BD','ID','PH','NG','MX','BR','CO','AR','PE'];

  async function detectGeo() {
    try {
      const r = await fetch('https://ipapi.co/json/', { signal: AbortSignal.timeout(3000) });
      const d = await r.json();
      const cc = d.country_code || '';

      // smart default: WhatsApp for certain regions
      if (whatsappCountries.includes(cc)) {
        const waRadio = document.querySelector('input[value="whatsapp"]');
        if (waRadio) { waRadio.checked = true; waRadio.dispatchEvent(new Event('change', { bubbles: true })); }
      }

      // pre-select country picker
      populateCountries(cc);
    } catch {
      populateCountries('');
    }
  }

  function populateCountries(selected) {
    const sel = document.getElementById('visitor-country');
    if (!sel) return;
    // Minimal country list — common safari travelers + all EA
    const countries = [
      ['AF','Afghanistan'],['AL','Albania'],['DZ','Algeria'],['AR','Argentina'],['AU','Australia'],
      ['AT','Austria'],['BE','Belgium'],['BR','Brazil'],['CA','Canada'],['CN','China'],
      ['CO','Colombia'],['HR','Croatia'],['CY','Cyprus'],['CZ','Czech Republic'],['DK','Denmark'],
      ['EG','Egypt'],['ET','Ethiopia'],['FI','Finland'],['FR','France'],['DE','Germany'],
      ['GH','Ghana'],['GR','Greece'],['HU','Hungary'],['IN','India'],['ID','Indonesia'],
      ['IE','Ireland'],['IL','Israel'],['IT','Italy'],['JP','Japan'],['JO','Jordan'],
      ['KE','Kenya'],['KW','Kuwait'],['LB','Lebanon'],['MY','Malaysia'],['MX','Mexico'],
      ['NL','Netherlands'],['NZ','New Zealand'],['NG','Nigeria'],['NO','Norway'],['OM','Oman'],
      ['PK','Pakistan'],['PE','Peru'],['PH','Philippines'],['PL','Poland'],['PT','Portugal'],
      ['QA','Qatar'],['RO','Romania'],['RU','Russia'],['SA','Saudi Arabia'],['ZA','South Africa'],
      ['ES','Spain'],['SE','Sweden'],['CH','Switzerland'],['TZ','Tanzania'],['TH','Thailand'],
      ['UG','Uganda'],['AE','UAE'],['GB','United Kingdom'],['US','United States'],['RW','Rwanda'],
      ['VN','Vietnam'],['ZM','Zambia'],['ZW','Zimbabwe'],['Other','Other'],
    ];
    sel.innerHTML = '<option value="">Select your country</option>' +
      countries.map(([code, name]) =>
        `<option value="${name}"${code === selected ? ' selected' : ''}>${name}</option>`
      ).join('');
    if (hidCountry && selected) {
      const match = countries.find(([c]) => c === selected);
      if (match) hidCountry.value = match[1];
    }
    sel.addEventListener('change', () => { if (hidCountry) hidCountry.value = sel.value; });
  }

  detectGeo();

  // ── Contact method toggle ─────────────────────────────
  function syncContactMethod() {
    const checked = radioGroup && radioGroup.querySelector('.chip__radio:checked');
    if (!checked) return;
    const val = checked.value;
    if (hidMethod) hidMethod.value = val;
    inputEmail.classList.toggle('contact-input-wrap--hidden', val !== 'email');
    inputTel.classList.toggle('contact-input-wrap--hidden', val === 'email');
    // toggle required
    if (emailInput) emailInput.required = val === 'email';
    if (telInput)   telInput.required   = val !== 'email';
  }

  if (radioGroup) {
    radioGroup.addEventListener('change', syncContactMethod);
    syncContactMethod(); // init
  }

  // ── Single-select chip groups ─────────────────────────
  document.querySelectorAll('.chip--single').forEach(input => {
    input.addEventListener('change', function () {
      const group = this.dataset.group;
      document.querySelectorAll(`.chip--single[data-group="${group}"]`).forEach(c => {
        if (c !== this) c.checked = false;
      });
      syncHiddenFields();
    });
  });

  // Pre-select "Let us suggest" on budget
  const budgetDefault = document.querySelector('.chip--preselected');
  if (budgetDefault) { budgetDefault.checked = true; if (hidBudget) hidBudget.value = budgetDefault.value; }

  // Multi-select chips
  document.querySelectorAll('.chip__check:not(.chip--single)').forEach(input => {
    input.addEventListener('change', syncHiddenFields);
  });

  function syncHiddenFields() {
    if (hidTravelers) hidTravelers.value = [...document.querySelectorAll('.chip--single[data-group="travelers"]:checked')].map(c=>c.value).join('') || '';
    if (hidInterests) hidInterests.value = [...document.querySelectorAll('.chip__check[data-group="interests"]:checked')].map(c=>c.value).join(', ') || '';
    if (hidDuration)  hidDuration.value  = [...document.querySelectorAll('.chip--single[data-group="duration"]:checked')].map(c=>c.value).join('') || '';
    if (hidBudget)    hidBudget.value    = [...document.querySelectorAll('.chip--single[data-group="budget"]:checked')].map(c=>c.value).join('') || 'Let us suggest';
  }

  // ── Month picker sync ─────────────────────────────────
  const monthInput = document.getElementById('travel-month');
  if (monthInput) {
    // set min to current month
    const now = new Date();
    monthInput.min = `${now.getFullYear()}-${String(now.getMonth()+1).padStart(2,'0')}`;
    monthInput.addEventListener('change', () => {
      if (hidMonth) hidMonth.value = monthInput.value;
    });
  }

  // ── Step navigation ───────────────────────────────────
  function validateStep1() {
    let ok = true;
    const nameInput = document.getElementById('full-name');
    const nameErr   = document.getElementById('name-err');
    const contactErr = document.getElementById('contact-err');
    const method = hidMethod ? hidMethod.value : 'email';

    // Name
    if (!nameInput || !nameInput.value.trim()) {
      if (nameErr) nameErr.textContent = 'Please enter your name.';
      if (nameInput) nameInput.classList.add('is-invalid');
      ok = false;
    } else {
      if (nameErr) nameErr.textContent = '';
      if (nameInput) nameInput.classList.remove('is-invalid');
    }

    // Contact
    if (method === 'email') {
      if (!emailInput || !emailInput.value.trim() || !emailInput.value.includes('@')) {
        if (contactErr) contactErr.textContent = 'Please enter a valid email address.';
        if (emailInput) emailInput.classList.add('is-invalid');
        ok = false;
      } else {
        if (contactErr) contactErr.textContent = '';
        if (emailInput) emailInput.classList.remove('is-invalid');
      }
    } else {
      if (!telInput || !telInput.value.trim()) {
        if (contactErr) contactErr.textContent = 'Please enter your phone number.';
        if (telInput) telInput.classList.add('is-invalid');
        ok = false;
      } else {
        if (contactErr) contactErr.textContent = '';
        if (telInput) telInput.classList.remove('is-invalid');
      }
    }
    return ok;
  }

  if (btnContinue) {
    btnContinue.addEventListener('click', () => {
      if (!validateStep1()) return;
      syncHiddenFields();
      step1.classList.add('ct-step--hidden');
      step2.classList.remove('ct-step--hidden');
      // progress
      if (progText)  progText.textContent = 'Step 2 of 2';
      if (progStep1) { progStep1.classList.remove('ct-progress__step--active'); progStep1.classList.add('ct-progress__step--done'); }
      if (progStep2) progStep2.classList.add('ct-progress__step--active');
      // scroll to top of form
      document.getElementById('quote-form').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });
  }

  if (btnBack) {
    btnBack.addEventListener('click', () => {
      step2.classList.add('ct-step--hidden');
      step1.classList.remove('ct-step--hidden');
      if (progText)  progText.textContent = 'Step 1 of 2';
      if (progStep1) { progStep1.classList.add('ct-progress__step--active'); progStep1.classList.remove('ct-progress__step--done'); }
      if (progStep2) progStep2.classList.remove('ct-progress__step--active');
    });
  }

  // ── Notes toggle ──────────────────────────────────────
  const btnShowNotes = document.getElementById('btn-show-notes');
  const notesWrap    = document.getElementById('notes-wrap');
  if (btnShowNotes && notesWrap) {
    btnShowNotes.addEventListener('click', () => {
      notesWrap.classList.toggle('notes-wrap--hidden');
      btnShowNotes.innerHTML = notesWrap.classList.contains('notes-wrap--hidden')
        ? '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg> Add a note (optional)'
        : '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg> Hide note';
    });
  }

  // ── Append chips ──────────────────────────────────────
  const textarea = document.getElementById('notes');
  document.querySelectorAll('.chip--append').forEach(btn => {
    btn.addEventListener('click', () => {
      if (!textarea) return;
      const add = btn.dataset.append;
      const cur = textarea.value.trim();
      textarea.value = cur ? cur + ', ' + add : add;
      textarea.dispatchEvent(new Event('input'));
    });
  });

  // ── Notes counter ─────────────────────────────────────
  const notesCounter = document.getElementById('notes-counter');
  if (textarea && notesCounter) {
    textarea.addEventListener('input', () => {
      const left = 300 - textarea.value.length;
      notesCounter.textContent = left.toString();
      notesCounter.style.color = left < 30 ? '#c0392b' : '';
    });
  }

  // ── Form submission ───────────────────────────────────
  if (form) {
    form.addEventListener('submit', async function (e) {
      e.preventDefault();

      // Spam: minimum time (2 seconds)
      const loaded = parseInt(document.getElementById('loaded_at')?.value || '0');
      if (Date.now() - loaded < 2000) return;

      // Honeypot
      const bot = form.querySelector('[name="bot_field"]');
      if (bot && bot.value) return;

      syncHiddenFields();

      // Build WhatsApp / mailto prefills from current state
      updateAltRoutes();

      const data = new FormData(form);
      const submitBtn = document.getElementById('btn-submit');
      const skipBtn   = document.getElementById('btn-skip');
      if (submitBtn) { submitBtn.disabled = true; submitBtn.textContent = 'Sending...'; }
      if (skipBtn)   skipBtn.disabled = true;

      try {
        const res = await fetch('https://api.web3forms.com/submit', { method: 'POST', body: data });
        const json = await res.json();

        // Show thank-you regardless (fail gracefully if key not set)
        step2.classList.add('ct-step--hidden');
        thankyou.classList.remove('ct-step--hidden');

        // Personalise thank-you message
        const method = hidMethod ? hidMethod.value : 'email';
        const msgEl  = document.getElementById('thankyou-msg');
        if (msgEl) {
          msgEl.textContent = method === 'email'
            ? 'We will email you within 4 hours (Mon-Sat, 8am-6pm EAT).'
            : method === 'whatsapp'
            ? 'We will message you on WhatsApp within 4 hours (Mon-Sat, 8am-6pm EAT).'
            : 'We will call you back within 4 hours (Mon-Sat, 8am-6pm EAT).';
        }
      } catch {
        // On network error, show thank-you anyway (data already sent or fail-silent)
        step2.classList.add('ct-step--hidden');
        thankyou.classList.remove('ct-step--hidden');
      }
    });
  }

  // ── Source chips (thank-you) ──────────────────────────
  document.querySelectorAll('.chip--source').forEach(btn => {
    btn.addEventListener('click', async function () {
      document.querySelectorAll('.chip--source').forEach(c => c.classList.remove('is-selected'));
      this.classList.add('is-selected');
      const thanks = document.getElementById('source-thanks');
      if (thanks) thanks.classList.remove('ct-step--hidden');
      // send source as follow-up (fire and forget)
      try {
        const fd = new FormData();
        fd.append('access_key', document.querySelector('[name="access_key"]')?.value || '');
        fd.append('subject', 'Safari Quote — Source Tracking');
        fd.append('from_name', 'L\'okawa Website');
        fd.append('name', document.getElementById('full-name')?.value || 'Anonymous');
        fd.append('source', this.dataset.source);
        await fetch('https://api.web3forms.com/submit', { method: 'POST', body: fd });
      } catch {}
    });
  });

  // ── Build alt-route links from chips ──────────────────
  function buildSummary() {
    const name      = document.getElementById('full-name')?.value || '';
    const interests = [...document.querySelectorAll('.chip__check[data-group="interests"]:checked')].map(c=>c.value).join(', ') || 'a safari';
    const travelers = [...document.querySelectorAll('.chip--single[data-group="travelers"]:checked')].map(c=>c.value).join('') || '';
    const budget    = [...document.querySelectorAll('.chip--single[data-group="budget"]:checked')].map(c=>c.value).join('') || '';
    const month     = document.getElementById('travel-month')?.value
                        ? new Date(document.getElementById('travel-month').value + '-01').toLocaleString('default',{month:'long',year:'numeric'})
                        : '';

    let body = `Hi L'okawa, I'm ${name || 'interested in a safari'}.\n`;
    if (interests) body += `I'm interested in: ${interests}.\n`;
    if (travelers) body += `Travelers: ${travelers}.\n`;
    if (month)     body += `Month of travel: ${month}.\n`;
    if (budget)    body += `Budget per person: ${budget}.\n`;
    body += '\nPlease send me a free quote. Thank you.';
    return body;
  }

  function updateAltRoutes() {
    const summary  = buildSummary();
    const encoded  = encodeURIComponent(summary);
    const waBtn    = document.getElementById('wa-prefill');
    const mailBtn  = document.getElementById('mailto-prefill');
    if (waBtn)   waBtn.href   = `https://wa.me/256761512966?text=${encoded}`;
    if (mailBtn) mailBtn.href = `mailto:lokawatoursandtravelultd@gmail.com?subject=${encodeURIComponent("Safari Quote Request")}&body=${encoded}`;
  }

  // Update alt routes whenever chips change
  document.querySelectorAll('.chip__radio,.chip__check,.chip--append').forEach(el => {
    el.addEventListener('change', updateAltRoutes);
    el.addEventListener('click',  updateAltRoutes);
  });
  document.getElementById('travel-month')?.addEventListener('change', updateAltRoutes);
  updateAltRoutes(); // init

})();
</script>
