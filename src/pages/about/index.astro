---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand from '../../components/CtaBand.astro';

const stats = [
  { value: '4+',    label: 'Years of Experience' },
  { value: '500+',  label: 'Happy Travelers' },
  { value: '4',     label: 'Countries Covered' },
  { value: '32+',   label: 'Tours to Choose From' },
];

const values = [
  {
    kicker: 'Our mission',
    title:  'Easy, honest, unforgettable safaris',
    text:   'To make East African travel simple and fairly priced for every guest. From a 3-day gorilla trek to a 21-day grand circuit, we build every journey around your budget, your pace and the wildlife you most want to see.',
    icon:   'M12 21s-7-6.2-7-11a7 7 0 0 1 14 0c0 4.8-7 11-7 11zM12 7.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z',
  },
  {
    kicker: 'Our vision',
    title:  'The travel company people trust first',
    text:   'To be the first name travelers think of for wildlife and culture in East Africa, known for honest prices, experienced guides, and experiences that stay with people long after they go home.',
    icon:   'M2 12s4-7 10-7 10 7 10 7-4 7-10 7S2 12 2 12zM12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z',
  },
  {
    kicker: 'Our promise',
    title:  'Clear plans and a real person to talk to',
    text:   'Fair prices, transparent itineraries and quick answers to every message. When you book with L\'okawa you deal with people, not platforms, someone who has personally tracked the gorillas, knows the lodges and is reachable on WhatsApp throughout your trip.',
    icon:   'M12 3l2.6 5.6 6 .7-4.4 4.1 1.2 6L12 16.6 6.6 19.4l1.2-6L3.4 9.3l6-.7z',
  },
];

const services = [
  { num: '01', name: 'Tour Packages',       text: 'Ready-made and custom multi-day itineraries across Uganda, Kenya, Tanzania and Rwanda.',                icon: 'M4 8h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1zM9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2' },
  { num: '02', name: 'Safari Adventures',   text: 'Gorilla trekking, chimp tracking, game drives, Nile boat cruises and birding with expert guides.',       icon: 'M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1zM12 10.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z' },
  { num: '03', name: 'Hotel Bookings',       text: 'Budget camps, mid-range lodges and luxury tented camps, all personally vetted and matched to your trip.', icon: 'M5 3h14v18H5zM9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2M11 21v-3h2v3' },
  { num: '04', name: 'Airport Transfers',    text: 'Reliable, comfortable pick-ups and drop-offs at Entebbe, Nairobi, Kilimanjaro and Kigali airports.',     icon: 'M21 3L10 14M21 3l-7 18-4-7-7-4 18-7z' },
  { num: '05', name: 'Group Travel & More',  text: 'Family holidays, corporate retreats, school expeditions and special-occasion tours, any group, any size.', icon: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M17 10a2.5 2.5 0 1 0 0-5M17 14c2.5 0 4.5 2 4.5 5' },
];

const fleet = [
  { text: 'Private 4x4 Land Cruisers with roof hatches for game viewing' },
  { text: 'Experienced, licensed English-speaking driver-guides' },
  { text: 'Clean, well-maintained vehicles serviced before every tour' },
  { text: 'Bottled drinking water, first-aid kit and emergency contacts on board' },
];

const mosaicImages = [
  { src: '/images/gorillas/gorilla-mother-infant-closeup.jpg', alt: 'Mountain gorilla mother with infant in Bwindi Impenetrable Forest Uganda', height: 250, top: false },
  { src: '/images/wildlife/elephants-crossing-water.jpg',      alt: 'Elephants crossing river on Uganda safari',                                   height: 170, top: false },
  { src: '/images/wildlife/cheetah-mother-cub.jpg',            alt: 'Cheetah mother and cub on Kenya safari Masai Mara',                          height: 170, top: true  },
  { src: '/images/wildlife/lion-on-rock-kidepo.jpg',       alt: 'Male lion on rock at sunset Kidepo Valley National Park Uganda',             height: 250, top: true  },
];
---

<BaseLayout
  title="About L'okawa Tours & Travel | Local Uganda Safari Experts Since 2021"
  description="L'okawa Tours and Travel is a Uganda-based safari company founded in 2021. Gorilla trekking, wildlife safaris and multi-country tours across Uganda, Kenya, Tanzania and Rwanda."
>

<!-- ════════════════════════════════════════════════════
     PAGE BANNER
════════════════════════════════════════════════════ -->
<div class="about-banner">
  <svg viewBox="0 0 1440 340" preserveAspectRatio="xMidYMax slice" class="about-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="230" r="110" fill="#ffd45a" opacity=".2"/>
    <circle cx="1130" cy="230" r="72"  fill="#ffd45a"/>
    <path d="M0 270 C220 240 400 266 580 244 C780 220 940 262 1140 242 C1280 228 1370 250 1440 244 L1440 340 L0 340Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 304 C240 282 440 304 660 292 C880 280 1100 306 1440 286 L1440 340 L0 340Z" fill="#0d1a0a"/>
    <g fill="#0d1a0a">
      <rect x="1246" y="206" width="9" height="90"/>
      <ellipse cx="1250" cy="200" rx="86" ry="22"/>
      <ellipse cx="1196" cy="214" rx="50" ry="14"/>
      <ellipse cx="1306" cy="212" rx="50" ry="14"/>
    </g>
  </svg>
  <div class="about-banner__overlay" aria-hidden="true"></div>
  <div class="about-banner__content">
    <div class="about-banner__breadcrumb">
      <a href="/" class="about-banner__breadcrumb-link">Home</a>
      <span>&nbsp;/&nbsp;</span>
      <span class="about-banner__breadcrumb-current">About Us</span>
    </div>
    <p class="about-banner__kicker">Where Nature Meets Attraction</p>
    <h1 class="about-banner__h1">About Us</h1>
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     OUR STORY
════════════════════════════════════════════════════ -->
<section class="about-story">
  <div class="container about-story__grid">

    <!-- Text -->
    <div class="about-story__text">
      <p class="about-story__kicker">Our story</p>
      <h2 class="about-story__heading">
        Who is <span class="about-story__brand">L'OKAWA</span>
      </h2>
      <p class="about-story__body">
        L'okawa Tours and Travel (U) Ltd is a Uganda-based travel company founded in 2021. We plan tour packages, safari adventures, hotel bookings, airport transfers and group trips across Uganda, Kenya, Rwanda and Tanzania.
      </p>
      <p class="about-story__body">
        Every journey is built around your pace, your budget and the wildlife you most want to see, and looked after by people who grew up on these roads.
      </p>
      <p class="about-story__body">
        Based in Kiwatule, Kampala, we are a small, passionate team who have personally tracked gorillas in Bwindi, watched tree-climbing lions at Ishasha, and cruised the Kazinga Channel at golden hour. When you travel with us, you travel with people who genuinely love this corner of the world.
      </p>
      <a href="/contact/" class="btn btn--secondary btn--lg">Request Quotation</a>
    </div>

    <!-- Staggered mosaic -->
    <div class="about-story__mosaic" aria-hidden="true">
      <div class="about-story__col about-story__col--a">
        <img src={mosaicImages[0].src} alt={mosaicImages[0].alt} class="about-story__img" style={`height:${mosaicImages[0].height}px`} loading="lazy"/>
        <img src={mosaicImages[1].src} alt={mosaicImages[1].alt} class="about-story__img" style={`height:${mosaicImages[1].height}px`} loading="lazy"/>
      </div>
      <div class="about-story__col about-story__col--b">
        <img src={mosaicImages[2].src} alt={mosaicImages[2].alt} class="about-story__img" style={`height:${mosaicImages[2].height}px`} loading="lazy"/>
        <img src={mosaicImages[3].src} alt={mosaicImages[3].alt} class="about-story__img" style={`height:${mosaicImages[3].height}px`} loading="lazy"/>
      </div>
    </div>

  </div>
</section>

<!-- ════════════════════════════════════════════════════
     STATS BAND
════════════════════════════════════════════════════ -->
<div class="stats-band" aria-label="L'okawa at a glance">
  <div class="stats-band__inner">
    {stats.map((s) => (
      <div class="stats-band__item">
        <div class="stats-band__value">{s.value}</div>
        <div class="stats-band__label">{s.label}</div>
      </div>
    ))}
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     MISSION & VALUES
════════════════════════════════════════════════════ -->
<section class="about-values">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">What guides us</span>
      <h2>Our Mission and Values</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="values-row">
      {values.map((v) => (
        <div class="value-card">
          <span class="value-card__icon-wrap">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={v.icon}/>
            </svg>
          </span>
          <p class="value-card__kicker">{v.kicker}</p>
          <h3 class="value-card__title">{v.title}</h3>
          <p class="value-card__text">{v.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     WHAT WE DO
════════════════════════════════════════════════════ -->
<section class="about-services">
  <div class="container about-services__grid">

    <!-- Left label col -->
    <div class="about-services__intro">
      <p class="about-services__kicker">Everything under one roof</p>
      <h2 class="about-services__heading">What We Do</h2>
      <div class="about-services__divider"></div>
      <p class="about-services__body">
        From your first message to the ride back to the airport, we look after every part of your trip so you can focus entirely on the wildlife.
      </p>
      <a href="/contact/" class="btn btn--primary btn--lg">Request Quotation</a>
    </div>

    <!-- Service cards grid -->
    <div class="about-services__cards">
      {services.map((s) => (
        <div class="service-card">
          <div class="service-card__top">
            <span class="service-card__icon-wrap">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#12210f" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={s.icon}/>
              </svg>
            </span>
            <span class="service-card__num">{s.num}</span>
          </div>
          <h3 class="service-card__name">{s.name}</h3>
          <p class="service-card__text">{s.text}</p>
        </div>
      ))}

      <!-- Custom trip card -->
      <div class="service-card service-card--cta">
        <h3 class="service-card--cta__title">Something else in mind?</h3>
        <p class="service-card--cta__text">We can build a custom trip around your dates, budget and interests.</p>
        <a href="/contact/" class="service-card--cta__link">
          Ask our team
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>

  </div>
</section>

<!-- ════════════════════════════════════════════════════
     MEET THE TEAM
════════════════════════════════════════════════════ -->
<section class="about-team">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">The people behind every safari</span>
      <h2 class="section-title">Meet Our Team</h2>
      <p class="section-sub">L'okawa Tours is built on personal expertise. Every safari is planned and guided by people who have done this themselves.</p>
    </div>
    <div class="team-grid">

      <!-- Achuka Dennis -->
      <div class="team-card">
        <div class="team-card__img-wrap">
          <img
            src="/images/people/achuka-dennis-director.jpg"
            alt="Achuka Dennis, Director of L'okawa Tours and Travel Uganda"
            class="team-card__img"
            loading="lazy"
            width="400"
            height="480"
          />
        </div>
        <div class="team-card__body">
          <h3 class="team-card__name">Achuka Dennis</h3>
          <p class="team-card__role">Director, L'okawa Tours and Travel</p>
          <p class="team-card__bio">
            Dennis founded L'okawa Tours in 2021 with a simple goal: to make East Africa's best wildlife experiences accessible to every traveller at an honest price. He oversees all safari operations, itinerary design and client relationships, bringing hands-on knowledge of Uganda's parks, lodges and communities built over years of guiding and travel.
          </p>
        </div>
      </div>

      <!-- Maniraguha Richard -->
      <div class="team-card">
        <div class="team-card__img-wrap">
          <img
            src="/images/people/maniraguha-richard-guide-cofounder.jpg"
            alt="Maniraguha Richard, Driver-Guide and Co-founder of L'okawa Tours Uganda"
            class="team-card__img"
            loading="lazy"
            width="400"
            height="480"
          />
        </div>
        <div class="team-card__body">
          <h3 class="team-card__name">Maniraguha Richard</h3>
          <p class="team-card__role">Co-founder and Lead Driver-Guide</p>
          <p class="team-card__bio">
            Richard is L'okawa's lead driver-guide and co-founder. He has navigated Uganda's parks for years, from the remote savannah of Kidepo Valley to the misty forest trails of Bwindi. His knowledge of wildlife behaviour, road conditions and local communities ensures every safari runs smoothly — and his warmth makes guests feel at home from the first meeting at the airport.
          </p>
        </div>
      </div>

    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     VEHICLES
════════════════════════════════════════════════════ -->
<section class="about-fleet">
  <div class="container about-fleet__grid">

    <!-- Image -->
    <div class="about-fleet__img-wrap" aria-hidden="true">
      <img
        src="/images/accommodation/safari-lodge-exterior.jpg"
        alt="L'okawa Tours safari vehicle and camp in East Africa"
        class="about-fleet__img"
        loading="lazy"
      />
    </div>

    <!-- Text -->
    <div class="about-fleet__text">
      <p class="about-fleet__kicker">Travel in comfort</p>
      <h2 class="about-fleet__heading">Safari-Ready Vans and Local Drivers</h2>
      <p class="about-fleet__body">
        Getting there is part of the adventure. Our vehicles are kept clean and well-maintained, and our drivers know the roads, the animals and the best spots for photography.
      </p>
      <ul class="fleet-list">
        {fleet.map((f) => (
          <li class="fleet-list__item">
            <span class="fleet-list__check" aria-hidden="true">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#12210f" stroke-width="3.4" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12l5 5L20 7"/>
              </svg>
            </span>
            {f.text}
          </li>
        ))}
      </ul>
      <a href="/contact/" class="btn btn--primary btn--lg">Request Quotation</a>
    </div>

  </div>
</section>

<!-- ════════════════════════════════════════════════════
     BOTTOM CTA BAND
════════════════════════════════════════════════════ -->
<CtaBand
  heading="Ready to Plan Your East Africa Safari?"
  sub="Tell us where you want to go and we will build your perfect itinerary. No obligation, no pressure. We respond within 24 hours."
  contact='+256 761 512 966 &nbsp;&middot;&nbsp; <a href="mailto:lokawatoursandtravelultd@gmail.com">lokawatoursandtravelultd@gmail.com</a>'
  btn1="Get a Free Quote"
  btn1Href="/contact/"
  btn2="Browse All Tours"
  btn2Href="/tours/"
  labelId="about-cta-heading"
/>

</BaseLayout>

<style>
/* ══════════════════════════════════════════
   PAGE BANNER
══════════════════════════════════════════ */
.about-banner {
  position: relative;
  overflow: hidden;
  min-height: 340px;
  background: linear-gradient(180deg, #16290f 0%, #2f4d20 40%, #b8561a 82%, #f4b41a 100%);
}

/* Real photo layer, sits between the gradient base and the SVG/overlay */
.about-banner::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image: url('/images/gorillas/four-gorillas-group.jpg');
  background-size: cover;
  background-position: center 35%;
  opacity: 0.28;          /* low opacity so the gradient colours show through */
  z-index: 0;
}
.about-banner__svg {
  position: absolute;
  left: 0; bottom: 0;
  width: 100%; height: 100%;
  pointer-events: none;
  z-index: 1;
}
.about-banner__overlay {
  position: absolute;
  inset: 0;
  background: linear-gradient(90deg,
    rgba(10,20,8,.78) 0%,
    rgba(10,20,8,.4)  55%,
    rgba(10,20,8,0)   85%);
  z-index: 1;
}
.about-banner__content {
  position: relative;
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 70px var(--section-pad-x) 100px;
  box-sizing: border-box;
  z-index: 2;
}
.about-banner__breadcrumb {
  font-size: 14px;
  font-weight: var(--weight-semibold);
  letter-spacing: .06em;
  color: var(--color-cream);
  margin-bottom: 14px;
}
.about-banner__breadcrumb-link {
  color: var(--color-cream);
  transition: color var(--transition-fast);
}
.about-banner__breadcrumb-link:hover { color: var(--color-gold); }
.about-banner__breadcrumb-current { color: var(--color-gold); }
.about-banner__kicker {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 500;
  font-size: 22px;
  color: var(--color-gold);
  margin-bottom: 6px;
  display: block;
}
.about-banner__h1 {
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
  font-size: 64px;
  line-height: var(--leading-tight);
  color: var(--color-white);
  margin: 0;
}

/* ══════════════════════════════════════════
   OUR STORY
══════════════════════════════════════════ */
.about-story { padding: 96px 0 80px; }
.about-story__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 56px;
  align-items: center;
}
.about-story__text { flex: 1 1 500px; min-width: 0; }
.about-story__kicker {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 500;
  font-size: 20px;
  color: var(--color-amber);
  margin-bottom: 6px;
}
.about-story__heading {
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
  font-size: var(--text-5xl);
  line-height: var(--leading-snug);
  text-transform: uppercase;
  margin: 0 0 22px;
  color: var(--color-text-primary);
}
.about-story__brand {
  background: var(--color-forest);
  color: var(--color-white);
  padding: 2px 14px;
  border-radius: var(--radius-sm);
  white-space: nowrap;
}
.about-story__body {
  font-size: 18px;
  line-height: var(--leading-loose);
  color: var(--color-text-body);
  margin-bottom: 16px;
}
.about-story__body:last-of-type { margin-bottom: 28px; }

/* Staggered mosaic */
.about-story__mosaic {
  flex: 1 1 440px;
  min-width: 0;
  display: flex;
  gap: 14px;
}
.about-story__col {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 14px;
}
.about-story__col--b { padding-top: 44px; }
.about-story__img {
  width: 100%;
  object-fit: cover;
  border-radius: var(--radius-lg);
  display: block;
}

/* ══════════════════════════════════════════
   STATS BAND
══════════════════════════════════════════ */
.stats-band { background: var(--color-forest); }
.stats-band__inner {
  max-width: var(--max-width);
  margin-inline: auto;
  padding: 56px var(--section-pad-x);
  display: flex;
  flex-wrap: wrap;
  gap: 30px 0;
}
.stats-band__item {
  flex: 1 1 220px;
  text-align: center;
  padding: 0 16px;
  border-right: 1px solid rgba(243,236,216,.2);
}
.stats-band__item:last-child { border-right: none; }
.stats-band__value {
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
  font-size: 56px;
  line-height: 1;
  color: var(--color-gold);
}
.stats-band__label {
  font-size: var(--text-base);
  font-weight: var(--weight-bold);
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--color-cream);
  margin-top: 10px;
}

/* ══════════════════════════════════════════
   VALUES
══════════════════════════════════════════ */
.about-values {
  background: var(--color-parchment);
  padding: 90px 0;
}
.values-row {
  display: flex;
  flex-wrap: wrap;
  gap: 24px;
}
.value-card {
  flex: 1 1 300px;
  background: var(--color-white);
  border-radius: var(--radius-xl);
  padding: 32px;
  box-shadow: var(--shadow-card);
  border-top: 4px solid var(--color-amber);
}
.value-card__icon-wrap {
  width: 52px;
  height: 52px;
  border-radius: 50%;
  background: #fbf0d4;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18px;
}
.value-card__kicker {
  font-family: var(--font-display);
  font-style: italic;
  font-size: 18px;
  color: var(--color-amber);
  margin-bottom: 4px;
}
.value-card__title {
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
  font-size: 25px;
  line-height: 1.2;
  color: var(--color-forest);
  margin-bottom: 10px;
}
.value-card__text {
  font-size: 16px;
  line-height: 1.7;
  color: var(--color-text-body);
}

/* ══════════════════════════════════════════
   WHAT WE DO
══════════════════════════════════════════ */
.about-services {
  background: var(--color-forest);
  color: var(--color-cream);
  padding: 96px 0;
}
.about-services__grid {
  display: flex;
  flex-wrap: wrap;
  gap: 56px;
  align-items: flex-start;
}
.about-services__intro { flex: 1 1 320px; min-width: 0; }
.about-services__kicker {
  font-family: var(--font-display);
  font-style: italic;
  font-weight: 500;
  font-size: 20px;
  color: var(--color-gold);
  margin-bottom: 6px;
  display: block;
}
.about-services__heading {
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
  font-size: 44px;
  line-height: 1.1;
  color: var(--color-white);
  text-transform: uppercase;
  margin: 0 0 20px;
}
.about-services__divider {
  width: 64px;
  height: 4px;
  background: var(--color-gold);
  margin-bottom: 24px;
}
.about-services__body {
