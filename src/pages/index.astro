---
import BaseLayout from '../layouts/BaseLayout.astro';

// ── Services bar ──────────────────────────────────────────────
const services = [
  { name: 'Tour Packages',     icon: 'M4 8h16a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1zM9 8V6a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2' },
  { name: 'Safari Adventures', icon: 'M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1zM12 10.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z' },
  { name: 'Hotel Bookings',    icon: 'M5 3h14v18H5zM9 7h2M13 7h2M9 11h2M13 11h2M9 15h2M13 15h2M11 21v-3h2v3' },
  { name: 'Airport Transfers', icon: 'M21 3L10 14M21 3l-7 18-4-7-7-4 18-7z' },
  { name: 'Group Travel',      icon: 'M9 11a3 3 0 1 0 0-6 3 3 0 0 0 0 6zM3 20c0-3.3 2.7-6 6-6s6 2.7 6 6M17 10a2.5 2.5 0 1 0 0-5M17 14c2.5 0 4.5 2 4.5 5' },
];

// ── Why choose us images ──────────────────────────────────────
const mosaicImages = [
  { src: '/images/gorillas/gorilla-mother-infant-closeup.jpg', alt: 'Mother mountain gorilla with infant in Bwindi Impenetrable Forest Uganda', height: 230 },
  { src: '/images/wildlife/elephants-crossing-river.jpg',      alt: 'African elephants crossing river on Uganda wildlife safari',               height: 160 },
  { src: '/images/wildlife/cheetah-mother-cub.jpg',            alt: 'Cheetah mother and cub on Kenya safari Masai Mara',                       height: 160 },
  { src: '/images/wildlife/tree-climbing-lion-ishasha.jpg',    alt: 'Tree-climbing lion in Ishasha Queen Elizabeth National Park Uganda',      height: 230 },
];

// ── Wildlife facts strip ──────────────────────────────────────
const facts = [
  { stat: '1,066+', label: 'Bird Species in Uganda' },
  { stat: '19',     label: 'Gorilla Families in Bwindi' },
  { stat: '4',      label: 'Countries Covered' },
  { stat: '32+',    label: 'Safari Packages' },
];

// ── Promise cards ─────────────────────────────────────────────
const promises = [
  {
    kicker: 'A taste of the extraordinary',
    title:  'Romance, relaxation and wild encounters',
    text:   'From misty gorilla forests to breathtaking sunset game drives, we craft journeys that blend adventure, culture and real comfort however you travel.',
  },
  {
    kicker: 'High quality, affordable tours',
    title:  'Safaris that change how you see the world',
    text:   'Fly-in or by road, budget camp or luxury lodge, every package is built around your time, your budget and the wildlife you most want to experience.',
  },
  {
    kicker: 'Travel in comfort',
    title:  'Safari-ready vehicles and local expertise',
    text:   'Our 4x4 safari vehicles have roof hatches for game viewing, clean interiors and experienced drivers who know every road and every animal watering hole.',
  },
];

// ── Destination cards ─────────────────────────────────────────
const destinations = [
  {
    name: 'Bwindi Impenetrable National Park',
    href: '/destinations/uganda/bwindi-impenetrable-national-park/',
    img:  '/images/gorillas/silverback-gorilla-group.jpg',
    alt:  'Silverback mountain gorilla family in Bwindi Impenetrable National Park Uganda gorilla trekking',
    tag:  'Uganda',
  },
  {
    name: 'Masai Mara National Reserve',
    href: '/destinations/kenya/masai-mara/',
    img:  '/images/wildlife/safari-vehicle-lions.jpg',
    alt:  'Safari vehicle with lions in Masai Mara National Reserve Kenya game drive',
    tag:  'Kenya',
  },
  {
    name: 'Murchison Falls National Park',
    href: '/destinations/uganda/murchison-falls-national-park/',
    img:  '/images/wildlife/giraffe-uganda-murchison.jpg',
    alt:  'Rothschild giraffe feeding in Murchison Falls National Park Uganda safari',
    tag:  'Uganda',
  },
  {
    name: 'Queen Elizabeth National Park',
    href: '/destinations/uganda/queen-elizabeth-national-park/',
    img:  '/images/wildlife/tree-climbing-lion-ishasha.jpg',
    alt:  'Lioness in fig tree Ishasha sector Queen Elizabeth National Park Uganda',
    tag:  'Uganda',
  },
];

// ── Popular tours (8) ─────────────────────────────────────────
const tours = [
  {
    title:    '3 Days Uganda Gorilla Safari',
    country:  'Uganda',
    blurb:    'Hike into Bwindi Impenetrable Forest for a face-to-face hour with wild mountain gorillas. Gorilla permit and all meals included.',
    duration: '3 Days',
    price:    '$1,400 – $2,000',
    href:     '/tours/3-days-uganda-gorilla-safari/',
    img:      '/images/gorillas/gorilla-amber-eyes-closeup.jpg',
    alt:      'Mountain gorilla with amber eyes in Bwindi Impenetrable Forest Uganda gorilla trekking',
  },
  {
    title:    '3 Days Murchison Falls Safari',
    country:  'Uganda',
    blurb:    'Game drives, a Nile boat cruise and rhino tracking at Ziwa Sanctuary. Three days from Kampala, all meals included.',
    duration: '3 Days',
    price:    '$650 – $950',
    href:     '/tours/3-days-murchison-falls-safari/',
    img:      '/images/wildlife/giraffe-uganda-murchison.jpg',
    alt:      'Giraffe on game drive in Murchison Falls National Park Uganda safari',
  },
  {
    title:    '3 Days Queen Elizabeth Safari',
    country:  'Uganda',
    blurb:    'Tree-climbing lions in Ishasha, the Kazinga Channel boat cruise and over 600 bird species.',
    duration: '3 Days',
    price:    '$600 – $900',
    href:     '/tours/3-days-queen-elizabeth-national-park-safari/',
    img:      '/images/wildlife/hippos-in-grass-kazinga.jpg',
    alt:      'Hippos resting on banks of Kazinga Channel Queen Elizabeth National Park Uganda',
  },
  {
    title:    '3 Days Masai Mara Safari Kenya',
    country:  'Kenya',
    blurb:    'Big cats, the Great Wildebeest Migration and wide open plains in Africa\'s most celebrated reserve.',
    duration: '3 Days',
    price:    '$900 – $1,350',
    href:     '/tours/3-days-masai-mara-safari/',
    img:      '/images/wildlife/lion-kidepo-rock-sunset.jpg',
    alt:      'Male lion on rock at sunset Kenya Masai Mara safari game drive',
  },
  {
    title:    '5 Days Uganda Primates Safari',
    country:  'Uganda',
    blurb:    'Chimpanzee trekking in Kibale Forest and mountain gorilla trekking in Bwindi. Both permits included.',
    duration: '5 Days',
    price:    '$2,100 – $2,900',
    href:     '/tours/5-days-uganda-primates-safari/',
    img:      '/images/primates/chimpanzees-pair-feeding.jpg',
    alt:      'Wild chimpanzees feeding together in Kibale Forest National Park Uganda primate safari',
  },
  {
    title:    '4 Days Rwanda Gorilla Trekking',
    country:  'Rwanda',
    blurb:    'Trek mountain gorillas and golden monkeys in Volcanoes National Park. Gorilla permit included.',
    duration: '4 Days',
    price:    '$2,500 – $3,500',
    href:     '/tours/4-days-rwanda-gorilla-trekking/',
    img:      '/images/primates/golden-monkey-mother-baby.jpg',
    alt:      'Golden monkey mother and baby in Volcanoes National Park Rwanda gorilla trekking',
  },
  {
    title:    '7 Days Uganda Wildlife Safari',
    country:  'Uganda',
    blurb:    'Gorillas, chimps, game drives and a Nile boat cruise. Uganda\'s classic 7-day safari circuit.',
    duration: '7 Days',
    price:    '$2,800 – $3,900',
    href:     '/tours/7-days-uganda-gorilla-chimp-wildlife-safari/',
    img:      '/images/gorillas/gorilla-mother-baby-bwindi.jpg',
    alt:      'Mountain gorilla mother carrying baby in Bwindi Impenetrable Forest Uganda',
  },
  {
    title:    '3 Days Ssese Islands Uganda',
    country:  'Uganda',
    blurb:    'White sandy beaches, birding and canoe rides on Lake Victoria. Uganda\'s hidden beach paradise.',
    duration: '3 Days',
    price:    '$350 – $520',
    href:     '/tours/3-days-ssese-islands-uganda/',
    img:      '/images/wildlife/hippo-walking-water.jpg',
    alt:      'Hippo walking through Lake Victoria water near Ssese Islands Uganda',
  },
];

// ── Testimonials ──────────────────────────────────────────────
const testimonials = [
  {
    name:    'Sarah M.',
    country: 'United Kingdom',
    tour:    '5 Days Uganda Primates Safari',
    rating:  5,
    text:    'An absolutely life-changing experience. Our guide knew exactly where the gorilla family would be and we spent a full hour watching them. L\'okawa handled every detail perfectly from pickup at Entebbe to the final drop-off.',
    flag:    '🇬🇧',
  },
  {
    name:    'James & Priya K.',
    country: 'United States',
    tour:    '7 Days Uganda Wildlife Safari',
    rating:  5,
    text:    'We saw tree-climbing lions, tracked chimps in Kibale and came face to face with gorillas in Bwindi all in one trip. The 4x4 vehicle was spotless, our driver was brilliant and the lodges were perfect. Highly recommend.',
    flag:    '🇺🇸',
  },
  {
    name:    'Lukas B.',
    country: 'Germany',
    tour:    '3 Days Murchison Falls Safari',
    rating:  5,
    text:    'Best value safari I have done in East Africa. The rhino tracking at Ziwa was a bonus I did not expect. Very well organised, honest pricing and the Nile boat cruise at sunset was unforgettable.',
    flag:    '🇩🇪',
  },
];

// ── FAQ ───────────────────────────────────────────────────────
const faqs = [
  {
    q: 'How much does gorilla trekking in Uganda cost?',
    a: 'A Uganda gorilla trekking permit costs USD 800 per person for foreign non-residents. This is set by the Uganda Wildlife Authority and covers your ranger guide, conservation fees and one hour with a gorilla family. L\'okawa tour packages include the permit in the total price.',
  },
  {
    q: 'What is the best time to visit Uganda for a safari?',
    a: 'Uganda can be visited year-round for gorilla trekking. The best conditions are during the two dry seasons: June to September and December to February. These months have drier trails and easier trekking. However, gorillas can be tracked in any month.',
  },
  {
    q: 'How difficult is gorilla trekking in Bwindi?',
    a: 'Gorilla trekking ranges from moderate to strenuous depending on where the gorilla family is located that day. Treks can take between 30 minutes and 8 hours through steep, muddy forest terrain. A reasonable level of fitness is recommended. Porters are available for hire at the trailhead.',
  },
  {
    q: 'How far in advance should I book a gorilla permit?',
    a: 'We recommend booking your gorilla permit at least 3 to 6 months in advance, especially for travel during the peak dry seasons (June to September and December to February). Permits sell out quickly and are limited to 96 visitors per day across all Bwindi sectors.',
  },
  {
    q: 'What countries does L\'okawa Tours cover?',
    a: 'L\'okawa Tours and Travel offers safari packages in Uganda, Kenya, Tanzania and Rwanda. Our main focus is Uganda gorilla trekking and wildlife safaris, but we also offer Masai Mara safaris in Kenya, Serengeti tours in Tanzania and gorilla trekking in Rwanda\'s Volcanoes National Park.',
  },
  {
    q: 'Are all meals and park fees included in the tour price?',
    a: 'Yes. All L\'okawa tour packages include all meals as specified in the itinerary (breakfast, lunch and dinner), park entrance fees, English-speaking driver/guide, private 4x4 safari vehicle and bottled water. Gorilla and chimpanzee permits are included where the activity is listed in the itinerary.',
  },
];

// ── JSON-LD: WebPage + FAQPage schema ────────────────────────
const homepageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": "https://lokawatours.com/",
      "url": "https://lokawatours.com/",
      "name": "Uganda Gorilla Trekking Tours & East Africa Safari Packages | L'okawa Tours",
      "description": "Book affordable Uganda gorilla trekking, Kenya safaris and Tanzania tours with L'okawa Tours. Expert local guides, 4x4 vehicles, all permits included.",
      "inLanguage": "en-US",
      "isPartOf": { "@id": "https://lokawatours.com/#website" },
      "about": {
        "@type": "TouristDestination",
        "name": "East Africa",
        "includesAttraction": [
          { "@type": "TouristAttraction", "name": "Bwindi Impenetrable National Park" },
          { "@type": "TouristAttraction", "name": "Queen Elizabeth National Park" },
          { "@type": "TouristAttraction", "name": "Murchison Falls National Park" },
          { "@type": "TouristAttraction", "name": "Masai Mara National Reserve" },
          { "@type": "TouristAttraction", "name": "Serengeti National Park" },
          { "@type": "TouristAttraction", "name": "Volcanoes National Park Rwanda" }
        ]
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
});

// ── Country circles — removed, replaced by boarding pass cards ──
---

<BaseLayout
  title="Uganda Gorilla Trekking Tours & East Africa Safari Packages | L'okawa Tours"
  description="Book affordable Uganda gorilla trekking safaris, Kenya wildlife tours and Tanzania packages with L'okawa Tours. Local guides, 4x4 vehicles, all permits included. Est. Kampala 2021."
  ogImage="/images/wildlife/safari-vehicle-lions.jpg"
  schema={homepageSchema}
>

<!-- ═══════════════════════════════════════════════════════
  1. HERO
══════════════════════════════════════════════════════════ -->
<section class="hero" aria-label="L'okawa Tours and Travel Uganda East Africa Safari">

  <div class="hero__bg" aria-hidden="true"></div>
  <div class="hero__overlay" aria-hidden="true"></div>

  <svg class="hero__svg" viewBox="0 0 1440 660" preserveAspectRatio="xMidYMax slice" aria-hidden="true">
    <circle cx="1090" cy="410" r="140" fill="#ffd45a" opacity=".15"/>
    <circle cx="1090" cy="410" r="96"  fill="#ffd45a" opacity=".55"/>
    <path d="M0 520 C220 480 400 510 580 480 C780 450 940 510 1140 480 C1280 460 1370 490 1440 480 L1440 660 L0 660Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 580 C240 548 440 580 660 560 C880 540 1100 580 1440 550 L1440 660 L0 660Z" fill="#0d1a0a"/>
    <g fill="#0d1a0a">
      <rect x="1236" y="420" width="10" height="150"/>
      <ellipse cx="1241" cy="412" rx="104" ry="26"/>
      <ellipse cx="1180" cy="430" rx="62"  ry="17"/>
      <ellipse cx="1300" cy="428" rx="62"  ry="17"/>
    </g>
    <g fill="#0d1a0a">
      <ellipse cx="800" cy="550" rx="62" ry="30"/>
      <circle  cx="864" cy="534" r="20"/>
      <path    d="M878 536 C900 540 906 568 898 584 L890 584 C892 566 886 552 872 548Z"/>
      <rect x="756" y="568" width="14" height="30"/>
      <rect x="782" y="568" width="14" height="30"/>
      <rect x="818" y="568" width="14" height="30"/>
    </g>
  </svg>

  <div class="hero__content">
    <p class="hero__kicker">Find your special tour today</p>
    <h1 class="hero__h1">
      Uganda Gorilla Trekking<br class="hero__br" /> and East Africa Safaris
    </h1>
    <p class="hero__sub">
      Where Nature Meets Attraction. Expert-guided gorilla trekking in Uganda, Kenya wildlife safaris, Tanzania tours and Rwanda gorilla packages. All permits included.
    </p>
    <div class="btn-group hero__ctas">
      <a href="/contact/" class="btn btn--primary btn--lg">Request Quotation</a>
      <a href="/tours/"   class="btn btn--outline btn--lg">View Safari Packages</a>
    </div>

    <div class="hero__trust" role="list">
      <span class="hero__trust-item" role="listitem">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
        Est. 2021, Kampala
      </span>
      <span class="hero__trust-item" role="listitem">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        Local Ugandan Guides
      </span>
      <span class="hero__trust-item" role="listitem">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        Private 4x4 Safari Vehicles
      </span>
      <span class="hero__trust-item" role="listitem">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        All Gorilla Permits Included
      </span>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
  2. SERVICES BAR — infinite horizontal marquee
══════════════════════════════════════════════════════════ -->
<div class="services-bar" aria-label="L'okawa Tours services">
  <!-- Track is duplicated so the loop is seamless -->
  <div class="services-bar__track" aria-hidden="true">
    <!-- First copy -->
    <div class="services-bar__set">
      {services.map((s) => (
        <div class="service-item">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={s.icon}/>
          </svg>
          <span>{s.name}</span>
        </div>
      ))}
    </div>
    <!-- Second copy — keeps the loop gapless -->
    <div class="services-bar__set" aria-hidden="true">
      {services.map((s) => (
        <div class="service-item">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d={s.icon}/>
          </svg>
          <span>{s.name}</span>
        </div>
      ))}
    </div>
  </div>
  <!-- Accessible static list for screen readers only -->
  <ul class="sr-only">
    {services.map((s) => <li>{s.name}</li>)}
  </ul>
</div>

<!-- ═══════════════════════════════════════════════════════
  3. WHY CHOOSE US
══════════════════════════════════════════════════════════ -->
<section class="why section" aria-labelledby="why-heading">
  <div class="container why__inner">

    <div class="why__text">
      <h2 id="why-heading" class="why__heading">
        Why choose
        <span class="why__brand">L'OKAWA</span>
      </h2>
      <p class="body-lg">
        L'okawa Tours and Travel (U) Ltd is a Uganda-based safari company established in 2021, offering gorilla trekking tours, wildlife safaris, hotel bookings, airport transfers and group travel across Uganda, Kenya, Tanzania and Rwanda. Our itineraries are built around your pace, your budget and the wildlife you most want to see.
      </p>
      <p class="body-lg why__para2">
        As a locally owned operator based in Kiwatule, Kampala, we have on-the-ground knowledge that no international booking platform can match. From the best gorilla families in Bwindi to the optimal boat cruise timing on the Kazinga Channel, we know every detail that makes a safari unforgettable.
      </p>
      <a href="/about/" class="btn btn--secondary btn--lg">More About Us</a>
    </div>

    <div class="why__mosaic" aria-hidden="true">
      <div class="why__col why__col--left">
        <img src={mosaicImages[0].src} alt={mosaicImages[0].alt} class="why__img" style={`height: ${mosaicImages[0].height}px;`} loading="lazy" width="220" height="230"/>
        <img src={mosaicImages[1].src} alt={mosaicImages[1].alt} class="why__img" style={`height: ${mosaicImages[1].height}px;`} loading="lazy" width="220" height="160"/>
      </div>
      <div class="why__col why__col--right">
        <img src={mosaicImages[2].src} alt={mosaicImages[2].alt} class="why__img" style={`height: ${mosaicImages[2].height}px;`} loading="lazy" width="220" height="160"/>
        <img src={mosaicImages[3].src} alt={mosaicImages[3].alt} class="why__img" style={`height: ${mosaicImages[3].height}px;`} loading="lazy" width="220" height="230"/>
      </div>
    </div>

  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
  4. WILDLIFE FACTS STRIP
══════════════════════════════════════════════════════════ -->
<div class="facts-strip section--forest" aria-label="East Africa safari facts">
  <div class="facts-strip__inner container">
    {facts.map((f) => (
      <div class="facts-strip__item">
        <span class="facts-strip__stat">{f.stat}</span>
        <span class="facts-strip__label">{f.label}</span>
      </div>
    ))}
  </div>
</div>

<!-- ═══════════════════════════════════════════════════════
  5. PROMISE CARDS
══════════════════════════════════════════════════════════ -->
<section class="section--parchment section--sm" aria-labelledby="promises-heading">
  <div class="container">
    <h2 id="promises-heading" class="sr-only">Our promise to every traveler</h2>
    <div class="promises">
      {promises.map((p) => (
        <article class="promise-card">
          <p class="promise-card__kicker">{p.kicker}</p>
          <h3 class="promise-card__title">{p.title}</h3>
          <p class="promise-card__text">{p.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
  6. DESTINATIONS GRID
══════════════════════════════════════════════════════════ -->
<section class="section destinations-section" aria-labelledby="destinations-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">Browse our safari tours</span>
      <h2 id="destinations-heading">Top Safari Destinations in East Africa</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="destinations-grid">
      {destinations.map((d) => (
        <a href={d.href} class="dest-card" aria-label={`Explore ${d.name} safari tours`}>
          <img src={d.img} alt={d.alt} class="dest-card__img" loading="lazy"/>
          <span class="dest-card__tag badge">{d.tag}</span>
          <div class="dest-card__overlay"></div>
          <div class="dest-card__label">{d.name}</div>
        </a>
      ))}
    </div>
    <div class="destinations-section__cta">
      <a href="/destinations/" class="btn btn--secondary">Explore All Destinations</a>
    </div>
  </div>
</section>

<!-- ═══════════════════════════════════════════════════════
  7. TOURS GRID
══════════════════════════════════════════════════════════ -->
<section class="section tours-section" aria-labelledby="tours-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">Take a look at our</span>
      <h2 id="tours-heading">Most Popular Safari Packages</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="tours-grid">
      {tours.map((t) => (
        <article class="tour-card">
          <a href={t.href} class="tour-card__img-link" tabindex="-1" aria-hidden="true">
            <img src={t.img} alt={t.alt} class="tour-card__img" loading="lazy"/>
            <span class="badge tour-card__badge">{t.country}</span>
          </a>
          <div class="tour-card__body">
            <h3 class="tour-card__title">
              <a href={t.href} class="tour-card__title-link">{t.title}</a>
            </h3>
            <p class="tour-card__blurb">{t.blurb}</p>
            <div class="tour-card__footer">
