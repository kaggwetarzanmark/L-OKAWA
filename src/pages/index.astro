/* ════════════════════════════════════════════════════════
   SERVICES BAR — infinite marquee
════════════════════════════════════════════════════════ */
.services-bar {
  background-color: var(--color-amber);
  color: var(--color-forest-deep);
  overflow: hidden;            /* clip the scrolling track */
  position: relative;
}

/* Fade edges so items appear to scroll in/out smoothly */
.services-bar::before,
.services-bar::after {
  content: '';
  position: absolute;
  top: 0;
  bottom: 0;
  width: 80px;
  z-index: 2;
  pointer-events: none;
}
.services-bar::before {
  left: 0;
  background: linear-gradient(to right, var(--color-amber), transparent);
}
.services-bar::after {
  right: 0;
  background: linear-gradient(to left, var(--color-amber), transparent);
}

/* The scrolling track — two identical sets side by side */
.services-bar__track {
  display: flex;
  width: max-content;
  animation: marquee 22s linear infinite;
}

/* Pause on hover so users can read */
.services-bar:hover .services-bar__track {
  animation-play-state: paused;
}

/* Respect reduced-motion preference */
@media (prefers-reduced-motion: reduce) {
  .services-bar__track { animation: none; }
  .services-bar::before,
  .services-bar::after  { display: none; }
}

/* One set of items */
.services-bar__set {
  display: flex;
  flex-shrink: 0;
}

/* Individual service item — keep global .service-item for the inner style */
.services-bar .service-item {
  flex-shrink: 0;
  padding: 22px 28px;
  display: flex;
  gap: 12px;
  align-items: center;
  font-weight: var(--weight-extrabold);
  font-size: var(--text-base);
  letter-spacing: var(--tracking-wide);
  text-transform: uppercase;
  border-right: 1px solid rgba(18, 33, 15, 0.2);
  white-space: nowrap;
}

/* Marquee keyframe: translate one full set-width to the left */
@keyframes marquee {
  from { transform: translateX(0); }
  to   { transform: translateX(-50%); }  /* -50% = one set, second set takes over */
}

