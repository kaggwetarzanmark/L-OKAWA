---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand    from '../../components/CtaBand.astro';

const steps = [
  {
    num: '01',
    title: 'Send Us Your Enquiry',
    body: 'Tell us your travel dates, group size, budget range and which experiences interest you most — gorilla trekking, game drives, beach, or a combination. Use the contact form, email, or WhatsApp. We respond within 4 hours Monday to Saturday.',
    icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
    detail: 'No commitment required. We just need your dates and interests to start building your quote.',
  },
  {
    num: '02',
    title: 'We Build Your Custom Itinerary',
    body: 'Within 24 hours we send you a fully detailed day-by-day itinerary tailored to your dates, group size and budget. This includes accommodation options at different price points, a full breakdown of costs and all permit fees.',
    icon: 'M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z M14 2v6h6 M16 13H8 M16 17H8 M10 9H8',
    detail: 'We can adjust anything — swap parks, change accommodation tier, add or remove days. Most clients exchange 2 to 3 messages before confirming.',
  },
  {
    num: '03',
    title: 'Confirm With a 30% Deposit',
    body: 'Once you are happy with the itinerary and quote, a 30% deposit secures your booking. We immediately purchase your gorilla and chimpanzee permits directly from the Uganda Wildlife Authority — this is critical as permits sell out months ahead.',
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
    detail: 'Permits are non-refundable once purchased. We strongly recommend travel insurance covering pre-paid safari activities.',
  },
  {
    num: '04',
    title: 'We Handle Everything',
    body: 'We book all accommodation, arrange airport transfers, confirm restaurant stops, secure boat cruise slots and brief your driver-guide. You receive a full trip dossier with lodge contacts, emergency numbers and everything you need 2 weeks before departure.',
    icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 0 0 1.946-.806 3.42 3.42 0 0 1 4.438 0 3.42 3.42 0 0 0 1.946.806 3.42 3.42 0 0 1 3.138 3.138 3.42 3.42 0 0 0 .806 1.946 3.42 3.42 0 0 1 0 4.438 3.42 3.42 0 0 0-.806 1.946 3.42 3.42 0 0 1-3.138 3.138 3.42 3.42 0 0 0-1.946.806 3.42 3.42 0 0 1-4.438 0 3.42 3.42 0 0 0-1.946-.806 3.42 3.42 0 0 1-3.138-3.138 3.42 3.42 0 0 0-.806-1.946 3.42 3.42 0 0 1 0-4.438 3.42 3.42 0 0 0 .806-1.946 3.42 3.42 0 0 1 3.138-3.138z',
    detail: 'Your driver-guide meets you at the airport and stays with you throughout. L\'okawa\'s team is reachable on WhatsApp 7 days a week during your tour.',
  },
  {
    num: '05',
    title: 'Arrive and Experience Your Safari',
    body: 'Your driver-guide meets you at the airport with a welcome sign and your trip briefing. From that moment everything is taken care of — drives, check-ins, activity bookings and any changes that come up on the road. You just experience it.',
    icon: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z',
    detail: 'Most of our clients return home and immediately start planning their next trip with us.',
  },
];

const whyUs = [
  {
    icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z M23 21v-2a4 4 0 0 0-3-3.87 M16 3.13a4 4 0 0 1 0 7.75',
    title: 'Uganda-Based Team',
    text: 'We are not a booking platform or a middleman. We are a Uganda-based team who live near the parks, know the guides personally and have trekked the gorillas ourselves.',
  },
  {
    icon: 'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 0 0 1.946-.806 3.42 3.42 0 0 1 4.438 0 3.42 3.42 0 0 0 1.946.806 3.42 3.42 0 0 1 3.138 3.138 3.42 3.42 0 0 0 .806 1.946 3.42 3.42 0 0 1 0 4.438 3.42 3.42 0 0 0-.806 1.946 3.42 3.42 0 0 1-3.138 3.138 3.42 3.42 0 0 0-1.946.806 3.42 3.42 0 0 1-4.438 0 3.42 3.42 0 0 0-1.946-.806 3.42 3.42 0 0 1-3.138-3.138 3.42 3.42 0 0 0-.806-1.946 3.42 3.42 0 0 1 0-4.438 3.42 3.42 0 0 0 .806-1.946 3.42 3.42 0 0 1 3.138-3.138z',
    title: 'All Permits Included',
    text: 'Gorilla permits (USD 800), chimpanzee permits and all park fees are handled directly by us through the Uganda Wildlife Authority. No hidden extras.',
  },
  {
    icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',
    title: 'Honest, Transparent Pricing',
    text: '"From" prices are starting estimates. Every quote we send is fully itemised — accommodation, permits, vehicle, meals — so you know exactly what you are paying for.',
  },
  {
    icon: 'M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z',
    title: 'Personal Support Throughout',
    text: 'You deal with a real person from your first message to the last day of your safari. Your guide\'s WhatsApp number is in your trip dossier and so is ours.',
  },
  {
    icon: 'M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7 M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z',
    title: 'Flexible Custom Itineraries',
    text: 'Every package on our site is a starting point. Add days, swap parks, change accommodation, combine with Rwanda or Kenya. We adjust until it fits.',
  },
  {
    icon: 'M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z',
    title: 'Supporting Conservation',
    text: 'Every gorilla permit goes directly to Uganda Wildlife Authority. A portion of every safari booking funds community conservation projects around Bwindi and Murchison Falls.',
  },
];

const faqs = [
  { q: 'How far in advance should I book?', a: 'For gorilla trekking, book at least 3 to 6 months ahead during peak seasons (June to September, December to February). Uganda Wildlife Authority limits gorilla treks to 8 visitors per family per day and permits sell out fast. For non-gorilla safaris, 4 to 8 weeks is usually sufficient, though earlier is always better for accommodation choice.' },
  { q: 'What is included in the price?', a: 'All L\'okawa packages include: private 4x4 vehicle with driver-guide, all accommodation, all meals as specified, all park entrance fees, activity fees listed in the itinerary (boat cruises, game drives), gorilla and chimpanzee permits where included, and bottled water throughout. Flights, visas, travel insurance, alcohol, tips and optional add-ons are excluded.' },
  { q: 'What is your cancellation policy?', a: 'Cancellations 60+ days before departure: 30% fee. 30 to 60 days: 50% fee. Under 30 days: non-refundable. Gorilla and chimpanzee permits are always non-refundable once purchased from Uganda Wildlife Authority. We strongly recommend travel insurance that covers pre-paid safari activities and permits.' },
  { q: 'Can you arrange flights?', a: 'We do not book international flights but can recommend routing and airline options. The main gateway airports are Entebbe (Uganda), Nairobi (Kenya) and Kigali (Rwanda). We arrange all ground transport and domestic transfers from the moment you land.' },
  { q: 'What currencies do you accept?', a: 'All prices are quoted in US Dollars. We accept payment by international bank transfer (USD preferred). Bank transfer fees are the responsibility of the client. Mobile money is available for clients booking from within Uganda.' },
  { q: 'Is there a minimum group size?', a: 'No. We run safaris for solo travellers and couples as well as large groups. Per-person cost is higher for smaller groups because the vehicle cost is shared across fewer people. We will always be transparent about this in your quote.' },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home",         "item": "https://lokawatours.com/" },
        { "@type": "ListItem", "position": 2, "name": "How It Works" }
      ]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type": "Answer", "text": f.a }
      }))
    }
  ]
});
---

<BaseLayout
  title="How to Book a Safari with L'okawa Tours | 5 Easy Steps"
  description="Find out how easy it is to book your East Africa safari with L'okawa Tours. Send an enquiry, get a custom itinerary, confirm with a deposit — we handle the rest."
  schema={schema}
>

<!-- --------------------------------------------
     BANNER
-------------------------------------------- -->
<div class="hiw-banner">
  <div class="hiw-banner__photo" aria-hidden="true"></div>
  <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" class="hiw-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="200" r="100" fill="#ffd45a" opacity=".18"/>
    <circle cx="1130" cy="200" r="65"  fill="#ffd45a"/>
    <path d="M0 240 C220 210 400 236 580 214 C780 190 940 232 1140 212 C1280 198 1370 220 1440 214 L1440 300 L0 300Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 272 C240 252 440 272 660 262 C880 250 1100 274 1440 256 L1440 300 L0 300Z" fill="#0d1a0a"/>
  </svg>
  <div class="hiw-banner__overlay" aria-hidden="true"></div>
  <div class="hiw-banner__content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__cur">How It Works</span>
    </nav>
    <p class="hiw-banner__kicker">Simple, honest, personal</p>
    <h1 class="hiw-banner__h1">How to Book<br/>Your Safari</h1>
    <p class="hiw-banner__sub">From your first message to the day you land back home — here is exactly how we work and what you can expect at every step.</p>
  </div>
</div>

<!-- --------------------------------------------
     5 STEPS
-------------------------------------------- -->
<section class="hiw-steps section" aria-labelledby="steps-heading">
  <div class="container">
    <span class="kicker">The booking process</span>
    <h2 id="steps-heading" class="section-title">Five Steps to Your Dream Safari</h2>
    <div class="steps-list">
      {steps.map((s, i) => (
        <div class={`step ${i % 2 === 1 ? 'step--reverse' : ''}`}>
          <div class="step__num-col">
            <div class="step__num">{s.num}</div>
            {i < steps.length - 1 && <div class="step__line" aria-hidden="true"></div>}
          </div>
          <div class="step__content">
            <div class="step__icon-wrap">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d={s.icon}/>
              </svg>
            </div>
            <h3 class="step__title">{s.title}</h3>
            <p class="step__body">{s.body}</p>
            <p class="step__detail">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              {s.detail}
            </p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- --------------------------------------------
     CTA STRIP — ENQUIRE NOW
-------------------------------------------- -->
<div class="hiw-enquire" aria-label="Start your booking">
  <div class="container hiw-enquire__inner">
    <div class="hiw-enquire__text">
      <h2 class="hiw-enquire__h2">Ready to start? Send us a message.</h2>
      <p>Tell us your travel dates and interests. We respond within 4 hours Monday to Saturday.</p>
    </div>
    <div class="hiw-enquire__actions">
      <a href="/contact/" class="btn btn--primary btn--lg">Get a Free Quote</a>
      <a href="https://wa.me/256761512966" target="_blank" rel="noopener noreferrer" class="btn--wa-strip">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
        +256 761 512 966
      </a>
    </div>
  </div>
</div>

<!-- --------------------------------------------
     WHY L'OKAWA
-------------------------------------------- -->
<section class="hiw-why section--parchment" aria-labelledby="why-heading">
  <div class="container">
    <span class="kicker">Why travel with us</span>
    <h2 id="why-heading" class="section-title">What Makes L'okawa Different</h2>
    <div class="why-grid">
      {whyUs.map(w => (
        <div class="why-card">
          <div class="why-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d={w.icon}/>
            </svg>
          </div>
          <h3 class="why-card__title">{w.title}</h3>
          <p class="why-card__text">{w.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- --------------------------------------------
     FAQ
-------------------------------------------- -->
<section class="hiw-faq section" aria-labelledby="hiw-faq-heading">
  <div class="container hiw-faq__inner">
    <div class="hiw-faq__intro">
      <span class="kicker">Common questions</span>
      <h2 id="hiw-faq-heading" class="hiw-faq__h2">Booking FAQ</h2>
      <p class="hiw-faq__sub">Everything about deposits, cancellations, payments and what happens if plans change.</p>
      <a href="/plan/faq/" class="btn btn--ghost">Full Safari FAQ &rarr;</a>
    </div>
    <div class="hiw-faq__list">
      {faqs.map(f => (
        <details class="faq-item">
          <summary class="faq-item__q">
            <span>{f.q}</span>
            <svg class="faq-item__chevron" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="faq-item__a">{f.a}</div>
        </details>
      ))}
    </div>
  </div>
</section>

<CtaBand
  heading="Your East Africa safari starts with one message"
  btn1="Get a Free Quote"
  btn1Href="/contact/"
  btn2="Browse Safari Packages"
  btn2Href="/tours/"
/>

</BaseLayout>

<style>
/* -- Banner -- */
.hiw-banner { position:relative; overflow:hidden; min-height:320px; background:linear-gradient(180deg,#16290f 0%,#2f4d20 40%,#b8561a 82%,#f4b41a 100%); }
.hiw-banner__photo { position:absolute; inset:0; background-image:url('/images/wildlife/safari-vehicle-lions.jpg'); background-size:cover; background-position:center 40%; opacity:.2; z-index:0; }
.hiw-banner__svg { position:absolute; left:0; bottom:0; width:100%; height:100%; pointer-events:none; z-index:1; }
.hiw-banner__overlay { position:absolute; inset:0; background:linear-gradient(90deg,rgba(10,20,8,.85) 0%,rgba(10,20,8,.5) 55%,rgba(10,20,8,0) 88%); z-index:1; }
.hiw-banner__content { position:relative; z-index:2; max-width:var(--max-width); margin-inline:auto; padding:56px var(--section-pad-x) 80px; box-sizing:border-box; }
.hiw-banner__kicker { font-family:var(--font-display); font-style:italic; font-weight:500; font-size:20px; color:var(--color-gold); margin-bottom:6px; display:block; }
.hiw-banner__h1 { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:clamp(34px,5vw,58px); line-height:1.05; color:var(--color-white); margin:0 0 14px; }
.hiw-banner__sub { font-size:var(--text-lg); color:var(--color-cream); opacity:.9; max-width:520px; line-height:var(--leading-relaxed); }
/* Breadcrumb */
.breadcrumb { display:flex; flex-wrap:wrap; align-items:center; gap:6px 8px; font-size:13px; font-weight:var(--weight-semibold); color:var(--color-cream); margin-bottom:12px; }
.breadcrumb__link { color:var(--color-cream); transition:color var(--transition-fast); text-decoration:none; }
.breadcrumb__link:hover { color:var(--color-gold); }
.breadcrumb__sep { opacity:.4; }
.breadcrumb__cur { color:var(--color-gold); }
/* -- Steps -- */
.hiw-steps { padding-block:var(--section-pad-y); }
.steps-list { display:flex; flex-direction:column; gap:0; margin-top:40px; }
.step { display:grid; grid-template-columns:80px 1fr; gap:0 32px; position:relative; }
.step__num-col { display:flex; flex-direction:column; align-items:center; gap:0; }
.step__num { width:56px; height:56px; border-radius:50%; background:var(--color-green-dark); color:var(--color-gold); font-family:var(--font-display); font-weight:var(--weight-bold); font-size:18px; display:flex; align-items:center; justify-content:center; flex-shrink:0; z-index:1; position:relative; }
.step__line { width:2px; flex:1; min-height:40px; background:linear-gradient(to bottom, var(--color-green-dark), #dde8d4); margin:4px 0; }
.step__content { padding:0 0 52px; }
.step__icon-wrap { width:40px; height:40px; border-radius:10px; background:var(--color-parchment); display:flex; align-items:center; justify-content:center; margin-bottom:12px; }
.step__title { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:clamp(18px,2.5vw,24px); color:var(--color-text-primary); margin:0 0 10px; }
.step__body { font-size:var(--text-base); line-height:var(--leading-relaxed); color:var(--color-text-body); margin:0 0 10px; max-width:600px; }
.step__detail { display:flex; align-items:flex-start; gap:7px; font-size:13px; line-height:1.55; color:var(--color-text-muted); font-style:italic; margin:0; }
.step__detail svg { flex-shrink:0; margin-top:1px; }
/* -- Enquire strip -- */
.hiw-enquire { background:var(--color-green-dark); padding:40px 0; }
.hiw-enquire__inner { display:flex; align-items:center; justify-content:space-between; gap:32px; flex-wrap:wrap; max-width:var(--max-width); margin-inline:auto; padding-inline:var(--section-pad-x); box-sizing:border-box; }
.hiw-enquire__h2 { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:clamp(20px,2.5vw,28px); color:#fff; margin:0 0 6px; }
.hiw-enquire__text p { color:rgba(255,255,255,.8); margin:0; font-size:var(--text-base); }
.hiw-enquire__actions { display:flex; align-items:center; gap:16px; flex-wrap:wrap; }
.btn--wa-strip { display:inline-flex; align-items:center; gap:8px; background:#25d366; color:#0b2b14; font-weight:var(--weight-extrabold); padding:12px 22px; border-radius:var(--radius-lg); text-decoration:none; font-size:var(--text-sm); transition:opacity .2s ease; }
.btn--wa-strip:hover { opacity:.88; }
/* -- Why us -- */
.hiw-why { padding-block:var(--section-pad-y); }
.why-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:24px; margin-top:32px; }
.why-card { background:#fff; border-radius:14px; padding:26px 24px; box-shadow:0 2px 14px rgba(0,0,0,.06); border-top:3px solid var(--color-amber); display:flex; flex-direction:column; gap:12px; }
.why-card__icon { width:44px; height:44px; border-radius:10px; background:var(--color-parchment); display:flex; align-items:center; justify-content:center; }
.why-card__title { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:17px; color:var(--color-forest); margin:0; }
.why-card__text { font-size:var(--text-sm); line-height:var(--leading-relaxed); color:var(--color-text-body); margin:0; }
/* -- FAQ -- */
.hiw-faq { padding-block:var(--section-pad-y); }
.hiw-faq__inner { display:grid; grid-template-columns:240px 1fr; gap:56px; align-items:start; }
.hiw-faq__intro { position:sticky; top:96px; }
.hiw-faq__h2 { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-4xl); color:var(--color-text-primary); margin:6px 0 12px; line-height:var(--leading-snug); }
.hiw-faq__sub { font-size:var(--text-base); color:var(--color-text-body); line-height:var(--leading-relaxed); margin:0 0 20px; }
.hiw-faq__list { display:flex; flex-direction:column; gap:3px; }
.faq-item { border:1px solid var(--color-card-border); border-radius:var(--radius-lg); overflow:hidden; background:#fff; transition:border-color var(--transition-fast); }
.faq-item[open] { border-color:var(--color-amber); }
.faq-item__q { display:flex; justify-content:space-between; align-items:center; gap:14px; padding:16px 20px; font-weight:var(--weight-bold); font-size:var(--text-base); color:var(--color-forest); cursor:pointer; list-style:none; transition:background var(--transition-fast); line-height:var(--leading-normal); }
.faq-item__q::-webkit-details-marker { display:none; }
.faq-item__q:hover { background:var(--color-parchment); }
.faq-item[open] .faq-item__q { background:var(--color-parchment); color:var(--color-amber); border-bottom:1px solid var(--color-card-border); }
.faq-item__chevron { flex-shrink:0; color:var(--color-amber); transition:transform var(--transition-base); }
.faq-item[open] .faq-item__chevron { transform:rotate(180deg); }
.faq-item__a { padding:14px 20px 18px; font-size:var(--text-base); line-height:1.75; color:var(--color-text-body); }
