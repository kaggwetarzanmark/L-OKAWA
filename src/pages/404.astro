---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Page Not Found | L'okawa Tours & Travel"
  description="Sorry, the page you are looking for does not exist. Browse our Uganda gorilla trekking tours, Kenya safaris and East Africa travel packages."
>
  <section class="not-found">
    <div class="not-found__inner">

      <!-- Icon -->
      <div class="not-found__icon" aria-hidden="true">
        <svg width="80" height="80" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
          <circle cx="12" cy="12" r="10"/>
          <path d="M12 8v4M12 16h.01"/>
        </svg>
      </div>

      <!-- Heading -->
      <p class="not-found__code">404</p>
      <h1 class="not-found__title">Oops — looks like this trail went cold</h1>
      <p class="not-found__text">
        The page you're looking for doesn't exist or may have moved. Let's get you back on the right path.
      </p>

      <!-- CTAs -->
      <div class="btn-group not-found__btns">
        <a href="/" class="btn btn--primary btn--lg">Back to Home</a>
        <a href="/tours/" class="btn btn--secondary btn--lg">Browse Tours</a>
        <a href="/contact/" class="btn btn--outline btn--lg not-found__outline">Get in Touch</a>
      </div>

      <!-- Quick links -->
      <div class="not-found__links">
        <p class="not-found__links-label">Popular pages:</p>
        <div class="not-found__links-grid">
          <a href="/destinations/uganda/" class="not-found__link">Uganda Safaris</a>
          <a href="/destinations/kenya/" class="not-found__link">Kenya Safaris</a>
          <a href="/destinations/tanzania/" class="not-found__link">Tanzania Safaris</a>
          <a href="/destinations/rwanda/" class="not-found__link">Rwanda Gorillas</a>
          <a href="/tours/3-days-uganda-gorilla-safari/" class="not-found__link">3 Days Gorilla Safari</a>
          <a href="/plan/gorilla-permit-guide/" class="not-found__link">Gorilla Permit Guide</a>
          <a href="/plan/faq/" class="not-found__link">Safari FAQ</a>
          <a href="/reviews/" class="not-found__link">Traveler Reviews</a>
        </div>
      </div>

    </div>
  </section>
</BaseLayout>

<style>
.not-found {
  background: linear-gradient(180deg, var(--color-forest) 0%, var(--color-forest-mid) 50%, #2a4a1e 100%);
  min-height: calc(100vh - 200px);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: var(--section-pad-y) var(--section-pad-x);
  text-align: center;
}

.not-found__inner {
  max-width: 680px;
  width: 100%;
}

/* Icon */
.not-found__icon {
  color: var(--color-gold);
  margin-bottom: var(--space-6);
  display: flex;
  justify-content: center;
}

/* 404 number */
.not-found__code {
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
  font-size: 120px;
  line-height: 1;
  color: var(--color-amber);
  opacity: 0.25;
  margin-bottom: -20px;
  letter-spacing: -4px;
}

/* Heading */
.not-found__title {
  font-family: var(--font-display);
  font-weight: var(--weight-bold);
  font-size: var(--text-4xl);
  line-height: var(--leading-snug);
  color: var(--color-white);
  margin-bottom: var(--space-5);
}

/* Body text */
.not-found__text {
  font-size: var(--text-lg);
  line-height: var(--leading-relaxed);
  color: var(--color-cream);
  margin-bottom: var(--space-8);
  opacity: 0.9;
}

/* Buttons */
.not-found__btns {
  justify-content: center;
  margin-bottom: var(--space-12);
}

.not-found__outline {
  border-color: rgba(255,255,255,0.5);
}

/* Quick links */
.not-found__links {
  border-top: 1px solid rgba(255,255,255,0.15);
  padding-top: var(--space-8);
}

.not-found__links-label {
  font-size: var(--text-sm);
  font-weight: var(--weight-extrabold);
  letter-spacing: var(--tracking-widest);
  text-transform: uppercase;
  color: var(--color-gold);
  margin-bottom: var(--space-5);
}

.not-found__links-grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--space-3);
  justify-content: center;
}

.not-found__link {
  background: rgba(255,255,255,0.08);
  color: var(--color-cream);
  font-size: var(--text-base);
  font-weight: var(--weight-semibold);
  padding: 8px 16px;
  border-radius: var(--radius-full);
  border: 1px solid rgba(255,255,255,0.15);
  transition: background var(--transition-fast), color var(--transition-fast), border-color var(--transition-fast);
}

.not-found__link:hover {
  background: var(--color-amber);
  color: var(--color-forest-deep);
  border-color: var(--color-amber);
}

@media (max-width: 600px) {
  .not-found__code { font-size: 80px; }
  .not-found__title { font-size: var(--text-3xl); }
  .not-found__btns { flex-direction: column; align-items: center; }
  .not-found__btns .btn { width: 100%; text-align: center; }
}
</style>
