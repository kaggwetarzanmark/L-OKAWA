---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaBand    from '../../components/CtaBand.astro';

const photos = [
  { src: '/images/gorillas/gorilla-amber-eyes-closeup.jpg',      alt: 'Mountain gorilla close-up with amber eyes in Bwindi Uganda',                        category: 'gorillas',    caption: 'Gorilla Eye to Eye — Bwindi, Uganda' },
