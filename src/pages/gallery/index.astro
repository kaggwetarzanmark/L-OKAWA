  { src: '/images/wildlife/hippo-in-swamp.jpg',                  alt: 'Hippo resting in a swamp Uganda',                                                   category: 'wildlife',    caption: 'Swamp Rest — Uganda' },
  { src: '/images/wildlife/baby-hippos-lake.jpg',                alt: 'Baby hippos on the shores of a lake Uganda',                                        category: 'wildlife',    caption: 'Baby Hippos — Uganda' },
  { src: '/images/wildlife/kazinga-channel-boats.jpg',           alt: 'Kazinga Channel boat safari Queen Elizabeth Uganda',                                 category: 'wildlife',    caption: 'Kazinga Channel — Queen Elizabeth, Uganda' },
  { src: '/images/birds/shoebill-stork-uganda.jpg',              alt: 'Shoebill stork standing in wetland Uganda',                                         category: 'birds',       caption: 'Shoebill Stork — Uganda' },
  { src: '/images/birds/grey-headed-kingfisher.jpg',             alt: 'Grey-headed kingfisher perched on a branch Uganda',                                 category: 'birds',       caption: 'Grey-Headed Kingfisher — Uganda' },
