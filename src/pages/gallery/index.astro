  { src: '/images/destinations/kigali-genocide-memorial.jpg',    alt: 'Kigali Genocide Memorial Rwanda',                                                   category: 'destinations', caption: 'Kigali Genocide Memorial — Rwanda' },
  { src: '/images/destinations/source-of-nile-monument.jpg',     alt: 'Source of the Nile monument Jinja Uganda',                                          category: 'destinations', caption: 'Source of the Nile — Jinja, Uganda' },

  // EXPERIENCES
  { src: '/images/activities/safari-experience-1.jpg',           alt: 'L\'okawa Tours safari experience Uganda',                                            category: 'experiences',  caption: 'On Safari — Uganda' },
  { src: '/images/activities/safari-experience-2.jpg',           alt: 'L\'okawa Tours safari experience Uganda',                                            category: 'experiences',  caption: 'Safari Moment — Uganda' },
  { src: '/images/activities/safari-experience-3.jpg',           alt: 'L\'okawa Tours safari experience Uganda',                                            category: 'experiences',  caption: 'In the Field — Uganda' },
  { src: '/images/activities/safari-experience-4.jpg',           alt: 'L\'okawa Tours safari experience Uganda',                                            category: 'experiences',  caption: 'Safari Experience — Uganda' },
  { src: '/images/activities/safari-experience-5.jpg',           alt: 'L\'okawa Tours safari experience Uganda',                                            category: 'experiences',  caption: 'L\'okawa Safari — Uganda' },
  { src: '/images/activities/safari-experience-6.jpg',           alt: 'L\'okawa Tours safari experience Uganda',                                            category: 'experiences',  caption: 'Adventure Awaits — Uganda' },
];

const categories = [
  { id: 'all',          label: 'All Photos' },
  { id: 'gorillas',     label: 'Gorillas' },
  { id: 'primates',     label: 'Primates' },
  { id: 'wildlife',     label: 'Wildlife' },
  { id: 'birds',        label: 'Birds' },
  { id: 'activities',   label: 'Activities' },
  { id: 'experiences',  label: 'Experiences' },
  { id: 'lodges',       label: 'Lodges' },
  { id: 'destinations', label: 'Destinations' },
];

const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ImageGallery",
  "name": "L'okawa Tours Safari Photo Gallery",
  "description": "Wildlife and safari photography from Uganda, Kenya, Tanzania and Rwanda.",
  "url": "https://lokawatours.com/gallery/"
});
---

<BaseLayout
  title="Safari Photo Gallery — Uganda, Kenya & Rwanda Wildlife | L'okawa Tours"
  description="Browse our East Africa safari photo gallery. Mountain gorillas in Bwindi, chimpanzees in Kibale, Murchison Falls and more. Real photos from real safaris."
  schema={schema}
>

<div class="gal-banner">
  <div class="gal-banner__photo" aria-hidden="true"></div>
  <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" class="gal-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="200" r="100" fill="#ffd45a" opacity=".18"/>
    <circle cx="1130" cy="200" r="65"  fill="#ffd45a"/>
    <path d="M0 240 C220 210 400 236 580 214 C780 190 940 232 1140 212 C1280 198 1370 220 1440 214 L1440 300 L0 300Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 272 C240 252 440 272 660 262 C880 250 1100 274 1440 256 L1440 300 L0 300Z" fill="#0d1a0a"/>
  </svg>
  <div class="gal-banner__overlay" aria-hidden="true"></div>
  <div class="gal-banner__content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__cur">Gallery</span>
    </nav>
    <p class="gal-banner__kicker">Real photos from real safaris</p>
    <h1 class="gal-banner__h1">Safari Photo Gallery</h1>
    <p class="gal-banner__sub">Mountain gorillas, chimpanzees, big game, birds and landscapes from Uganda, Kenya, Tanzania and Rwanda.</p>
  </div>
</div>

<div class="gal-filters" id="gal-filters">
  <div class="container gal-filters__inner">
    <div class="gal-filter-pills" role="group" aria-label="Filter by category">
      {categories.map((c, i) => (
        <button class={`gal-pill ${i === 0 ? 'gal-pill--active' : ''}`} data-cat={c.id} type="button">{c.label}</button>
      ))}
    </div>
    <span class="gal-count" id="gal-count">{photos.length} photos</span>
  </div>
</div>

<section class="gal-section">
  <div class="container">
    <div class="gal-grid" id="gal-grid">
      {photos.map((p, i) => (
        <button class="gal-item" data-cat={p.category} data-index={String(i)} type="button" aria-label={`Open photo: ${p.caption}`}>
          <img src={p.src} alt={p.alt} class="gal-img" loading="lazy" width="600" height="400" />
          <div class="gal-overlay">
            <span class="gal-caption">{p.caption}</span>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          </div>
        </button>
      ))}
    </div>
    <div class="gal-empty" id="gal-empty">
      <p>No photos in this category.</p>
    </div>
  </div>
</section>

<!-- Lightbox -->
<div class="lb" id="lb">
  <div class="lb__backdrop" id="lb-backdrop"></div>
  <button class="lb__close" id="lb-close" type="button" aria-label="Close">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
  </button>
  <button class="lb__prev" id="lb-prev" type="button" aria-label="Previous">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
  </button>
  <div class="lb__stage">
    <img src="" alt="" class="lb__img" id="lb-img" />
    <p class="lb__caption" id="lb-caption"></p>
    <p class="lb__counter" id="lb-counter"></p>
  </div>
  <button class="lb__next" id="lb-next" type="button" aria-label="Next">
    <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
  </button>
</div>

<CtaBand
  heading="Inspired? Let's plan your safari."
  btn1="Get a Free Quote"
  btn1Href="/contact/"
  btn2="Browse Safari Packages"
  btn2Href="/tours/"
/>

<script>
(function() {
  var items   = Array.from(document.querySelectorAll('.gal-item'));
  var pills   = Array.from(document.querySelectorAll('.gal-pill'));
  var countEl = document.getElementById('gal-count');
  var emptyEl = document.getElementById('gal-empty');
  var lb      = document.getElementById('lb');
  var lbImg   = document.getElementById('lb-img');
  var lbCap   = document.getElementById('lb-caption');
  var lbCtr   = document.getElementById('lb-counter');
  var visible = items.slice();
  var current = 0;

  function applyFilter(cat) {
    visible = [];
    items.forEach(function(item) {
      var show = cat === 'all' || item.getAttribute('data-cat') === cat;
      item.style.display = show ? '' : 'none';
      if (show) visible.push(item);
    });
    if (countEl) countEl.textContent = visible.length + ' photo' + (visible.length !== 1 ? 's' : '');
    if (emptyEl) emptyEl.style.display = visible.length === 0 ? 'block' : 'none';
  }

  pills.forEach(function(pill) {
    pill.addEventListener('click', function() {
      pills.forEach(function(p) { p.classList.remove('gal-pill--active'); });
      pill.classList.add('gal-pill--active');
      applyFilter(pill.getAttribute('data-cat') || 'all');
    });
  });

  function openLb(idx) {
    current = idx;
    var item = visible[current];
    var img  = item.querySelector('img');
    var cap  = item.querySelector('.gal-caption');
    if (lbImg) { lbImg.src = img ? img.src : ''; lbImg.alt = img ? img.alt : ''; }
    if (lbCap) lbCap.textContent = cap ? cap.textContent : '';
    if (lbCtr) lbCtr.textContent = (current + 1) + ' / ' + visible.length;
    if (lb) lb.classList.add('lb--open');
    document.body.style.overflow = 'hidden';
  }

  function closeLb() {
    if (lb) lb.classList.remove('lb--open');
    document.body.style.overflow = '';
  }

  function navigate(dir) {
    current = (current + dir + visible.length) % visible.length;
    openLb(current);
  }

  items.forEach(function(item, i) {
    item.addEventListener('click', function() {
      var idx = visible.indexOf(item);
      if (idx !== -1) openLb(idx);
    });
  });

  var closeBtn   = document.getElementById('lb-close');
  var backdrop   = document.getElementById('lb-backdrop');
  var prevBtn    = document.getElementById('lb-prev');
  var nextBtn    = document.getElementById('lb-next');

  if (closeBtn)  closeBtn.addEventListener('click', closeLb);
  if (backdrop)  backdrop.addEventListener('click', closeLb);
  if (prevBtn)   prevBtn.addEventListener('click', function() { navigate(-1); });
  if (nextBtn)   nextBtn.addEventListener('click', function() { navigate(1); });

  document.addEventListener('keydown', function(e) {
    if (!lb || !lb.classList.contains('lb--open')) return;
    if (e.key === 'Escape')     closeLb();
    if (e.key === 'ArrowRight') navigate(1);
    if (e.key === 'ArrowLeft')  navigate(-1);
  });
})();
</script>

<style>
.breadcrumb { display:flex; flex-wrap:wrap; align-items:center; gap:6px 8px; font-size:13px; font-weight:600; color:var(--color-cream); margin-bottom:12px; }
.breadcrumb__link { color:var(--color-cream); text-decoration:none; }
.breadcrumb__link:hover { color:var(--color-gold); }
.breadcrumb__sep { opacity:.4; }
.breadcrumb__cur { color:var(--color-gold); }

.gal-banner { position:relative; overflow:hidden; min-height:280px; background:linear-gradient(180deg,#16290f 0%,#2f4d20 40%,#b8561a 82%,#f4b41a 100%); }
.gal-banner__photo { position:absolute; inset:0; background-image:url('/images/gorillas/four-gorillas-group.jpg'); background-size:cover; background-position:center 40%; opacity:.22; z-index:0; }
.gal-banner__svg { position:absolute; left:0; bottom:0; width:100%; height:100%; pointer-events:none; z-index:1; }
.gal-banner__overlay { position:absolute; inset:0; background:linear-gradient(90deg,rgba(10,20,8,.85) 0%,rgba(10,20,8,.45) 55%,rgba(10,20,8,0) 88%); z-index:1; }
.gal-banner__content { position:relative; z-index:2; max-width:var(--max-width); margin-inline:auto; padding:48px var(--section-pad-x) 72px; box-sizing:border-box; }
.gal-banner__kicker { font-family:var(--font-display); font-style:italic; font-size:20px; color:var(--color-gold); display:block; margin-bottom:6px; }
.gal-banner__h1 { font-family:var(--font-display); font-weight:700; font-size:clamp(32px,5vw,56px); line-height:1.05; color:#fff; margin:0 0 12px; }
.gal-banner__sub { font-size:var(--text-lg); color:var(--color-cream); opacity:.9; max-width:500px; line-height:1.6; }

.gal-filters { background:#fff; border-bottom:1px solid #e8ede4; position:sticky; top:0; z-index:40; }
.gal-filters__inner { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; padding:10px var(--section-pad-x); max-width:var(--max-width); margin-inline:auto; box-sizing:border-box; }
.gal-filter-pills { display:flex; flex-wrap:wrap; gap:8px; }
.gal-pill { padding:6px 16px; border-radius:20px; border:1.5px solid #dde8d4; background:#fff; font-size:13px; font-weight:600; color:var(--color-text); cursor:pointer; transition:all .2s; white-space:nowrap; }
.gal-pill:hover { border-color:var(--color-green-mid); color:var(--color-green-mid); }
.gal-pill--active { background:var(--color-green-dark); border-color:var(--color-green-dark); color:#fff; }
.gal-count { font-size:13px; font-weight:700; color:var(--color-text-muted); white-space:nowrap; }

.gal-section { background:#f4f8f0; padding:44px 0 64px; }
.gal-grid { columns:3; column-gap:14px; }
.gal-item { display:block; width:100%; break-inside:avoid; margin-bottom:14px; border-radius:10px; overflow:hidden; position:relative; cursor:zoom-in; background:none; border:none; padding:0; }
.gal-img { width:100%; height:auto; display:block; transition:transform .35s ease; }
.gal-item:hover .gal-img { transform:scale(1.04); }
.gal-overlay { position:absolute; inset:0; background:linear-gradient(to top,rgba(0,0,0,.7) 0%,rgba(0,0,0,0) 55%); opacity:0; transition:opacity .3s; display:flex; align-items:flex-end; justify-content:space-between; padding:12px 14px; gap:8px; }
.gal-item:hover .gal-overlay, .gal-item:focus .gal-overlay { opacity:1; }
.gal-caption { font-size:12px; font-weight:600; color:#fff; line-height:1.35; text-align:left; }
.gal-item:focus { outline:3px solid var(--color-amber); outline-offset:2px; }

.gal-empty { display:none; text-align:center; padding:60px 20px; color:var(--color-text-muted); font-size:var(--text-lg); }

/* Lightbox */
.lb { position:fixed; inset:0; z-index:9000; display:none; align-items:center; justify-content:center; padding:20px; }
.lb--open { display:flex; }
.lb__backdrop { position:absolute; inset:0; background:rgba(0,0,0,.93); z-index:0; cursor:pointer; }
.lb__stage { position:relative; z-index:2; display:flex; flex-direction:column; align-items:center; gap:10px; max-width:90vw; }
.lb__img { max-width:88vw; max-height:80vh; object-fit:contain; border-radius:8px; box-shadow:0 20px 60px rgba(0,0,0,.5); display:block; }
.lb__caption { color:#fff; font-size:15px; font-weight:600; text-align:center; margin:0; }
.lb__counter { color:rgba(255,255,255,.55); font-size:12px; letter-spacing:.08em; margin:0; }
.lb__close { position:fixed; top:18px; right:22px; z-index:3; background:rgba(255,255,255,.15); border:none; border-radius:50%; width:44px; height:44px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:#fff; transition:background .2s; }
.lb__close:hover { background:rgba(255,255,255,.3); }
.lb__prev, .lb__next { position:fixed; top:50%; transform:translateY(-50%); z-index:3; background:rgba(255,255,255,.15); border:none; border-radius:50%; width:50px; height:50px; cursor:pointer; display:flex; align-items:center; justify-content:center; color:#fff; transition:background .2s; }
.lb__prev:hover, .lb__next:hover { background:rgba(255,255,255,.3); }
.lb__prev { left:14px; }
.lb__next { right:14px; }

@media (max-width:900px) { .gal-grid { columns:2; } }
@media (max-width:560px) { .gal-grid { columns:1; } .gal-filters__inner { flex-direction:column; align-items:flex-start; } }
</style>
</BaseLayout>
