const faqs = [
  { q: 'What makes this different from the 9-day itinerary?', a: 'The extra day adds Lake Mburo National Park at the end, which is the only park in western Uganda with zebras and impalas. It also allows an extra night at Murchison Falls, giving more time on the north bank and for the Nile boat safari without rushing.' },
