    { label: 'Starts', value: 'Entebbe' },
    { label: 'Ends', value: 'Entebbe' },
    { label: 'Accommodation', value: 'Lodge' },
  ],
  overview: [
    'Ten days allows a thorough and unhurried experience of Uganda\'s full wildlife offering. This itinerary adds Lake Mburo National Park to the classic circuit, giving you zebras, impalas, topis and hippos in a compact acacia savannah just 3 hours from Kampala.',
    'The route runs north to south: Murchison Falls for big game and the Nile boat safari, then Kibale Forest for chimpanzees, then Queen Elizabeth for the Kazinga Channel and Ishasha lions, then Bwindi for gorillas, and finally Lake Mburo as a gentle final park before returning to Entebbe.',
    'This is the itinerary that most comprehensively covers Uganda in under two weeks. With two nights at the key destinations, nothing feels rushed and you have time to absorb each park properly.',
  ],
};
const itinerary = [
  { day: 1, title: 'Entebbe to Ziwa and Murchison Falls', body: 'Depart Entebbe after breakfast. Drive north via Kampala. Stop at Ziwa Rhino Sanctuary for a guided rhino tracking walk — the only place in Uganda with wild white rhinos. Continue to Murchison Falls National Park. Dinner and overnight.' },
  { day: 2, title: 'Murchison Falls Game Drive', body: 'Full day game drives on the north bank of the Nile. Lions, Rothschild\'s giraffes, elephants, buffaloes and large herds of Uganda kobs. Optional guided hike to the top of Murchison Falls. Dinner and overnight Murchison.' },
  { day: 3, title: 'Murchison Nile Boat Safari', body: 'Morning game drive. Afternoon boat safari along the Nile to the base of Murchison Falls. Hippos and crocodiles line the banks. Shoebill stork on the delta. The falls thunder directly above the boat. Dinner and overnight Murchison.' },
  { day: 4, title: 'Murchison to Kibale Forest', body: 'Drive south to Fort Portal and Kibale Forest (approximately 5 hours). Arrive afternoon. Optional afternoon crater lake walk around the Kibale area. Briefing for tomorrow\'s chimpanzee trek. Dinner and overnight Kibale.' },
  { day: 5, title: 'Chimpanzee Trekking in Kibale', body: '7:00am briefing at Kanyanchu. Track habituated chimpanzees — Uganda has the highest density of chimps on the continent. One hour with the community. Return for lunch. Afternoon Bigodi Wetland walk. Dinner and overnight Kibale.' },
  { day: 6, title: 'Kibale to Queen Elizabeth National Park', body: 'Morning drive via Kasese to Queen Elizabeth National Park, Mweya sector. Afternoon game drive through the Kasenyi plains. Check in. Dinner and overnight.' },
