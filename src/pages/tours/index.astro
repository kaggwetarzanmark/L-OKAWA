const categories = [
  { id: 'all',       label: 'All Safaris' },
  { id: 'gorillas',  label: 'Gorilla Trekking' },
  { id: 'wildlife',  label: 'Wildlife' },
  { id: 'primates',  label: 'Primates' },
  { id: 'adventure', label: 'Adventure' },
  { id: 'leisure',   label: 'Beach / Leisure' },
];

