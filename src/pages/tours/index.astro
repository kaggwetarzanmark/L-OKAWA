---

<BaseLayout
  title="East Africa Safari Packages 2025/2026 | L'okawa Tours Uganda"
  description="Browse 32 East Africa safari packages to Uganda gorilla trekking, Kenya Masai Mara, Tanzania Serengeti and Rwanda. All-inclusive prices from USD 350. Expert guides, all permits included."
  schema={schema}
>

<!-- --------------------------------------------
     BANNER
-------------------------------------------- -->
<div class="tours-banner">
  <div class="tours-banner__photo" aria-hidden="true"></div>
  <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" class="tours-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="200" r="100" fill="#ffd45a" opacity=".18"/>
    <circle cx="1130" cy="200" r="65"  fill="#ffd45a"/>
    <path d="M0 240 C220 210 400 236 580 214 C780 190 940 232 1140 212 C1280 198 1370 220 1440 214 L1440 300 L0 300Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 272 C240 252 440 272 660 262 C880 250 1100 274 1440 256 L1440 300 L0 300Z" fill="#0d1a0a"/>
  </svg>
  <div class="tours-banner__overlay" aria-hidden="true"></div>
  <div class="tours-banner__content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__cur">Tours</span>
    </nav>
    <p class="tours-banner__kicker">32 handpicked itineraries</p>
    <h1 class="tours-banner__h1">East Africa<br/>Safari Packages</h1>
    <p class="tours-banner__sub">Uganda gorilla trekking, Kenya Masai Mara, Tanzania Serengeti and Rwanda to every itinerary built around your dates, budget and the wildlife you want to see.</p>
    <div class="tours-banner__stats">
      <div class="tours-stat"><strong>32</strong><span>Safari packages</span></div>
      <div class="tours-stat"><strong>4</strong><span>Countries</span></div>
      <div class="tours-stat"><strong>From $350</strong><span>Per person</span></div>
      <div class="tours-stat"><strong>Gorilla permits</strong><span>Booked for you</span></div>
    </div>
  </div>
</div>

<!-- --------------------------------------------
     FILTER BAR
-------------------------------------------- -->
<div class="tours-filters" id="tours-filters">
  <div class="container tours-filters__inner">
    <!-- Category pills -->
    <div class="tours-filters__cats" role="group" aria-label="Filter by activity">
      {categories.map((c, i) => (
        <button
          class={`filter-pill ${i === 0 ? 'filter-pill--active' : ''}`}
          data-filter={c.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {c.label}
        </button>
      ))}
    </div>
    <!-- Country select -->
    <div class="tours-filters__right">
      <label for="country-filter" class="sr-only">Filter by country</label>
      <select id="country-filter" class="country-select" aria-label="Filter by country">
        {countries.map(c => <option value={c}>{c}</option>)}
      </select>
      <span class="tours-count" id="tours-count">{tours.length} tours</span>
    </div>
  </div>
</div>

<!-- --------------------------------------------
     TOUR GRID
-------------------------------------------- -->
<section class="tours-grid-section" aria-label="Safari packages">
  <div class="container">
    <div class="tours-grid" id="tours-grid">
      {tours.map(t => (
        <article
          class="tcard"
          data-category={t.category}
          data-country={t.country}
        >
          <a href={`/tours/${t.slug}/`} class="tcard__img-link" tabindex="-1" aria-hidden="true">
            <img src={t.img} alt={t.imgAlt} class="tcard__img" loading="lazy" width="480" height="280"/>
            <span class="tcard__tag">{t.tag}</span>
            <span class="tcard__days">{t.days} Days</span>
          </a>
          <div class="tcard__body">
            <div class="tcard__meta">
              <span class="tcard__country">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
                {t.country}
              </span>
            </div>
            <h2 class="tcard__title">
              <a href={`/tours/${t.slug}/`} class="tcard__title-link">{t.title}</a>
            </h2>
            <div class="tcard__footer">
              <div class="tcard__price">
                <span class="tcard__price-label">est. price</span>
                <span class="tcard__amount">{t.price}</span>
                <span class="tcard__pp">pp</span>
              </div>
              <a href={`/tours/${t.slug}/`} class="btn btn--primary btn--sm">View Tour</a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- No results message (hidden by default) -->
    <div class="tours-empty" id="tours-empty" aria-live="polite">
      <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--color-green-mid)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><line x1="21" y1="21" x2="16.65" y2="16.65"/></svg>
      <p>No tours match your filter. <button class="tours-empty__reset" id="reset-filters">Reset filters</button></p>
    </div>
  </div>
</section>

<!-- --------------------------------------------
     CUSTOM SAFARI STRIP
-------------------------------------------- -->
<section class="tours-custom" aria-labelledby="custom-heading">
  <div class="container tours-custom__inner">
    <div class="tours-custom__text">
      <span class="kicker">Don't see what you need?</span>
      <h2 id="custom-heading" class="tours-custom__h2">We Build Custom Safaris Too</h2>
      <p>Every itinerary on this page can be modified. Want more nights, a different park, a different budget? Tell us your dates, group size and interests and we will build a tailored itinerary within 24 hours to no obligation.</p>
      <div class="tours-custom__actions">
        <a href="/contact/" class="btn btn--primary">Get a Custom Quote</a>
        <a href="https://wa.me/256761512966" target="_blank" rel="noopener noreferrer" class="btn btn--wa">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          WhatsApp Us
        </a>
      </div>
    </div>
    <div class="tours-custom__img" aria-hidden="true">
      <img src="/images/gorillas/gorilla-amber-eyes-closeup.jpg" alt="" width="420" height="340" loading="lazy"/>
    </div>
  </div>
</section>

<CtaBand
  heading="Not sure which safari is right for you?"
  btn1="Talk to Our Team"
  btn1Href="/contact/"
  btn2="Read Planning Guides"
  btn2Href="/plan/"
/>

</BaseLayout>

<!-- --------------------------------------------
     FILTER SCRIPT
-------------------------------------------- -->
<script>
  const grid      = document.getElementById('tours-grid');
  const empty     = document.getElementById('tours-empty');
  const countEl   = document.getElementById('tours-count');
  const pills     = document.querySelectorAll('.filter-pill');
  const countryEl = document.getElementById('country-filter') as HTMLSelectElement;
  const resetBtn  = document.getElementById('reset-filters');

  let activeCategory = 'all';
  let activeCountry  = 'All Countries';

  function applyFilters() {
    const cards = grid!.querySelectorAll<HTMLElement>('.tcard');
    let visible = 0;
    cards.forEach(card => {
      const cat     = card.dataset.category ?? '';
      const country = card.dataset.country   ?? '';
      const catMatch     = activeCategory === 'all' || cat === activeCategory;
      const countryMatch = activeCountry  === 'All Countries' || country === activeCountry;
      const show = catMatch && countryMatch;
      card.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    countEl!.textContent = `${visible} tour${visible !== 1 ? 's' : ''}`;
    empty!.style.display = visible === 0 ? 'flex' : 'none';
  }

  pills.forEach(pill => {
    pill.addEventListener('click', () => {
      pills.forEach(p => { p.classList.remove('filter-pill--active'); p.setAttribute('aria-pressed','false'); });
      pill.classList.add('filter-pill--active');
      pill.setAttribute('aria-pressed','true');
      activeCategory = (pill as HTMLElement).dataset.filter ?? 'all';
      applyFilters();
    });
  });

  countryEl?.addEventListener('change', () => {
    activeCountry = countryEl.value;
    applyFilters();
  });

  resetBtn?.addEventListener('click', () => {
    activeCategory = 'all';
    activeCountry  = 'All Countries';
    countryEl!.value = 'All Countries';
    pills.forEach(p => { p.classList.remove('filter-pill--active'); p.setAttribute('aria-pressed','false'); });
    pills[0]?.classList.add('filter-pill--active');
    pills[0]?.setAttribute('aria-pressed','true');
    applyFilters();
  });
</script>

<style>
/* -- Banner -- */
.tours-banner {
  position:relative; overflow:hidden; min-height:340px;
  background:linear-gradient(180deg,#16290f 0%,#2f4d20 40%,#b8561a 82%,#f4b41a 100%);
}
.tours-banner__photo {
  position:absolute; inset:0;
  background-image:url('/images/gorillas/gorilla-mother-baby-bwindi.jpg');
  background-size:cover; background-position:center 30%;
  opacity:.2; z-index:0;
}
.tours-banner__svg { position:absolute; left:0; bottom:0; width:100%; height:100%; pointer-events:none; z-index:1; }
.tours-banner__overlay { position:absolute; inset:0; background:linear-gradient(90deg,rgba(10,20,8,.85) 0%,rgba(10,20,8,.5) 55%,rgba(10,20,8,0) 88%); z-index:1; }
.tours-banner__content { position:relative; z-index:2; max-width:var(--max-width); margin-inline:auto; padding:56px var(--section-pad-x) 80px; box-sizing:border-box; }
.tours-banner__kicker { font-family:var(--font-display); font-style:italic; font-weight:500; font-size:20px; color:var(--color-gold); margin-bottom:6px; display:block; }
.tours-banner__h1 { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:clamp(34px,5vw,60px); line-height:1.05; color:var(--color-white); margin:0 0 14px; }
.tours-banner__sub { font-size:var(--text-lg); color:var(--color-cream); opacity:.9; max-width:540px; line-height:var(--leading-relaxed); margin-bottom:28px; }
.tours-banner__stats { display:flex; flex-wrap:wrap; gap:24px; }
.tours-stat { display:flex; flex-direction:column; gap:2px; }
.tours-stat strong { font-family:var(--font-display); font-size:22px; font-weight:var(--weight-bold); color:var(--color-gold); }
.tours-stat span { font-size:12px; font-weight:var(--weight-semibold); color:var(--color-cream); opacity:.8; letter-spacing:.05em; text-transform:uppercase; }
/* -- Breadcrumb -- */
