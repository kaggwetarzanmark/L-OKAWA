const faqs = [
  { q: 'When is Kilimanjaro most visible from Amboseli?', a: 'Kilimanjaro is clearest in the early morning before clouds build around the summit. The best months are January and February (short dry season) when humidity is lowest. July to October is also generally clear. The mountain is often visible for the first 2 hours after sunrise even during the rainy season.' },
