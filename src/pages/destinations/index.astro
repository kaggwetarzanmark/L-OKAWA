---
import BaseLayout from '../../layouts/BaseLayout.astro';

// ── Country data ──────────────────────────────────────────────
const countries = [
  {
    name:     'Uganda',
    slug:     'uganda',
    tagline:  'The Pearl of Africa',
    intro:    'Home to more than half the world\'s remaining mountain gorillas, Uganda rewards visitors with primate encounters, dramatic waterfalls, tree-climbing lions and over 1,066 bird species in a compact, accessible landscape.',
    img:      '/images/gorillas/four-gorillas-group.jpg',
    imgAlt:   'Silverback mountain gorilla family in Bwindi Impenetrable National Park Uganda',
    bestTime: 'Jun–Sep & Dec–Feb',
    topParks: ['Bwindi Impenetrable NP', 'Queen Elizabeth NP', 'Murchison Falls NP', 'Kibale Forest NP'],
    highlight:'Gorilla trekking from USD 800',
    tours:    8,
    flag:     'UG',
  },
  {
    name:     'Kenya',
    slug:     'kenya',
    tagline:  'Home of the Masai Mara',
    intro:    'Kenya delivers the classic African safari — wide open savannah, the Great Wildebeest Migration, prides of lions on the Masai Mara plains, and elephants silhouetted against Mount Kilimanjaro in Amboseli.',
    img:      '/images/wildlife/safari-vehicle-lions.jpg',
    imgAlt:   'Safari vehicle with lions on the open plains of Kenya Masai Mara game drive',
    bestTime: 'Jul–Oct (Migration)',
    topParks: ['Masai Mara National Reserve', 'Amboseli National Park', 'Tsavo National Park', 'Lake Nakuru NP'],
    highlight:'Big Five game drives from USD 899',
    tours:    2,
    flag:     'KE',
  },
  {
    name:     'Tanzania',
    slug:     'tanzania',
    tagline:  'Land of the Serengeti',
    intro:    'Tanzania holds Africa\'s largest concentration of wildlife. The endless Serengeti plains, the Ngorongoro Crater — the world\'s largest intact caldera — and Zanzibar\'s white-sand beaches make it one of Africa\'s most complete safari destinations.',
    img:      '/images/wildlife/lion-on-rock-kidepo.jpg',
    imgAlt:   'Male lion on a rock at sunset in Tanzania savannah landscape',
    bestTime: 'Jun–Oct & Jan–Mar',
    topParks: ['Serengeti National Park', 'Ngorongoro Crater', 'Tarangire National Park', 'Zanzibar'],
    highlight:'Serengeti safari from USD 1,200',
    tours:    2,
    flag:     'TZ',
  },
  {
    name:     'Rwanda',
    slug:     'rwanda',
    tagline:  'Land of a Thousand Hills',
    intro:    'Rwanda offers some of the most accessible gorilla trekking in Africa, with shorter treks to habituated families in Volcanoes National Park, golden monkey encounters and a modern, well-organised tourism infrastructure.',
    img:      '/images/primates/golden-monkey-mother-baby.jpg',
    imgAlt:   'Golden monkey mother and baby in Volcanoes National Park Rwanda gorilla trekking',
    bestTime: 'Jun–Sep & Dec–Feb',
    topParks: ['Volcanoes National Park', 'Nyungwe Forest NP', 'Akagera National Park'],
    highlight:'Gorilla trekking from USD 1,500',
    tours:    1,
    flag:     'RW',
  },
];

// ── Why East Africa highlights ─────────────────────────────────
const highlights = [
  { icon: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z', title: '4 Countries', text: 'Uganda, Kenya, Tanzania and Rwanda — all covered in one operator.' },
  { icon: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z',                   title: '19 Parks',   text: 'National parks and reserves hand-picked for the best wildlife experiences.' },
  { icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',                                     title: 'Local Guides', text: 'Born and raised in East Africa. Every guide knows every road.' },
  { icon: 'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',                                                                      title: 'All Permits', text: 'Gorilla and chimp permits sourced and included for you.' },
];

// ── JSON-LD schema ─────────────────────────────────────────────
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "East Africa Safari Destinations",
  "description": "Safari destinations across Uganda, Kenya, Tanzania and Rwanda covered by L'okawa Tours and Travel.",
  "itemListElement": countries.map((c, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "TouristDestination",
      "name": c.name,
      "url": `https://lokawatours.com/destinations/${c.slug}/`,
      "description": c.intro,
      "touristType": "Wildlife Safari"
    }
  }))
});
---

<BaseLayout
  title="Safari Destinations in East Africa | Uganda, Kenya, Tanzania & Rwanda | L'okawa Tours"
  description="Explore East Africa's best safari destinations. Uganda gorilla trekking, Kenya's Masai Mara, Tanzania's Serengeti and Rwanda's Volcanoes National Park. Expert-guided tours from L'okawa."
  ogImage="/images/gorillas/four-gorillas-group.jpg"
  schema={schema}
>

<!-- ════════════════════════════════════════════════════
     PAGE BANNER
════════════════════════════════════════════════════ -->
<div class="dest-banner">
  <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" class="dest-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="200" r="100" fill="#ffd45a" opacity=".2"/>
    <circle cx="1130" cy="200" r="65"  fill="#ffd45a"/>
    <path d="M0 240 C220 210 400 236 580 214 C780 190 940 232 1140 212 C1280 198 1370 220 1440 214 L1440 300 L0 300Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 272 C240 252 440 272 660 262 C880 250 1100 274 1440 256 L1440 300 L0 300Z" fill="#0d1a0a"/>
    <g fill="#0d1a0a"><rect x="1246" y="186" width="8" height="80"/><ellipse cx="1250" cy="180" rx="76" ry="20"/><ellipse cx="1200" cy="192" rx="44" ry="12"/><ellipse cx="1300" cy="190" rx="44" ry="12"/></g>
  </svg>
  <div class="dest-banner__overlay" aria-hidden="true"></div>
  <div class="dest-banner__content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__cur">Destinations</span>
    </nav>
    <p class="dest-banner__kicker">Explore East Africa</p>
    <h1 class="dest-banner__h1">Safari Destinations</h1>
    <p class="dest-banner__sub">4 countries. 19 national parks. One operator who knows them all.</p>
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     INTRO + WHY EAST AFRICA
════════════════════════════════════════════════════ -->
<section class="dh-intro section">
  <div class="container dh-intro__grid">
    <div class="dh-intro__text">
      <span class="kicker">Why East Africa?</span>
      <h2 class="dh-intro__heading">The World's Greatest Wildlife on One Continent</h2>
      <p class="body-lg">East Africa is the only place on earth where you can trek wild mountain gorillas in ancient rainforest in the morning and watch a pride of lions hunt on open savannah in the afternoon. Uganda, Kenya, Tanzania and Rwanda each offer something the others cannot — and L'okawa Tours covers all four.</p>
      <p class="body-lg dh-intro__p2">Choose a single country for a focused safari, or combine two or three for the complete East Africa experience. Every itinerary we build starts with what you most want to see.</p>
      <a href="/contact/" class="btn btn--primary btn--lg">Plan Your East Africa Safari</a>
    </div>
    <div class="dh-intro__highlights">
      {highlights.map(h => (
        <div class="dh-highlight">
          <div class="dh-highlight__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="var(--color-amber)" aria-hidden="true"><path d={h.icon}/></svg>
          </div>
          <div>
            <div class="dh-highlight__title">{h.title}</div>
            <div class="dh-highlight__text">{h.text}</div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     COUNTRY CARDS
════════════════════════════════════════════════════ -->
<section class="dh-countries section--parchment" aria-labelledby="countries-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">Choose your destination</span>
      <h2 id="countries-heading">Explore by Country</h2>
      <div class="section-heading__divider"></div>
    </div>

    <div class="country-cards">
      {countries.map((c, i) => (
        <article class={`country-card ${i % 2 === 1 ? 'country-card--reverse' : ''}`}>
          <!-- Image -->
          <a href={`/destinations/${c.slug}/`} class="country-card__img-wrap" aria-label={`Explore ${c.name} safaris`} tabindex="-1">
            <img src={c.img} alt={c.imgAlt} class="country-card__img" loading="lazy"/>
            <div class="country-card__img-overlay"></div>
            <div class="country-card__flag-badge" aria-hidden="true">
              <span class="country-card__flag-code">{c.flag}</span>
            </div>
          </a>

          <!-- Content -->
          <div class="country-card__body">
            <div class="country-card__meta">
              <span class="country-card__tours badge">{c.tours} tour{c.tours > 1 ? 's' : ''}</span>
              <span class="country-card__time">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
                Best: {c.bestTime}
              </span>
            </div>

            <p class="country-card__kicker">{c.tagline}</p>
            <h3 class="country-card__name">
              <a href={`/destinations/${c.slug}/`} class="country-card__link">{c.name}</a>
            </h3>
            <p class="country-card__intro">{c.intro}</p>

            <!-- Top parks -->
            <div class="country-card__parks">
              <span class="country-card__parks-label">Top parks:</span>
              <div class="country-card__parks-list">
                {c.topParks.map(p => (
                  <span class="country-card__park-chip">{p}</span>
                ))}
              </div>
            </div>

            <div class="country-card__footer">
              <span class="country-card__price">{c.highlight}</span>
              <a href={`/destinations/${c.slug}/`} class="btn btn--secondary">
                Explore {c.name}
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     NOT SURE WHERE TO GO
════════════════════════════════════════════════════ -->
<section class="dh-unsure section">
  <div class="container dh-unsure__inner">
    <div class="dh-unsure__text">
      <span class="kicker">Not sure where to start?</span>
      <h2 class="dh-unsure__heading">Let Us Build Your Perfect Itinerary</h2>
      <p class="body-lg">Tell us your interests, budget and how many days you have. We will suggest the right country, the right parks and the right pace — no obligation, no sales pressure.</p>
    </div>
    <div class="btn-group">
      <a href="/contact/"    class="btn btn--primary btn--lg">Talk to Our Experts</a>
      <a href="/tours/"      class="btn btn--secondary btn--lg">Browse All Tours</a>
    </div>
  </div>
</section>

<!-- CTA band -->
<div class="dh-cta">
  <div class="container dh-cta__inner">
    <h2 class="dh-cta__heading">Ready for Your East Africa Safari?</h2>
    <a href="/contact/" class="btn dh-cta__btn">Get a Free Quote</a>
  </div>
</div>

</BaseLayout>

<style>
/* ── Banner ──────────────────────────────────────── */
.dest-banner {
  position: relative; overflow: hidden; min-height: 280px;
  background: linear-gradient(180deg, #16290f 0%, #2f4d20 40%, #b8561a 82%, #f4b41a 100%);
}
.dest-banner::before {
  content: ''; position: absolute; inset: 0;
  background-image: url('/images/gorillas/gorilla-amber-eyes-closeup.jpg');
  background-size: cover; background-position: center 30%;
  opacity: 0.22; z-index: 0;
}
.dest-banner__svg    { position: absolute; left:0; bottom:0; width:100%; height:100%; pointer-events:none; z-index:1; }
.dest-banner__overlay{ position: absolute; inset:0; background: linear-gradient(90deg,rgba(10,20,8,.82) 0%,rgba(10,20,8,.4) 55%,rgba(10,20,8,0) 85%); z-index:1; }
.dest-banner__content{ position:relative; z-index:2; max-width:var(--max-width); margin-inline:auto; padding:56px var(--section-pad-x) 72px; box-sizing:border-box; }
.dest-banner__kicker { font-family:var(--font-display); font-style:italic; font-weight:500; font-size:20px; color:var(--color-gold); margin-bottom:4px; display:block; }
.dest-banner__h1     { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:clamp(38px,5vw,60px); line-height:1.05; color:var(--color-white); margin:0 0 12px; }
.dest-banner__sub    { font-size:var(--text-lg); color:var(--color-cream); opacity:.9; max-width:480px; line-height:var(--leading-relaxed); }

/* ── Breadcrumb ──────────────────────────────────── */
.breadcrumb { display:flex; align-items:center; gap:8px; font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-cream); margin-bottom:14px; }
.breadcrumb__link { color:var(--color-cream); transition:color var(--transition-fast); }
.breadcrumb__link:hover { color:var(--color-gold); }
.breadcrumb__sep { opacity:.4; }
.breadcrumb__cur { color:var(--color-gold); }

/* ── Intro section ───────────────────────────────── */
.dh-intro__grid { display:flex; flex-wrap:wrap; gap:56px; align-items:center; }
.dh-intro__text { flex:1 1 480px; min-width:0; }
.dh-intro__heading { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-5xl); line-height:var(--leading-snug); text-transform:uppercase; color:var(--color-text-primary); margin:8px 0 22px; }
.dh-intro__p2 { margin:14px 0 28px; }
.dh-intro__highlights { flex:1 1 380px; display:flex; flex-direction:column; gap:20px; }
.dh-highlight { display:flex; gap:14px; align-items:flex-start; background:var(--color-white); border-radius:var(--radius-lg); padding:18px; box-shadow:var(--shadow-card); border-left:3px solid var(--color-amber); }
.dh-highlight__icon { width:42px; height:42px; border-radius:var(--radius-lg); background:var(--color-parchment); display:flex; align-items:center; justify-content:center; flex-shrink:0; }
.dh-highlight__title { font-weight:var(--weight-extrabold); font-size:var(--text-base); color:var(--color-forest); margin-bottom:2px; }
.dh-highlight__text  { font-size:var(--text-sm); color:var(--color-text-muted); line-height:1.55; }

/* ── Country cards ───────────────────────────────── */
.dh-countries { padding-block: var(--section-pad-y); }
.country-cards { display:flex; flex-direction:column; gap:48px; margin-top:8px; }
.country-card {
  display:flex; flex-wrap:wrap; gap:0;
  background:var(--color-white); border-radius:var(--radius-xl);
  box-shadow:var(--shadow-card-md); overflow:hidden;
}
.country-card--reverse { flex-direction:row-reverse; }

/* Image side */
.country-card__img-wrap { flex:1 1 360px; position:relative; min-height:320px; display:block; overflow:hidden; }
.country-card__img {
  position: absolute;    /* take the image out of flow */
  inset: 0;              /* stretch to all four edges of the wrapper */
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform .5s ease;
}
.country-card__img-wrap:hover .country-card__img { transform:scale(1.04); }
.country-card__img-overlay { position:absolute; inset:0; background:linear-gradient(180deg,transparent 50%,rgba(10,20,8,.5) 100%); }
.country-card__flag-badge {
  position:absolute; top:16px; left:16px;
  background:var(--color-forest); color:var(--color-gold);
  border-radius:var(--radius-sm); padding:4px 10px;
  font-weight:var(--weight-extrabold); font-size:13px; letter-spacing:.1em;
}

/* Body side */
.country-card__body { flex:1 1 380px; padding:36px 36px 32px; display:flex; flex-direction:column; gap:14px; }
.country-card__meta { display:flex; align-items:center; gap:12px; flex-wrap:wrap; }
.country-card__tours { background:var(--color-amber); color:var(--color-forest-deep); }
.country-card__time { display:flex; align-items:center; gap:5px; font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-text-muted); }
.country-card__kicker { font-family:var(--font-display); font-style:italic; font-weight:500; font-size:18px; color:var(--color-amber); }
.country-card__name { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-5xl); line-height:1.05; color:var(--color-forest); text-transform:uppercase; margin:0; }
.country-card__link { color:inherit; transition:color var(--transition-fast); }
.country-card__link:hover { color:var(--color-amber); }
.country-card__intro { font-size:var(--text-base); line-height:var(--leading-loose); color:var(--color-text-body); flex:1; }

/* Top parks chips */
.country-card__parks { display:flex; flex-direction:column; gap:8px; }
.country-card__parks-label { font-size:var(--text-xs); font-weight:var(--weight-extrabold); letter-spacing:var(--tracking-widest); text-transform:uppercase; color:var(--color-text-muted); }
.country-card__parks-list { display:flex; flex-wrap:wrap; gap:6px; }
.country-card__park-chip { background:var(--color-parchment); border:1px solid var(--color-card-border); border-radius:var(--radius-full); padding:4px 10px; font-size:var(--text-xs); font-weight:var(--weight-semibold); color:var(--color-text-body); white-space:nowrap; }

/* Footer row */
.country-card__footer { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; padding-top:16px; border-top:1px solid var(--color-card-border); }
.country-card__price { font-size:var(--text-sm); font-weight:var(--weight-bold); color:var(--color-forest); }
.country-card__footer .btn { display:inline-flex; align-items:center; gap:6px; }

/* ── Not sure section ────────────────────────────── */
.dh-unsure__inner { display:flex; flex-wrap:wrap; gap:32px; align-items:center; justify-content:space-between; }
.dh-unsure__text  { flex:1 1 480px; }
.dh-unsure__heading { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-4xl); line-height:var(--leading-snug); color:var(--color-text-primary); margin:8px 0 16px; }

/* ── CTA band ────────────────────────────────────── */
.dh-cta { background:linear-gradient(135deg,var(--color-forest) 0%,var(--color-forest-mid) 100%); }
.dh-cta__inner { display:flex; flex-wrap:wrap; gap:20px 32px; justify-content:space-between; align-items:center; padding:64px var(--section-pad-x); }
.dh-cta__heading { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:var(--text-4xl); line-height:1.1; color:var(--color-white); }
.dh-cta__btn { background:var(--color-amber); color:var(--color-forest-deep); font-weight:var(--weight-extrabold); font-size:14px; letter-spacing:var(--tracking-widest); text-transform:uppercase; padding:18px 34px; border-radius:var(--radius-md); transition:opacity var(--transition-fast); }
.dh-cta__btn:hover { opacity:.88; }

/* ── Responsive ──────────────────────────────────── */
@media (max-width: 900px) {
  .dh-intro__highlights { display:grid; grid-template-columns:1fr 1fr; }
  .country-card, .country-card--reverse { flex-direction:column; }
  /* Fixed height on mobile so object-fit:cover works correctly when stacked */
  .country-card__img-wrap { flex:none; width:100%; height:260px; min-height:0; }
  .country-card__body { padding:24px; }
}
@media (max-width: 600px) {
  .dest-banner__content { padding:48px 24px 64px; }
  .dh-intro__highlights { grid-template-columns:1fr; }
  .dh-cta__inner { flex-direction:column; text-align:center; padding:48px 24px; }
  .dh-unsure__inner { flex-direction:column; }
  .country-card__name { font-size:var(--text-4xl); }
}
</style>
