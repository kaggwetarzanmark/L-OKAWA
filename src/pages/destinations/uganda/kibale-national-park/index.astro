const park = {
  name: 'Kibale Forest National Park',
  country: 'Uganda',
  countrySlug: 'uganda',
  slug: 'kibale-national-park',
  tagline: 'Africa\'s Primate Capital — Over 1,500 Wild Chimpanzees',
  heroImg: '/images/primates/chimpanzee-kibale-forest.jpg',
  heroImgAlt: 'Wild chimpanzee in the canopy of Kibale Forest National Park Uganda',
  description: 'Complete guide to chimpanzee trekking in Kibale Forest National Park Uganda. Africa\'s best chimpanzee habitat with 13 primate species. Permits, best time and safari packages from L\'okawa Tours.',
  bannerSub: 'Uganda\'s primate paradise — 13 species including over 1,500 habituated chimpanzees in the world\'s most productive chimp trekking destination.',
