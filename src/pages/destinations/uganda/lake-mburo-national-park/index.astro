import ParkPage from '../../../../components/ParkPage.astro';

const park = {
  name: 'Lake Mburo National Park',
  country: 'Uganda',
  countrySlug: 'uganda',
  slug: 'lake-mburo-national-park',
  tagline: 'Uganda\'s Most Accessible Safari - Zebras, Hippos and 332 Birds',
  heroImg: '/images/wildlife/hippo-in-water-closeup.jpg',
  heroImgAlt: 'Hippo close-up at Lake Mburo National Park Uganda',
  description: 'Complete guide to Lake Mburo National Park Uganda. Zebras, impalas, hippos, boat safari and walking safaris just 3 hours from Kampala. Safari packages from L\'okawa Tours.',
  bannerSub: 'Uganda\'s most accessible national park - zebras, impalas, hippos and 332 bird species just 3 hours from Kampala on the western highway.',
  priceLabel: 'Park entry USD 40 / person / day',
  priceNote: 'Boat ride, walking safari and game drives available. Packages from USD 380.',
  intro: [
    'Lake Mburo National Park is the most accessible national park in Uganda, located just 240km from Kampala on the main road to western Uganda. The compact 370 km- park is built around five interconnected lakes and is the only national park in Uganda with both zebras and impalas - species more commonly associated with the Kenyan and Tanzanian savannah.',
    'Lake Mburo punches well above its weight for wildlife density. The acacia savannah and woodland support large numbers of topis, elands, buffaloes, warthogs and the elusive sitatunga antelope in the wetland areas. The five lakes support enormous hippo populations, large Nile crocodiles and exceptional waterbirds including the African fish eagle.',
    'Unlike Uganda\'s larger parks, Lake Mburo permits activities not available elsewhere: walking safaris with armed rangers inside the park, mountain biking along designated trails, and horse riding through the acacia woodland. These activities make Lake Mburo an excellent choice for travellers wanting to engage with the landscape on foot rather than only from a vehicle.',
  ],
  sidebarLinks: [
    { label: 'Best time to visit Uganda', href: '/plan/best-time-to-visit-uganda/' },
    { label: 'Is Uganda safe?', href: '/plan/is-uganda-safe/' },
    { label: 'Safari packing list', href: '/plan/safari-packing-list/' },
    { label: 'How much does a safari cost?', href: '/plan/safari-cost-guide/' },
  ],
};

