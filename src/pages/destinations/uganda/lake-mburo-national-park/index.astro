const activities = [
  { icon: 'M9 20l-5.447-2.724A1 1 0 0 1 3 16.382V5.618a1 1 0 0 1 1.447-.894L9 7m0 13l6-3m-6 3V7', title: 'Boat Safari on Lake Mburo', text: '2-hour boat safari on Lake Mburo. Hippos at very close range, large Nile crocodiles, African fish eagles and excellent waterbirds. USD 30 per person.' },
  { icon: 'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z', title: 'Game Drives', text: 'Morning and evening game drives for zebras, impalas, topis, elands, buffaloes and warthogs across the acacia savannah. Night game drives available for hyenas and genets.' },
  { icon: 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z', title: 'Walking Safari', text: 'Guided walking safari inside the park with an armed ranger. The only large Uganda park where walking safaris are offered inside the park boundaries.' },
  { icon: 'M3 3l18 18M3 9l18 18', title: 'Horse Riding', text: 'Guided horse riding through the acacia woodland along the lake shores. Available at select lodges. One of the few parks in Uganda where this is offered.' },
  { icon: 'M12 3l2.6 5.6 6 .7-4.4 4.1 1.2 6L12 16.6 6.6 19.4l1.2-6L3.4 9.3l6-.7z', title: 'Birding', text: '332 bird species including rare papyrus specialists in the wetlands. Shoebill stork occasionally sighted. Excellent year-round birding from the lake shores.' },
  { icon: 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z', title: 'Night Game Drive', text: 'Guided night game drive to see nocturnal wildlife: hyenas, genets, bush babies and the rare African civet. Available from select lodges.' },
