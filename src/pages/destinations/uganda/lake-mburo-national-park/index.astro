const tours = [
  { title: '2 Days Lake Mburo National Park Safari', slug: '2-days-lake-mburo-national-park-safari', days: 2, price: 'From $380', img: '/images/wildlife/hippo-entering-water.jpg', imgAlt: 'Hippo Lake Mburo Uganda' },
  { title: '4 Days Bwindi Gorillas and Lake Mburo', slug: '4-days-bwindi-gorillas-lake-mburo', days: 4, price: 'From $1,700', img: '/images/gorillas/gorilla-amber-eyes-closeup.jpg', imgAlt: 'Gorilla trekking Uganda' },
  { title: '10 Days Uganda Wildlife Grand Circuit', slug: '10-days-uganda-wildlife-gorilla-chimp-safari', days: 10, price: 'From $3,800', img: '/images/wildlife/elephant-pair-greeting.jpg', imgAlt: 'Elephants Uganda safari' },
