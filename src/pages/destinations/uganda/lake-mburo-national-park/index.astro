  { label: 'Bird species', value: '332' },
  { label: 'Distance from Kampala', value: 'Approx 240km, 3 hrs' },
  { label: 'Best time', value: 'Year-round' },
  { label: 'Nearest airport', value: 'Entebbe (EBB), ~3.5 hrs' },
