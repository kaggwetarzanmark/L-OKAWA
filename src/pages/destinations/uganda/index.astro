---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import CtaBand from '../../../components/CtaBand.astro';

// ══════════════════════════════════════════════════════════════
//  COUNTRY DATA — Uganda
//  Duplicate this file for Kenya / Tanzania / Rwanda,
//  swap every value below, update the import depth if needed.
// ══════════════════════════════════════════════════════════════

const country = {
  name:        'Uganda',
  slug:        'uganda',
  tagline:     'The Pearl of Africa',
  description: 'Plan your Uganda safari with L\'okawa Tours. Gorilla trekking in Bwindi, game drives in Queen Elizabeth, chimpanzees in Kibale and boat cruises on the Nile. Expert guides and all permits included.',
  heroImg:     '/images/gorillas/silverback-gorilla-group.jpg',
  heroImgAlt:  'Silverback mountain gorilla family in Bwindi Impenetrable National Park Uganda',
  intro: [
    'Uganda is Africa\'s most biodiverse safari destination, packing gorilla trekking, chimpanzee tracking, Big Five game drives and world-class birding into a country smaller than the United Kingdom. More than half the world\'s remaining mountain gorillas live in Uganda\'s Bwindi Impenetrable and Mgahinga National Parks.',
    'Known as the Pearl of Africa — a title coined by Winston Churchill — Uganda rewards visitors with dramatic landscapes from the rainforests of Bwindi to the thundering Nile at Murchison Falls and the papyrus wetlands along Lake Victoria. Over 1,066 bird species have been recorded here, more than in all of North America.',
    'L\'okawa Tours is a Uganda-based operator with intimate on-the-ground knowledge of every park, sector and lodge in the country. We secure gorilla and chimpanzee permits directly and build itineraries around your dates, budget and the wildlife you most want to encounter.',
  ],
};

// ── Quick facts ───────────────────────────────────────────────
const facts = [
  { label: 'Capital',      value: 'Kampala' },
  { label: 'Currency',     value: 'UGX (USD accepted)' },
  { label: 'Language',     value: 'English, Swahili' },
  { label: 'Timezone',     value: 'EAT (UTC+3)' },
  { label: 'Gorilla permit', value: 'USD 800 / person' },
  { label: 'Best months',  value: 'Jun–Sep, Dec–Feb' },
  { label: 'Visa',         value: 'e-Visa online, USD 50' },
  { label: 'Flights to',   value: 'Entebbe (EBB)' },
];

// ── National parks ────────────────────────────────────────────
const parks = [
  {
    name:    'Bwindi Impenetrable National Park',
    slug:    'bwindi-impenetrable-national-park',
    img:     '/images/gorillas/gorilla-mother-baby-bwindi.jpg',
    imgAlt:  'Mountain gorilla mother and baby in Bwindi Impenetrable National Park Uganda',
    tag:     'Gorilla Trekking',
    teaser:  'Home to 19 habituated gorilla families. The number one reason to visit Uganda.',
    permit:  'USD 800',
  },
  {
    name:    'Queen Elizabeth National Park',
    slug:    'queen-elizabeth-national-park',
    img:     '/images/wildlife/tree-climbing-lion-ishasha.jpg',
    imgAlt:  'Tree-climbing lion in Ishasha sector Queen Elizabeth National Park Uganda',
    tag:     'Game Drives',
    teaser:  'Tree-climbing lions, Kazinga Channel boat cruise and over 600 bird species.',
    permit:  'USD 40 / day',
  },
  {
    name:    'Murchison Falls National Park',
    slug:    'murchison-falls-national-park',
    img:     '/images/wildlife/giraffe-uganda-murchison.jpg',
    imgAlt:  'Rothschild giraffe in Murchison Falls National Park Uganda safari game drive',
    tag:     'Game Drives',
    teaser:  'The world\'s most powerful waterfall, Nile boat cruises and rhino tracking.',
    permit:  'USD 40 / day',
  },
  {
    name:    'Kibale Forest National Park',
    slug:    'kibale-national-park',
    img:     '/images/primates/chimpanzees-pair-feeding.jpg',
    imgAlt:  'Wild chimpanzees feeding in Kibale Forest National Park Uganda primate safari',
    tag:     'Chimp Trekking',
    teaser:  'Africa\'s primate capital — over 1,500 wild chimpanzees in habituated communities.',
    permit:  'USD 200',
  },
  {
    name:    'Mgahinga Gorilla National Park',
    slug:    'mgahinga-gorilla-national-park',
    img:     '/images/primates/golden-monkey-bamboo.jpg',
    imgAlt:  'Golden monkey walking through bamboo in Mgahinga Gorilla National Park Uganda Rwanda border',
    tag:     'Gorilla & Golden Monkeys',
    teaser:  'Gorilla trekking and golden monkey tracking on the Virunga volcanoes border.',
    permit:  'USD 800',
  },
  {
    name:    'Lake Mburo National Park',
    slug:    'lake-mburo-national-park',
    img:     '/images/wildlife/hippos-in-grass-kazinga.jpg',
    imgAlt:  'Hippos resting in grass near Lake Mburo National Park Uganda safari',
    tag:     'Wildlife',
    teaser:  'Uganda\'s most accessible park. Zebras, hippos, antelopes and 332 bird species.',
    permit:  'USD 40 / day',
  },
  {
    name:    'Kidepo Valley National Park',
    slug:    'kidepo-valley-national-park',
    img:     '/images/wildlife/lion-kidepo-rock-sunset.jpg',
    imgAlt:  'Male lion resting on a rock at sunset in Kidepo Valley National Park Uganda',
    tag:     'Remote Wilderness',
    teaser:  'Uganda\'s most remote and wild park. Cheetahs, ostriches and dramatic savannah.',
    permit:  'USD 40 / day',
  },
  {
    name:    'Rwenzori Mountains',
    slug:    'rwenzori-mountains',
    img:     '/images/accommodation/rwenzori-mountains-glacier-hike.jpg',
    imgAlt:  'Hikers climbing the Rwenzori Mountains glacier Uganda Mountains of the Moon',
    tag:     'Hiking',
    teaser:  'The Mountains of the Moon. Glaciers, unique afro-alpine flora and Margherita Peak.',
    permit:  'USD 40 / day',
  },
];

// ── Tours in Uganda ───────────────────────────────────────────
const tours = [
  { title:'3 Days Uganda Gorilla Safari',            slug:'3-days-uganda-gorilla-safari',            days:3,  price:'From $1,400', img:'/images/gorillas/gorilla-amber-eyes-closeup.jpg',   imgAlt:'Mountain gorilla with amber eyes Bwindi Uganda' },
  { title:'5 Days Uganda Primates Safari',           slug:'5-days-uganda-primates-safari',           days:5,  price:'From $2,100', img:'/images/primates/chimpanzees-pair-feeding.jpg',     imgAlt:'Chimpanzees feeding Kibale Forest Uganda' },
  { title:'7 Days Uganda Wildlife Safari',           slug:'7-days-uganda-gorilla-chimp-wildlife-safari', days:7, price:'From $2,800', img:'/images/gorillas/gorilla-mother-baby-bwindi.jpg',imgAlt:'Gorilla mother and baby Bwindi Uganda' },
  { title:'3 Days Murchison Falls Safari',           slug:'3-days-murchison-falls-safari',           days:3,  price:'From $650',   img:'/images/wildlife/giraffe-uganda-murchison.jpg',     imgAlt:'Giraffe Murchison Falls National Park Uganda' },
  { title:'3 Days Queen Elizabeth Safari',           slug:'3-days-queen-elizabeth-national-park-safari', days:3, price:'From $600', img:'/images/wildlife/tree-climbing-lion-ishasha.jpg',  imgAlt:'Tree climbing lion Ishasha Queen Elizabeth NP' },
  { title:'9 Days Uganda Grand Safari',              slug:'9-days-uganda-safari',                    days:9,  price:'From $3,200', img:'/images/wildlife/elephant-pair-greeting.jpg',       imgAlt:'Elephants greeting Uganda wildlife safari' },
];

// ── Best time grid ────────────────────────────────────────────
const months = [
  { name:'Jan', rating:3, note:'Short rains ending' },
  { name:'Feb', rating:5, note:'Dry — excellent' },
  { name:'Mar', rating:2, note:'Long rains begin' },
  { name:'Apr', rating:1, note:'Heavy rain' },
  { name:'May', rating:1, note:'Wettest month' },
  { name:'Jun', rating:5, note:'Peak dry season' },
  { name:'Jul', rating:5, note:'Peak dry season' },
  { name:'Aug', rating:5, note:'Peak dry season' },
  { name:'Sep', rating:4, note:'Still dry' },
  { name:'Oct', rating:2, note:'Short rains' },
  { name:'Nov', rating:2, note:'Short rains' },
  { name:'Dec', rating:4, note:'Dry season returns' },
];

// ── Travel essentials ─────────────────────────────────────────
const essentials = [
  { icon:'M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z M12 10a2 2 0 1 0 0-4 2 2 0 0 0 0 4', title:'Visa', text:'Apply online at the Uganda e-Visa portal before travel. USD 50 for single entry (90 days). East Africa Tourist Visa (USD 100) covers Uganda, Kenya and Rwanda.',  link:'/plan/uganda-visa/' },
  { icon:'M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z',                                       title:'Safety', text:'Uganda is one of the safest countries in East Africa for tourists. Parks are well-patrolled by Uganda Wildlife Authority rangers.', link:'/plan/is-uganda-safe/' },
  { icon:'M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 0 0 1.946-.806 3.42 3.42 0 0 1 4.438 0 3.42 3.42 0 0 0 1.946.806 3.42 3.42 0 0 1 3.138 3.138 3.42 3.42 0 0 0 .806 1.946 3.42 3.42 0 0 1 0 4.438 3.42 3.42 0 0 0-.806 1.946 3.42 3.42 0 0 1-3.138 3.138 3.42 3.42 0 0 0-1.946.806 3.42 3.42 0 0 1-4.438 0 3.42 3.42 0 0 0-1.946-.806 3.42 3.42 0 0 1-3.138-3.138 3.42 3.42 0 0 0-.806-1.946 3.42 3.42 0 0 1 0-4.438 3.42 3.42 0 0 0 .806-1.946 3.42 3.42 0 0 1 3.138-3.138z', title:'Health', text:'Yellow Fever vaccination is mandatory. Malaria prophylaxis strongly recommended. Consult your GP 4–6 weeks before travel.', link:'/plan/uganda-travel-tips/' },
  { icon:'M20 6h-2.18c.07-.44.18-.88.18-1 0-2.21-1.79-4-4-4s-4 1.79-4 4c0 .12.11.56.18 1H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm-6-3c1.1 0 2 .9 2 2s-.9 2-2 2-2-.9-2-2 .9-2 2-2zm0 13l-4-4 1.41-1.41L14 13.17l5.59-5.59L21 9l-7 7z', title:'What to Pack', text:'Long-sleeved neutral clothing, waterproof hiking boots, rain jacket, garden gloves and a walking stick for gorilla trekking.', link:'/plan/gorilla-trekking-packing-list/' },
];

// ── FAQ ───────────────────────────────────────────────────────
const faqs = [
  { q:'How much does a Uganda gorilla trekking permit cost?',       a:'A Uganda gorilla trekking permit costs USD 800 per person for foreign non-residents. During the low season months of April, May and November it is discounted to USD 600.' },
  { q:'What is the best time to visit Uganda for a safari?',        a:'The best times are the two dry seasons: June to September and December to February. Gorilla trekking is possible year-round, but trails are drier and easier during these months.' },
  { q:'How many days do I need for a Uganda safari?',               a:'A minimum of 3 days covers a single activity such as gorilla trekking. For gorilla trekking, chimp tracking and a game drive, plan 7 to 10 days. Our most popular itinerary is 7 days.' },
  { q:'Is Uganda safe for tourists?',                               a:'Yes. Uganda is one of the safest countries in East Africa for travelers. National parks are patrolled by Uganda Wildlife Authority rangers. Standard travel awareness applies.' },
  { q:'Do I need a visa to visit Uganda?',                          a:'Most nationalities need a visa, available online via the Uganda e-Visa portal. The standard tourist visa costs USD 50. The East Africa Tourist Visa (USD 100) covers Uganda, Kenya and Rwanda.' },
];

// ── JSON-LD ───────────────────────────────────────────────────
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type":"ListItem","position":1,"name":"Home","item":"https://lokawatours.com/" },
        { "@type":"ListItem","position":2,"name":"Destinations","item":"https://lokawatours.com/destinations/" },
        { "@type":"ListItem","position":3,"name":"Uganda","item":"https://lokawatours.com/destinations/uganda/" }
      ]
    },
    {
      "@type": "TouristDestination",
      "name": "Uganda",
      "url": "https://lokawatours.com/destinations/uganda/",
      "description": country.description,
      "touristType": ["Wildlife Safari","Gorilla Trekking","Primate Safari"],
      "includesAttraction": parks.map(p => ({
        "@type": "TouristAttraction",
        "name": p.name,
        "url": `https://lokawatours.com/destinations/uganda/${p.slug}/`
      }))
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type":"Answer","text":f.a }
      }))
    }
  ]
});
---

<BaseLayout
  title="Uganda Safari Tours & Packages 2025/2026 | L'okawa Tours"
  description="Plan your Uganda safari with L'okawa Tours. Gorilla trekking in Bwindi, chimp tracking in Kibale, game drives in Queen Elizabeth and Murchison Falls. Expert guides, all permits included."
  ogImage={country.heroImg}
  schema={schema}
>

<!-- ════════════════════════════════════════════════════
     BANNER
════════════════════════════════════════════════════ -->
<div class="cp-banner">
  <div class="cp-banner__photo" aria-hidden="true" style={`background-image:url('${country.heroImg}')`}></div>
  <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" class="cp-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="200" r="100" fill="#ffd45a" opacity=".2"/>
    <circle cx="1130" cy="200" r="65"  fill="#ffd45a"/>
    <path d="M0 240 C220 210 400 236 580 214 C780 190 940 232 1140 212 C1280 198 1370 220 1440 214 L1440 300 L0 300Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 272 C240 252 440 272 660 262 C880 250 1100 274 1440 256 L1440 300 L0 300Z" fill="#0d1a0a"/>
  </svg>
  <div class="cp-banner__overlay" aria-hidden="true"></div>
  <div class="cp-banner__content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a href="/destinations/" class="breadcrumb__link">Destinations</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__cur">{country.name}</span>
    </nav>
    <p class="cp-banner__kicker">{country.tagline}</p>
    <h1 class="cp-banner__h1">{country.name} Safaris</h1>
    <p class="cp-banner__sub">Gorilla trekking, chimpanzee tracking, game drives and more — expertly guided from Kampala.</p>
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     QUICK FACTS STRIP
════════════════════════════════════════════════════ -->
<div class="cp-facts" aria-label="Uganda quick facts">
  <div class="container cp-facts__inner">
    {facts.map(f => (
      <div class="cp-fact">
        <span class="cp-fact__label">{f.label}</span>
        <span class="cp-fact__value">{f.value}</span>
      </div>
    ))}
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     INTRO
════════════════════════════════════════════════════ -->
<section class="cp-intro section">
  <div class="container cp-intro__grid">
    <div class="cp-intro__text">
      <span class="kicker">About {country.name}</span>
      <h2 class="cp-intro__heading">Why Visit Uganda?</h2>
      {country.intro.map(p => <p class="body-lg cp-intro__p">{p}</p>)}
      <div class="btn-group cp-intro__ctas">
        <a href="/contact/" class="btn btn--primary btn--lg">Plan Your Uganda Safari</a>
        <a href="#parks"    class="btn btn--secondary btn--lg">See National Parks</a>
      </div>
    </div>
    <aside class="cp-intro__sidebar">
      <div class="cp-sidebar-card">
        <div class="cp-sidebar-card__head">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--color-amber)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
          Quick Quote
        </div>
        <p class="cp-sidebar-card__text">Tell us your dates and interests. We will have a tailored Uganda itinerary in your inbox within 24 hours.</p>
        <a href="/contact/" class="btn btn--primary" style="width:100%;text-align:center;">Get a Free Quote</a>
        <a href="https://wa.me/256761512966" target="_blank" rel="noopener noreferrer" class="cp-sidebar-wa">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          Chat on WhatsApp
        </a>
      </div>
    </aside>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     NATIONAL PARKS
════════════════════════════════════════════════════ -->
<section id="parks" class="cp-parks section--parchment" aria-labelledby="parks-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">Where to go in Uganda</span>
      <h2 id="parks-heading">Uganda's Top National Parks</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="parks-grid">
      {parks.map(p => (
        <a href={`/destinations/uganda/${p.slug}/`} class="park-card" aria-label={`Explore ${p.name}`}>
          <div class="park-card__img-wrap">
            <img src={p.img} alt={p.imgAlt} class="park-card__img" loading="lazy"/>
            <span class="badge park-card__tag">{p.tag}</span>
          </div>
          <div class="park-card__body">
            <h3 class="park-card__name">{p.name}</h3>
            <p class="park-card__teaser">{p.teaser}</p>
            <div class="park-card__footer">
              <span class="park-card__permit">Permit: {p.permit}</span>
              <span class="park-card__arrow arrow-circle">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     TOURS IN UGANDA
════════════════════════════════════════════════════ -->
<section class="cp-tours section" aria-labelledby="tours-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">Ready-made itineraries</span>
      <h2 id="tours-heading">Uganda Safari Packages</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="cp-tours-grid">
      {tours.map(t => (
        <article class="tour-card">
          <a href={`/tours/${t.slug}/`} class="tour-card__img-link" tabindex="-1" aria-hidden="true">
            <img src={t.img} alt={t.imgAlt} class="tour-card__img" loading="lazy"/>
            <span class="badge tour-card__badge">{t.days} Days</span>
          </a>
          <div class="tour-card__body">
            <h3 class="tour-card__title"><a href={`/tours/${t.slug}/`} class="tour-card__title-link">{t.title}</a></h3>
            <div class="tour-card__footer">
              <span class="tour-card__meta">{t.days} Days &middot; {t.price}</span>
              <a href={`/tours/${t.slug}/`} class="arrow-circle" aria-label={`View ${t.title}`}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div style="text-align:center;margin-top:36px;">
      <a href="/tours/" class="btn btn--secondary btn--lg">View All Uganda Tours</a>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     BEST TIME TO VISIT
════════════════════════════════════════════════════ -->
<section class="cp-besttime section--parchment" aria-labelledby="besttime-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">When to go</span>
      <h2 id="besttime-heading">Best Time to Visit Uganda</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="month-grid" role="list" aria-label="Monthly safari conditions in Uganda">
      {months.map(m => (
        <div class={`month-cell month-cell--${m.rating}`} role="listitem">
          <span class="month-cell__name">{m.name}</span>
          <div class="month-cell__bars" aria-hidden="true">
            {[1,2,3,4,5].map(n => (
              <span class={`month-cell__bar ${n <= m.rating ? 'month-cell__bar--filled' : ''}`}></span>
            ))}
          </div>
          <span class="month-cell__note">{m.note}</span>
        </div>
      ))}
    </div>
    <p class="cp-besttime__note">
      <strong>Gorilla trekking is possible year-round.</strong> Dry seasons (Jun–Sep and Dec–Feb) offer easier trails and better forest visibility. Low-season permits (Apr, May, Nov) are discounted to USD 600.
      <a href="/plan/best-time-to-visit-uganda/" class="cp-besttime__link">Full best-time guide &rarr;</a>
    </p>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     TRAVEL ESSENTIALS
════════════════════════════════════════════════════ -->
<section class="cp-essentials section" aria-labelledby="essentials-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">Before you go</span>
      <h2 id="essentials-heading">Uganda Travel Essentials</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="essentials-grid">
      {essentials.map(e => (
        <div class="essential-card">
          <div class="essential-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={e.icon}/></svg>
          </div>
          <h3 class="essential-card__title">{e.title}</h3>
          <p class="essential-card__text">{e.text}</p>
          <a href={e.link} class="essential-card__link">Learn more &rarr;</a>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     FAQ
════════════════════════════════════════════════════ -->
<section class="cp-faq section--parchment" aria-labelledby="faq-heading">
