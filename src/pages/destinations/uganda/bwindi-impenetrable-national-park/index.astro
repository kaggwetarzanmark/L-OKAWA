---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import CtaBand from '../../../../components/CtaBand.astro';

// ══════════════════════════════════════════════════════════════
//  PARK DATA — Bwindi Impenetrable National Park
//  Copy this file for each national park, update all values.
//  Import depth: 4 levels → '../../../../layouts/BaseLayout.astro'
// ══════════════════════════════════════════════════════════════

const park = {
  name:        'Bwindi Impenetrable National Park',
  country:     'Uganda',
  countrySlug: 'uganda',
  slug:        'bwindi-impenetrable-national-park',
  tagline:     'The Home of Mountain Gorillas',
  heroImg:     '/images/gorillas/gorilla-amber-eyes-closeup.jpg',
  heroImgAlt:  'Mountain gorilla close-up with amber eyes in Bwindi Impenetrable National Park Uganda',
  description: 'Complete guide to gorilla trekking in Bwindi Impenetrable National Park, Uganda. Park sectors, permits, best time to visit and safari packages from L\'okawa Tours.',
  intro: [
    'Bwindi Impenetrable National Park is one of the most biologically diverse forests on earth and the world\'s most important gorilla habitat. Located in southwestern Uganda on the edge of the Albertine Rift Valley, this 331 km² ancient rainforest is home to over half the world\'s remaining wild mountain gorillas. The park currently has 19 habituated gorilla families available for trekking across four main sectors.',
    'The experience of trekking through Bwindi\'s dense, equatorial forest and coming face-to-face with a wild mountain gorilla family is consistently rated one of the most powerful wildlife encounters on earth. Gorillas share 98% of their DNA with humans, and the hour you spend watching a silverback guard his family, a mother nurse her infant and juveniles play in the undergrowth is unlike anything else in Africa.',
    'Beyond the gorillas, Bwindi is a paradise for birders (348 species, 23 of them Albertine Rift endemics), botanists (163 tree species, 1,000 flowering plants) and hikers. The Batwa Trail offers a profound cultural encounter with the indigenous forest people who called Bwindi home for millennia before it became a national park.',
  ],
};

// ── Quick facts ───────────────────────────────────────────────
const facts = [
  { label: 'Location',      value: 'SW Uganda, Albertine Rift' },
  { label: 'Area',          value: '331 km²' },
  { label: 'Altitude',      value: '1,160 – 2,607m' },
  { label: 'Gorilla permit',value: 'USD 800 (low season USD 600)' },
  { label: 'Max group size',value: '8 people per family' },
  { label: 'Time with gorillas', value: '1 hour' },
  { label: 'Best time',     value: 'Jun–Sep, Dec–Feb' },
  { label: 'Nearest airport', value: 'Entebbe (EBB), ~9 hrs' },
];

// ── Sectors ───────────────────────────────────────────────────
const sectors = [
  { name:'Buhoma (North)', families:'4 families', note:'Most accessible. Starting point for most 3-day safaris from Kampala.' },
  { name:'Ruhija (East)',  families:'4 families', note:'Highest altitude (2,350m). Best for serious birders and photographers.' },
  { name:'Rushaga (South)',families:'7 families', note:'Largest sector. Home to the Gorilla Habituation Experience (GHEX, USD 1,500).' },
  { name:'Nkuringo (South)',families:'4 families', note:'Remote and dramatic crater views. Good for combining with Kigali arrivals.' },
];

// ── Activities ────────────────────────────────────────────────
const activities = [
  { icon:'M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 0 1 0-5 2.5 2.5 0 0 1 0 5z', title:'Gorilla Trekking', text:'Trek 1 of 19 habituated gorilla families. USD 800 per person. 2–8 hours in the forest, 1 hour with the gorillas.' },
  { icon:'M4 8h3l2-3h6l2 3h3a1 1 0 0 1 1 1v9a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9a1 1 0 0 1 1-1zM12 10.5a3 3 0 1 0 0 6 3 3 0 0 0 0-6z', title:'Gorilla Habituation', text:'4 hours with a gorilla family still being habituated. USD 1,500. Available in Rushaga sector only.' },
  { icon:'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2M9 7a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',                                        title:'Batwa Cultural Trail', text:'Walk with the Batwa guides through the forest. Learn about their ancestral home, traditional medicine and hunting. Included with gorilla trekking.' },
  { icon:'M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z M9 22V12h6v10',                                                      title:'Village Walk', text:'Visit local communities around Bwindi. Meet farmers, weavers and craftspeople. Supports community conservation.' },
  { icon:'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z',                     title:'Forest Birding Walk', text:'Bwindi has 348 bird species including 23 Albertine Rift endemics. 2–4 hour guided birding walk at dawn.' },
  { icon:'M21 3L10 14M21 3l-7 18-4-7-7-4 18-7z',                                                                                title:'Waterfall Hike', text:'Hike to Munyaga River waterfall through the forest. Half-day guided walk from the Buhoma sector.' },
];

// ── Tours visiting this park ───────────────────────────────────
const tours = [
  { title:'3 Days Uganda Gorilla Safari',             slug:'3-days-uganda-gorilla-safari',             days:3,  price:'From $1,400', img:'/images/gorillas/gorilla-amber-eyes-closeup.jpg',   imgAlt:'Mountain gorilla amber eyes Bwindi Uganda' },
  { title:'4 Days Gorilla Trekking & Lake Bunyonyi',  slug:'4-days-gorilla-trekking-lake-bunyonyi',   days:4,  price:'From $1,800', img:'/images/gorillas/gorilla-mother-baby-bwindi.jpg',   imgAlt:'Gorilla mother baby Bwindi Uganda' },
  { title:'5 Days Uganda Primates Safari',            slug:'5-days-uganda-primates-safari',           days:5,  price:'From $2,100', img:'/images/primates/chimpanzees-pair-feeding.jpg',     imgAlt:'Chimpanzees Kibale Forest Uganda' },
  { title:'4 Days Double Gorilla Trekking',           slug:'4-days-double-gorilla-trekking-bwindi',   days:4,  price:'From $2,400', img:'/images/gorillas/silverback-gorilla-group.jpg',     imgAlt:'Silverback gorilla group Bwindi Uganda' },
  { title:'7 Days Uganda Wildlife Safari',            slug:'7-days-uganda-gorilla-chimp-wildlife-safari', days:7, price:'From $2,800', img:'/images/wildlife/tree-climbing-lion-ishasha.jpg',imgAlt:'Tree climbing lion Ishasha Uganda' },
  { title:'9 Days Uganda Grand Safari',               slug:'9-days-uganda-safari',                    days:9,  price:'From $3,200', img:'/images/wildlife/elephant-pair-greeting.jpg',       imgAlt:'Elephants Uganda wildlife safari' },
];

// ── FAQ ───────────────────────────────────────────────────────
const faqs = [
  { q:'How much does gorilla trekking in Bwindi cost?',           a:'A gorilla trekking permit at Bwindi Impenetrable National Park costs USD 800 per person for foreign non-residents. During low season (April, May and November) the price is USD 600. The permit includes park entry, a ranger guide and one hour with the gorillas.' },
  { q:'Which sector of Bwindi should I choose?',                  a:'Buhoma is the most accessible (best for 3-day trips from Kampala). Rushaga has the most families and the Habituation Experience. Nkuringo is the best option if you are coming from Kigali. Ruhija is the highest altitude and best for birding. L\'okawa will recommend the right sector based on your itinerary.' },
  { q:'How difficult is gorilla trekking in Bwindi?',             a:'Trekking in Bwindi ranges from moderate to strenuous. The forest is steep and often muddy at altitudes of 1,500m to 2,500m. Treks last 2 to 8 hours depending on the gorilla family\'s location. Porters are available for USD 15–20 and are highly recommended. Walking sticks are provided free.' },
  { q:'Is gorilla trekking guaranteed in Bwindi?',                a:'Yes — the success rate is over 99%. Gorilla families are habituated to human presence and tracked by rangers daily. Each group is allowed a maximum of 8 visitors per day for exactly 1 hour.' },
  { q:'What is the best time to visit Bwindi?',                   a:'Gorilla trekking is possible all year. The best conditions are during Uganda\'s dry seasons: June to September and December to February, when trails are drier and easier to navigate. The wet seasons are quieter and permits are discounted to USD 600 in April, May and November.' },
  { q:'Can I combine Bwindi with other Uganda parks?',            a:'Yes — most L\'okawa itineraries combine Bwindi with one or two other parks. Popular combinations include Bwindi + Queen Elizabeth (tree-climbing lions), Bwindi + Kibale Forest (chimpanzee tracking) and Bwindi + Lake Bunyonyi (relaxation after trekking).' },
];

// ── JSON-LD ───────────────────────────────────────────────────
const schema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type":"ListItem","position":1,"name":"Home","item":"https://lokawatours.com/" },
        { "@type":"ListItem","position":2,"name":"Destinations","item":"https://lokawatours.com/destinations/" },
        { "@type":"ListItem","position":3,"name":"Uganda","item":"https://lokawatours.com/destinations/uganda/" },
        { "@type":"ListItem","position":4,"name":park.name,"item":`https://lokawatours.com/destinations/uganda/${park.slug}/` }
      ]
    },
    {
      "@type": "TouristAttraction",
      "name": park.name,
      "url": `https://lokawatours.com/destinations/uganda/${park.slug}/`,
      "description": park.description,
      "address": { "@type":"PostalAddress","addressCountry":"UG","addressRegion":"Western Uganda" },
      "image": `https://lokawatours.com${park.heroImg}`,
      "touristType": ["Wildlife Safari","Gorilla Trekking","Nature Walk"]
    },
    {
      "@type": "FAQPage",
      "mainEntity": faqs.map(f => ({
        "@type": "Question",
        "name": f.q,
        "acceptedAnswer": { "@type":"Answer","text":f.a }
      }))
    }
  ]
});
---

<BaseLayout
  title={`${park.name} — Gorilla Trekking Guide & Safari Packages | L'okawa Tours`}
  description={park.description}
  ogImage={park.heroImg}
  schema={schema}
>

<!-- ════════════════════════════════════════════════════
     BANNER
════════════════════════════════════════════════════ -->
<div class="pp-banner">
  <div class="pp-banner__photo" aria-hidden="true" style={`background-image:url('${park.heroImg}')`}></div>
  <svg viewBox="0 0 1440 300" preserveAspectRatio="xMidYMax slice" class="pp-banner__svg" aria-hidden="true">
    <circle cx="1130" cy="200" r="100" fill="#ffd45a" opacity=".2"/>
    <circle cx="1130" cy="200" r="65"  fill="#ffd45a"/>
    <path d="M0 240 C220 210 400 236 580 214 C780 190 940 232 1140 212 C1280 198 1370 220 1440 214 L1440 300 L0 300Z" fill="#1d3315" opacity=".8"/>
    <path d="M0 272 C240 252 440 272 660 262 C880 250 1100 274 1440 256 L1440 300 L0 300Z" fill="#0d1a0a"/>
  </svg>
  <div class="pp-banner__overlay" aria-hidden="true"></div>
  <div class="pp-banner__content">
    <nav aria-label="Breadcrumb" class="breadcrumb">
      <a href="/" class="breadcrumb__link">Home</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a href="/destinations/" class="breadcrumb__link">Destinations</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <a href="/destinations/uganda/" class="breadcrumb__link">Uganda</a>
      <span class="breadcrumb__sep" aria-hidden="true">/</span>
      <span class="breadcrumb__cur">{park.name}</span>
    </nav>
    <p class="pp-banner__kicker">{park.tagline}</p>
    <h1 class="pp-banner__h1">{park.name}</h1>
    <p class="pp-banner__sub">Mountain gorilla trekking in Uganda's most extraordinary ancient forest.</p>
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     QUICK FACTS STRIP
════════════════════════════════════════════════════ -->
<div class="pp-facts" aria-label="Bwindi quick facts">
  <div class="container pp-facts__inner">
    {facts.map(f => (
      <div class="pp-fact">
        <span class="pp-fact__label">{f.label}</span>
        <span class="pp-fact__value">{f.value}</span>
      </div>
    ))}
  </div>
</div>

<!-- ════════════════════════════════════════════════════
     INTRO + SIDEBAR
════════════════════════════════════════════════════ -->
<section class="pp-intro section">
  <div class="container pp-intro__grid">
    <div class="pp-intro__text">
      <span class="kicker">About the park</span>
      <h2 class="pp-intro__heading">Bwindi Impenetrable National Park</h2>
      {park.intro.map(p => <p class="body-lg pp-intro__p">{p}</p>)}
    </div>
    <aside class="pp-intro__sidebar">
      <div class="pp-sidebar-card">
        <div class="pp-sidebar-card__head">Book Your Gorilla Trek</div>
        <p class="pp-sidebar-card__price">From <strong>USD 800</strong> / person</p>
        <p class="pp-sidebar-card__note">Permit + guide + park entry included. Permits limited — book 3–6 months ahead.</p>
        <a href="/contact/" class="btn btn--primary" style="width:100%;text-align:center;margin-bottom:8px;">Get a Free Quote</a>
        <a href="https://wa.me/256761512966" target="_blank" rel="noopener noreferrer" class="pp-sidebar-wa">
          <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413z"/></svg>
          WhatsApp us instantly
        </a>
      </div>
      <!-- Related internal links -->
      <div class="pp-related-links">
        <h3 class="pp-related-links__heading">Useful Guides</h3>
        <ul>
          <li><a href="/plan/gorilla-permit-guide/" class="pp-related-link">Gorilla permit guide</a></li>
          <li><a href="/plan/gorilla-trekking-packing-list/" class="pp-related-link">What to pack for gorilla trekking</a></li>
          <li><a href="/plan/best-time-to-visit-uganda/" class="pp-related-link">Best time to visit Uganda</a></li>
          <li><a href="/plan/how-difficult-is-gorilla-trekking/" class="pp-related-link">How difficult is gorilla trekking?</a></li>
          <li><a href="/plan/uganda-vs-rwanda-gorillas/" class="pp-related-link">Uganda vs Rwanda gorillas</a></li>
        </ul>
      </div>
    </aside>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     PARK SECTORS
════════════════════════════════════════════════════ -->
<section class="pp-sectors section--parchment" aria-labelledby="sectors-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">Where to go in Bwindi</span>
      <h2 id="sectors-heading">The Four Trekking Sectors</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="sectors-grid">
      {sectors.map((s, i) => (
        <div class="sector-card">
          <div class="sector-card__num">{String(i + 1).padStart(2,'0')}</div>
          <div>
            <h3 class="sector-card__name">{s.name}</h3>
            <p class="sector-card__families">{s.families}</p>
            <p class="sector-card__note">{s.note}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     ACTIVITIES
════════════════════════════════════════════════════ -->
<section class="pp-activities section" aria-labelledby="activities-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">What to do</span>
      <h2 id="activities-heading">Wildlife &amp; Activities</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="activities-grid">
      {activities.map(a => (
        <div class="activity-card">
          <div class="activity-card__icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="var(--color-forest)" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={a.icon}/></svg>
          </div>
          <h3 class="activity-card__title">{a.title}</h3>
          <p class="activity-card__text">{a.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     TOURS VISITING THIS PARK
════════════════════════════════════════════════════ -->
<section class="pp-tours section--parchment" aria-labelledby="pp-tours-heading">
  <div class="container">
    <div class="section-heading">
      <span class="kicker">Itineraries that include Bwindi</span>
      <h2 id="pp-tours-heading">Safari Packages Including Bwindi</h2>
      <div class="section-heading__divider"></div>
    </div>
    <div class="pp-tours-grid">
      {tours.map(t => (
        <article class="tour-card">
          <a href={`/tours/${t.slug}/`} class="tour-card__img-link" tabindex="-1" aria-hidden="true">
            <img src={t.img} alt={t.imgAlt} class="tour-card__img" loading="lazy"/>
            <span class="badge tour-card__badge">{t.days} Days</span>
          </a>
          <div class="tour-card__body">
            <h3 class="tour-card__title"><a href={`/tours/${t.slug}/`} class="tour-card__title-link">{t.title}</a></h3>
            <div class="tour-card__footer">
              <span class="tour-card__meta">{t.days} Days &middot; {t.price}</span>
              <a href={`/tours/${t.slug}/`} class="arrow-circle" aria-label={`View ${t.title}`}>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--color-gold)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
              </a>
            </div>
          </div>
        </article>
      ))}
    </div>
    <div style="text-align:center;margin-top:36px;">
      <a href="/tours/" class="btn btn--secondary btn--lg">View All Uganda Tours</a>
    </div>
  </div>
</section>

<!-- ════════════════════════════════════════════════════
     FAQ
════════════════════════════════════════════════════ -->
<section class="pp-faq section" aria-labelledby="pp-faq-heading">
  <div class="container pp-faq__inner">
    <div class="pp-faq__intro">
      <span class="kicker">Common questions</span>
      <h2 id="pp-faq-heading">Bwindi Gorilla Trekking FAQ</h2>
      <div class="section-heading__divider" style="margin:16px 0 0;"></div>
      <p class="pp-faq__sub">Quick answers about gorilla trekking in Bwindi Impenetrable National Park.</p>
      <a href="/plan/faq/" class="btn btn--secondary pp-faq__btn">Full Safari FAQ</a>
    </div>
    <div class="faq-list">
      {faqs.map(f => (
        <details class="faq-item" name="bwindi-faq">
          <summary class="faq-item__q">
            <span>{f.q}</span>
            <svg class="faq-item__chevron" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="6 9 12 15 18 9"/></svg>
          </summary>
          <div class="faq-item__a"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- CTA band -->
<CtaBand
  heading="Ready to Trek Gorillas in Bwindi?"
  sub="Permits are limited. We recommend booking 3 to 6 months in advance. Get in touch and we will check availability and build your itinerary."
  btn1="Get a Free Quote"
  btn1Href="/contact/"
  btn2="More Uganda Parks"
  btn2Href="/destinations/uganda/"
/>

</BaseLayout>

<style>
/* ── Banner ──────────────────────────────────────── */
.pp-banner { position:relative; overflow:hidden; min-height:300px; background:linear-gradient(180deg,#16290f 0%,#2f4d20 40%,#b8561a 82%,#f4b41a 100%); }
.pp-banner__photo { position:absolute; inset:0; background-size:cover; background-position:center 30%; opacity:.25; z-index:0; }
.pp-banner__svg    { position:absolute; left:0; bottom:0; width:100%; height:100%; pointer-events:none; z-index:1; }
.pp-banner__overlay{ position:absolute; inset:0; background:linear-gradient(90deg,rgba(10,20,8,.82) 0%,rgba(10,20,8,.4) 55%,rgba(10,20,8,0) 85%); z-index:1; }
.pp-banner__content{ position:relative; z-index:2; max-width:var(--max-width); margin-inline:auto; padding:56px var(--section-pad-x) 72px; box-sizing:border-box; }
.pp-banner__kicker { font-family:var(--font-display); font-style:italic; font-weight:500; font-size:20px; color:var(--color-gold); margin-bottom:4px; display:block; }
.pp-banner__h1     { font-family:var(--font-display); font-weight:var(--weight-bold); font-size:clamp(30px,4vw,52px); line-height:1.1; color:var(--color-white); margin:0 0 12px; }
.pp-banner__sub    { font-size:var(--text-lg); color:var(--color-cream); opacity:.9; max-width:480px; line-height:var(--leading-relaxed); }

/* ── Breadcrumb ──────────────────────────────────── */
.breadcrumb { display:flex; flex-wrap:wrap; align-items:center; gap:6px 8px; font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-cream); margin-bottom:14px; }
.breadcrumb__link { color:var(--color-cream); transition:color var(--transition-fast); }
.breadcrumb__link:hover { color:var(--color-gold); }
.breadcrumb__sep  { opacity:.4; }
.breadcrumb__cur  { color:var(--color-gold); }

/* ── Quick facts strip ───────────────────────────── */
.pp-facts { background:var(--color-forest); }
.pp-facts__inner { display:flex; flex-wrap:wrap; max-width:var(--max-width); margin-inline:auto; }
.pp-fact { flex:1 1 130px; display:flex; flex-direction:column; gap:3px; padding:16px 14px; border-right:1px solid rgba(243,236,216,.15); }
.pp-fact:last-child { border-right:none; }
.pp-fact__label { font-size:var(--text-xs); font-weight:var(--weight-extrabold); letter-spacing:var(--tracking-widest); text-transform:uppercase; color:var(--color-gold); }
.pp-fact__value { font-size:var(--text-sm); font-weight:var(--weight-semibold); color:var(--color-cream); line-height:1.4; }

/* ── Intro + sidebar ─────────────────────────────── */
.pp-intro__grid { display:grid; grid-template-columns:1fr 300px; gap:48px; align-items:start; }
